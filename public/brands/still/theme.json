{
  "format": "openform-theme",
  "version": "2.0.0",
  "id": "still",
  "name": "still",
  "direction": "Essential objects, lasting form",
  "concept": "Low-relief ceramic studies, grounded soft geometry, tonal paper labels, and quietly confident geometric type. Fewer elements make every proportion more important.",
  "scope": {
    "attribute": "data-openform",
    "value": "still",
    "selector": "[data-openform=\"still\"]"
  },
  "installation": {
    "command": "node install-theme.mjs --target /path/to/your/project",
    "publicDirectory": "public",
    "destination": "themes/still",
    "stylesheet": "/themes/still/theme.css",
    "reference": "/themes/still/reference.html",
    "components": "/themes/still/components.html",
    "htmlAttribute": "data-openform=\"still\""
  },
  "colors": {
    "ink": "#49483F",
    "accent": "#D2C8AE",
    "paper": "#F5F2E9",
    "support": "#A4AFA7",
    "secondary": "#636259",
    "border": "#c7c4bb",
    "heroBackground": "#F5F2E9",
    "heroForeground": "#49483F",
    "buttonBackground": "#49483F",
    "buttonForeground": "#F5F2E9"
  },
  "typography": {
    "display": {
      "family": "Work Sans",
      "file": "fonts/work-sans.ttf",
      "weight": 400,
      "trackingEm": -0.04,
      "lineHeight": 1.02,
      "desktopMaxPx": 96,
      "mobileMinPx": 38
    },
    "body": {
      "family": "Urbanist",
      "file": "fonts/urbanist.ttf",
      "weight": 400,
      "sizePx": 16,
      "lineHeight": 1.7
    },
    "accent": {
      "family": "Instrument Serif",
      "file": "fonts/instrument-serif-italic.ttf",
      "style": "italic"
    },
    "label": {
      "sizePx": 11,
      "trackingEm": 0.08,
      "lineHeight": 1.5
    }
  },
  "layout": {
    "id": "essential",
    "family": "minimal",
    "mode": "paper",
    "alignment": "center",
    "maxWidthPx": 1160,
    "pageGutter": "clamp(20px, 4vw, 64px)",
    "sectionGap": "clamp(64px, 9vw, 128px)",
    "heroTextRatio": 0.5,
    "gridColumns": 2,
    "breakpoints": {
      "mobile": 640,
      "tablet": 960
    },
    "description": "Ceramic-white centered hero with quiet stone typography and a large sculptural ceramic image. Tonal borders, a 2-column essentials grid, and no unnecessary decoration."
  },
  "components": {
    "classes": {
      "root": "of-theme",
      "container": "of-container",
      "header": "of-header",
      "navigation": "of-nav",
      "mobileNavigation": "of-mobile-nav",
      "logo": "of-logo",
      "eyebrow": "of-eyebrow",
      "hero": "of-hero",
      "heroCopy": "of-hero-copy",
      "heroHeading": "of-display",
      "heroMedia": "of-hero-media",
      "heading": "of-heading",
      "body": "of-body",
      "actions": "of-actions",
      "button": "of-button",
      "secondaryButton": "of-button of-button--ghost",
      "section": "of-section",
      "sectionHeading": "of-section-heading",
      "grid": "of-grid",
      "card": "of-card",
      "cardImage": "of-card-image",
      "badge": "of-badge",
      "form": "of-form",
      "field": "of-field",
      "input": "of-input",
      "select": "of-select",
      "textarea": "of-textarea",
      "notice": "of-notice",
      "table": "of-table",
      "accordion": "of-accordion",
      "footer": "of-footer"
    },
    "radiusPx": 6,
    "cardRadiusPx": 0,
    "borderPx": 1,
    "buttonShape": "soft",
    "minimumControlHeightPx": 48,
    "inputHeightPx": 52,
    "focus": {
      "widthPx": 3,
      "offsetPx": 4,
      "color": "#49483F"
    }
  },
  "content": {
    "headline": [
      "Fewer things.",
      "Better everyday."
    ],
    "eyebrow": "DURABLE OBJECTS / CONSIDERED LIVING",
    "cta": "Explore the essentials",
    "secondaryCta": "Our way of making",
    "nav": [
      "Essentials",
      "Materials",
      "The approach"
    ],
    "features": [
      [
        "A reason to be here",
        "Every object starts with a clear purpose."
      ],
      [
        "Material, plainly",
        "Honest details and the character of well-chosen materials."
      ],
      [
        "Part of the everyday",
        "Thoughtful things designed to become quietly familiar."
      ]
    ]
  },
  "rules": [
    "Keep the grounded oval at a fixed 3:2 proportion.",
    "Use tonal contrast rather than additional decorative colors.",
    "Product names are sentence case with plainly stated materials beneath.",
    "Ceramic-white centered hero with quiet stone typography and a large sculptural ceramic image. Tonal borders, a 2-column essentials grid, and no unnecessary decoration.",
    "Use the supplied artwork and SVG logos; keep glyph proportions intact.",
    "Preserve the existing project content, routes, data fetching, and interaction handlers."
  ],
  "fonts": [
    {
      "id": "work-sans",
      "family": "Work Sans",
      "path": "fonts/work-sans.ttf",
      "license": "fonts/work-sans-OFL.txt",
      "weight": "100 900",
      "style": "normal"
    },
    {
      "id": "urbanist",
      "family": "Urbanist",
      "path": "fonts/urbanist.ttf",
      "license": "fonts/urbanist-OFL.txt",
      "weight": "100 900",
      "style": "normal"
    },
    {
      "id": "instrument-serif-italic",
      "family": "Instrument Serif",
      "path": "fonts/instrument-serif-italic.ttf",
      "license": "fonts/instrument-serif-italic-OFL.txt",
      "weight": "400",
      "style": "italic"
    }
  ],
  "exports": [
    "mark.svg",
    "lockup.svg",
    "wordmark.svg",
    "monochrome.svg",
    "pattern.svg",
    "poster.svg",
    "social.svg",
    "avatar.svg",
    "favicon.svg",
    "artwork.svg",
    "identity-board.svg",
    "stationery.svg",
    "packaging.svg",
    "website.svg",
    "social-story.svg",
    "icon-set.svg",
    "palette.svg",
    "typography.svg",
    "business-card.svg",
    "tokens.json",
    "theme.css",
    "theme.json",
    "theme.js",
    "reference.html",
    "components.html",
    "components.tsx",
    "install-theme.mjs",
    "AI-PROMPT.md",
    "INSTALL.md",
    "guidelines.md"
  ],
  "license": {
    "artwork": "CC0-1.0",
    "code": "MIT",
    "fonts": "OFL-1.1"
  },
  "acceptance": [
    "The exact stylesheet loads without a 404.",
    "All local fonts load; there are no requests to remote font services.",
    "The root or intended subtree carries the exact data-openform attribute.",
    "The supplied display font, colors, radius, spacing, and layout family are used consistently.",
    "At 360px, 768px, and 1440px there is no horizontal page overflow.",
    "Navigation, forms, routes, and existing business behavior still work.",
    "Controls are keyboard accessible with visible focus; reduced-motion preferences are respected.",
    "The final interface follows reference.html and components.html rather than a guessed visual style."
  ]
}
