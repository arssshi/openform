{
  "format": "openform-theme",
  "version": "2.0.0",
  "id": "monument",
  "name": "MONUMENT",
  "direction": "Permanent perspective",
  "concept": "Weighty isometric concrete sculptures, exposed construction grids, and aggressively clear expanded type. Proportion gives the identity its presence.",
  "scope": {
    "attribute": "data-openform",
    "value": "monument",
    "selector": "[data-openform=\"monument\"]"
  },
  "installation": {
    "command": "node install-theme.mjs --target /path/to/your/project",
    "publicDirectory": "public",
    "destination": "themes/monument",
    "stylesheet": "/themes/monument/theme.css",
    "reference": "/themes/monument/reference.html",
    "components": "/themes/monument/components.html",
    "htmlAttribute": "data-openform=\"monument\""
  },
  "colors": {
    "ink": "#272826",
    "accent": "#C3C0B7",
    "paper": "#ECEAE1",
    "support": "#E58C56",
    "secondary": "#454542",
    "border": "#b7b6af",
    "heroBackground": "#C3C0B7",
    "heroForeground": "#272826",
    "buttonBackground": "#272826",
    "buttonForeground": "#ECEAE1"
  },
  "typography": {
    "display": {
      "family": "Unbounded",
      "file": "fonts/unbounded.ttf",
      "weight": 800,
      "trackingEm": -0.04,
      "lineHeight": 1.02,
      "desktopMaxPx": 96,
      "mobileMinPx": 38
    },
    "body": {
      "family": "Archivo",
      "file": "fonts/archivo.ttf",
      "weight": 400,
      "sizePx": 16,
      "lineHeight": 1.7
    },
    "accent": {
      "family": "Archivo",
      "file": "fonts/archivo.ttf",
      "style": "normal"
    },
    "label": {
      "sizePx": 11,
      "trackingEm": 0.08,
      "lineHeight": 1.5
    }
  },
  "layout": {
    "id": "concrete",
    "family": "architecture",
    "mode": "accent",
    "alignment": "left",
    "maxWidthPx": 1480,
    "pageGutter": "clamp(20px, 4vw, 64px)",
    "sectionGap": "clamp(64px, 9vw, 128px)",
    "heroTextRatio": 0.58,
    "gridColumns": 3,
    "breakpoints": {
      "mobile": 640,
      "tablet": 960
    },
    "description": "Concrete-grey hero, broad black display, large monolith study, and thick horizontal rules. Copper only marks project numbers; project information stays aligned."
  },
  "components": {
    "classes": {
      "root": "of-theme",
      "container": "of-container",
      "header": "of-header",
      "navigation": "of-nav",
      "mobileNavigation": "of-mobile-nav",
      "logo": "of-logo",
      "eyebrow": "of-eyebrow",
      "hero": "of-hero",
      "heroCopy": "of-hero-copy",
      "heroHeading": "of-display",
      "heroMedia": "of-hero-media",
      "heading": "of-heading",
      "body": "of-body",
      "actions": "of-actions",
      "button": "of-button",
      "secondaryButton": "of-button of-button--ghost",
      "section": "of-section",
      "sectionHeading": "of-section-heading",
      "grid": "of-grid",
      "card": "of-card",
      "cardImage": "of-card-image",
      "badge": "of-badge",
      "form": "of-form",
      "field": "of-field",
      "input": "of-input",
      "select": "of-select",
      "textarea": "of-textarea",
      "notice": "of-notice",
      "table": "of-table",
      "accordion": "of-accordion",
      "footer": "of-footer"
    },
    "radiusPx": 0,
    "cardRadiusPx": 0,
    "borderPx": 2,
    "buttonShape": "square",
    "minimumControlHeightPx": 48,
    "inputHeightPx": 52,
    "focus": {
      "widthPx": 3,
      "offsetPx": 4,
      "color": "#272826"
    }
  },
  "content": {
    "headline": [
      "Built on",
      "something substantial."
    ],
    "eyebrow": "ARCHITECTURE / MATERIAL / URBAN LIFE",
    "cta": "Explore the projects",
    "secondaryCta": "Read our position",
    "nav": [
      "Projects",
      "Practice",
      "Position"
    ],
    "features": [
      [
        "A structural point of view",
        "A practice that begins with what a place needs to become."
      ],
      [
        "Material with meaning",
        "Form and construction that remain visible and honest."
      ],
      [
        "A lasting presence",
        "Measured decisions with room for a building to age well."
      ]
    ]
  },
  "rules": [
    "Stacked blocks retain their stepped silhouette.",
    "Use a visible structural grid and thick section rules.",
    "Keep copper confined to identifiers or a single small module.",
    "Concrete-grey hero, broad black display, large monolith study, and thick horizontal rules. Copper only marks project numbers; project information stays aligned.",
    "Use the supplied artwork and SVG logos; keep glyph proportions intact.",
    "Preserve the existing project content, routes, data fetching, and interaction handlers."
  ],
  "fonts": [
    {
      "id": "unbounded",
      "family": "Unbounded",
      "path": "fonts/unbounded.ttf",
      "license": "fonts/unbounded-OFL.txt",
      "weight": "200 900",
      "style": "normal"
    },
    {
      "id": "archivo",
      "family": "Archivo",
      "path": "fonts/archivo.ttf",
      "license": "fonts/archivo-OFL.txt",
      "weight": "100 900",
      "style": "normal"
    }
  ],
  "exports": [
    "mark.svg",
    "lockup.svg",
    "wordmark.svg",
    "monochrome.svg",
    "pattern.svg",
    "poster.svg",
    "social.svg",
    "avatar.svg",
    "favicon.svg",
    "artwork.svg",
    "identity-board.svg",
    "stationery.svg",
    "packaging.svg",
    "website.svg",
    "social-story.svg",
    "icon-set.svg",
    "palette.svg",
    "typography.svg",
    "business-card.svg",
    "tokens.json",
    "theme.css",
    "theme.json",
    "theme.js",
    "reference.html",
    "components.html",
    "components.tsx",
    "install-theme.mjs",
    "AI-PROMPT.md",
    "INSTALL.md",
    "guidelines.md"
  ],
  "license": {
    "artwork": "CC0-1.0",
    "code": "MIT",
    "fonts": "OFL-1.1"
  },
  "acceptance": [
    "The exact stylesheet loads without a 404.",
    "All local fonts load; there are no requests to remote font services.",
    "The root or intended subtree carries the exact data-openform attribute.",
    "The supplied display font, colors, radius, spacing, and layout family are used consistently.",
    "At 360px, 768px, and 1440px there is no horizontal page overflow.",
    "Navigation, forms, routes, and existing business behavior still work.",
    "Controls are keyboard accessible with visible focus; reduced-motion preferences are respected.",
    "The final interface follows reference.html and components.html rather than a guessed visual style."
  ]
}
