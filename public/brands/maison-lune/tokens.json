  "$extensions": {
    "openform": {
      "name": "Maison Lune",
      "version": "2.0.0",
      "style": "Elegant",
      "direction": "A house in another light",
      "voice": "Personal, thoughtful, and quietly romantic.",
      "layout": {
        "id": "maison",
        "family": "hospitality",
        "mode": "paper",
        "alignment": "center",
        "maxWidthPx": 1200,
        "pageGutter": "clamp(20px, 4vw, 64px)",
        "sectionGap": "clamp(64px, 9vw, 128px)",
        "heroTextRatio": 0.5,
        "gridColumns": 3,
        "breakpoints": {
          "mobile": 640,
          "tablet": 960
        },
        "description": "Linen centered serif hero with a moonlit arched-window image. Slate text, fine brass ornaments, quiet blue image borders, and practical left-aligned room details."
      },
      "contrast": [
        {
          "foreground": "#3E4552",
          "background": "#C4CDDC",
          "ratio": 6.02,
          "aaNormal": true
        },
        {
          "foreground": "#3E4552",
          "background": "#F4ECDD",
          "ratio": 8.21,
          "aaNormal": true
        }
      ]
    }
