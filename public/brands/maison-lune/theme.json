{
  "format": "openform-theme",
  "version": "2.0.0",
  "id": "maison-lune",
  "name": "Maison Lune",
  "direction": "A house in another light",
  "concept": "Moonlit window studies, intimate table objects, soft blue stationery, and beautifully balanced book-like typography. A house feels personal rather than perfectly polished.",
  "scope": {
    "attribute": "data-openform",
    "value": "maison-lune",
    "selector": "[data-openform=\"maison-lune\"]"
  },
  "installation": {
    "command": "node install-theme.mjs --target /path/to/your/project",
    "publicDirectory": "public",
    "destination": "themes/maison-lune",
    "stylesheet": "/themes/maison-lune/theme.css",
    "reference": "/themes/maison-lune/reference.html",
    "components": "/themes/maison-lune/components.html",
    "htmlAttribute": "data-openform=\"maison-lune\""
  },
  "colors": {
    "ink": "#3E4552",
    "accent": "#C4CDDC",
    "paper": "#F4ECDD",
    "support": "#C3A276",
    "secondary": "#595e67",
    "border": "#c3bfb7",
    "heroBackground": "#F4ECDD",
    "heroForeground": "#3E4552",
    "buttonBackground": "#3E4552",
    "buttonForeground": "#F4ECDD"
  },
  "typography": {
    "display": {
      "family": "Playfair Display",
      "file": "fonts/playfair.ttf",
      "weight": 400,
      "trackingEm": -0.01,
      "lineHeight": 1.04,
      "desktopMaxPx": 96,
      "mobileMinPx": 38
    },
    "body": {
      "family": "Manrope",
      "file": "fonts/manrope.ttf",
      "weight": 400,
      "sizePx": 16,
      "lineHeight": 1.7
    },
    "accent": {
      "family": "Instrument Serif",
      "file": "fonts/instrument-serif-italic.ttf",
      "style": "italic"
    },
    "label": {
      "sizePx": 11,
      "trackingEm": 0.08,
      "lineHeight": 1.5
    }
  },
  "layout": {
    "id": "maison",
    "family": "hospitality",
    "mode": "paper",
    "alignment": "center",
    "maxWidthPx": 1200,
    "pageGutter": "clamp(20px, 4vw, 64px)",
    "sectionGap": "clamp(64px, 9vw, 128px)",
    "heroTextRatio": 0.5,
    "gridColumns": 3,
    "breakpoints": {
      "mobile": 640,
      "tablet": 960
    },
    "description": "Linen centered serif hero with a moonlit arched-window image. Slate text, fine brass ornaments, quiet blue image borders, and practical left-aligned room details."
  },
  "components": {
    "classes": {
      "root": "of-theme",
      "container": "of-container",
      "header": "of-header",
      "navigation": "of-nav",
      "mobileNavigation": "of-mobile-nav",
      "logo": "of-logo",
      "eyebrow": "of-eyebrow",
      "hero": "of-hero",
      "heroCopy": "of-hero-copy",
      "heroHeading": "of-display",
      "heroMedia": "of-hero-media",
      "heading": "of-heading",
      "body": "of-body",
      "actions": "of-actions",
      "button": "of-button",
      "secondaryButton": "of-button of-button--ghost",
      "section": "of-section",
      "sectionHeading": "of-section-heading",
      "grid": "of-grid",
      "card": "of-card",
      "cardImage": "of-card-image",
      "badge": "of-badge",
      "form": "of-form",
      "field": "of-field",
      "input": "of-input",
      "select": "of-select",
      "textarea": "of-textarea",
      "notice": "of-notice",
      "table": "of-table",
      "accordion": "of-accordion",
      "footer": "of-footer"
    },
    "radiusPx": 4,
    "cardRadiusPx": 0,
    "borderPx": 1,
    "buttonShape": "outline",
    "minimumControlHeightPx": 48,
    "inputHeightPx": 52,
    "focus": {
      "widthPx": 3,
      "offsetPx": 4,
      "color": "#3E4552"
    }
  },
  "content": {
    "headline": [
      "A different light.",
      "A place to feel at home."
    ],
    "eyebrow": "MAISON LUNE / ROOMS & TABLE",
    "cta": "Discover the house",
    "secondaryCta": "A seat at the table",
    "nav": [
      "The rooms",
      "The table",
      "The house"
    ],
    "features": [
      [
        "Rooms with a point of view",
        "Considered spaces that make room for a different rhythm."
      ],
      [
        "A table to gather at",
        "Seasonal pleasures and the good feeling of being well hosted."
      ],
      [
        "A personal kind of place",
        "Thoughtful details that feel collected rather than imposed."
      ]
    ]
  },
  "rules": [
    "The moonlit window keeps its central division and open lower space.",
    "Use brass only for fine lines, seals, or room identifiers.",
    "Center invitation headlines while keeping practical information left aligned.",
    "Linen centered serif hero with a moonlit arched-window image. Slate text, fine brass ornaments, quiet blue image borders, and practical left-aligned room details.",
    "Use the supplied artwork and SVG logos; keep glyph proportions intact.",
    "Preserve the existing project content, routes, data fetching, and interaction handlers."
  ],
  "fonts": [
    {
      "id": "playfair",
      "family": "Playfair Display",
      "path": "fonts/playfair.ttf",
      "license": "fonts/playfair-OFL.txt",
      "weight": "400 900",
      "style": "normal"
    },
    {
      "id": "manrope",
      "family": "Manrope",
      "path": "fonts/manrope.ttf",
      "license": "fonts/manrope-OFL.txt",
      "weight": "200 800",
      "style": "normal"
    },
    {
      "id": "instrument-serif-italic",
      "family": "Instrument Serif",
      "path": "fonts/instrument-serif-italic.ttf",
      "license": "fonts/instrument-serif-italic-OFL.txt",
      "weight": "400",
      "style": "italic"
    }
  ],
  "exports": [
    "mark.svg",
    "lockup.svg",
    "wordmark.svg",
    "monochrome.svg",
    "pattern.svg",
    "poster.svg",
    "social.svg",
    "avatar.svg",
    "favicon.svg",
    "artwork.svg",
    "identity-board.svg",
    "stationery.svg",
    "packaging.svg",
    "website.svg",
    "social-story.svg",
    "icon-set.svg",
    "palette.svg",
    "typography.svg",
    "business-card.svg",
    "tokens.json",
    "theme.css",
    "theme.json",
    "theme.js",
    "reference.html",
    "components.html",
    "components.tsx",
    "install-theme.mjs",
    "AI-PROMPT.md",
    "INSTALL.md",
    "guidelines.md"
  ],
  "license": {
    "artwork": "CC0-1.0",
    "code": "MIT",
    "fonts": "OFL-1.1"
  },
  "acceptance": [
    "The exact stylesheet loads without a 404.",
    "All local fonts load; there are no requests to remote font services.",
    "The root or intended subtree carries the exact data-openform attribute.",
    "The supplied display font, colors, radius, spacing, and layout family are used consistently.",
    "At 360px, 768px, and 1440px there is no horizontal page overflow.",
    "Navigation, forms, routes, and existing business behavior still work.",
    "Controls are keyboard accessible with visible focus; reduced-motion preferences are respected.",
    "The final interface follows reference.html and components.html rather than a guessed visual style."
  ]
}
