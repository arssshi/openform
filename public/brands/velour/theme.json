{
  "format": "openform-theme",
  "version": "2.0.0",
  "id": "velour",
  "name": "velour",
  "direction": "Soft architecture of dress",
  "concept": "Sculptural folded ribbons, couture-like labels, blush tissue, and quietly dramatic serif setting. Sensory material meets precise contemporary composition.",
  "scope": {
    "attribute": "data-openform",
    "value": "velour",
    "selector": "[data-openform=\"velour\"]"
  },
  "installation": {
    "command": "node install-theme.mjs --target /path/to/your/project",
    "publicDirectory": "public",
    "destination": "themes/velour",
    "stylesheet": "/themes/velour/theme.css",
    "reference": "/themes/velour/reference.html",
    "components": "/themes/velour/components.html",
    "htmlAttribute": "data-openform=\"velour\""
  },
  "colors": {
    "ink": "#37302F",
    "accent": "#E9CBC5",
    "paper": "#F7F0E7",
    "support": "#A73E47",
    "secondary": "#544d4b",
    "border": "#c3bcb5",
    "heroBackground": "#F7F0E7",
    "heroForeground": "#37302F",
    "buttonBackground": "#37302F",
    "buttonForeground": "#F7F0E7"
  },
  "typography": {
    "display": {
      "family": "Prata",
      "file": "fonts/prata.ttf",
      "weight": 400,
      "trackingEm": -0.01,
      "lineHeight": 1.02,
      "desktopMaxPx": 96,
      "mobileMinPx": 38
    },
    "body": {
      "family": "Urbanist",
      "file": "fonts/urbanist.ttf",
      "weight": 400,
      "sizePx": 16,
      "lineHeight": 1.7
    },
    "accent": {
      "family": "Instrument Serif",
      "file": "fonts/instrument-serif-italic.ttf",
      "style": "italic"
    },
    "label": {
      "sizePx": 11,
      "trackingEm": 0.08,
      "lineHeight": 1.5
    }
  },
  "layout": {
    "id": "fashion",
    "family": "fashion",
    "mode": "paper",
    "alignment": "center",
    "maxWidthPx": 1240,
    "pageGutter": "clamp(20px, 4vw, 64px)",
    "sectionGap": "clamp(64px, 9vw, 128px)",
    "heroTextRatio": 0.5,
    "gridColumns": 3,
    "breakpoints": {
      "mobile": 640,
      "tablet": 960
    },
    "description": "Centered silk-white hero with a narrow high-contrast serif and a wide blush ribbon image. Quiet product captions and fine rules; rouge is a small punctuation only."
  },
  "components": {
    "classes": {
      "root": "of-theme",
      "container": "of-container",
      "header": "of-header",
      "navigation": "of-nav",
      "mobileNavigation": "of-mobile-nav",
      "logo": "of-logo",
      "eyebrow": "of-eyebrow",
      "hero": "of-hero",
      "heroCopy": "of-hero-copy",
      "heroHeading": "of-display",
      "heroMedia": "of-hero-media",
      "heading": "of-heading",
      "body": "of-body",
      "actions": "of-actions",
      "button": "of-button",
      "secondaryButton": "of-button of-button--ghost",
      "section": "of-section",
      "sectionHeading": "of-section-heading",
      "grid": "of-grid",
      "card": "of-card",
      "cardImage": "of-card-image",
      "badge": "of-badge",
      "form": "of-form",
      "field": "of-field",
      "input": "of-input",
      "select": "of-select",
      "textarea": "of-textarea",
      "notice": "of-notice",
      "table": "of-table",
      "accordion": "of-accordion",
      "footer": "of-footer"
    },
    "radiusPx": 2,
    "cardRadiusPx": 0,
    "borderPx": 1,
    "buttonShape": "outline",
    "minimumControlHeightPx": 48,
    "inputHeightPx": 52,
    "focus": {
      "widthPx": 3,
      "offsetPx": 4,
      "color": "#37302F"
    }
  },
  "content": {
    "headline": [
      "Extraordinary,",
      "in the everyday."
    ],
    "eyebrow": "SLOWLY MADE / OFTEN WORN",
    "cta": "Explore the collection",
    "secondaryCta": "Our way of making",
    "nav": [
      "Collection",
      "The details",
      "Our approach"
    ],
    "features": [
      [
        "Feel the difference",
        "Form, texture, and the little details closest to you."
      ],
      [
        "A slower approach",
        "Pieces made with care and room to become familiar."
      ],
      [
        "Wear your own way",
        "A quiet foundation for a very personal point of view."
      ]
    ]
  },
  "rules": [
    "Preserve the ribbon's negative space at every size.",
    "Use rouge as a tiny editorial punctuation rather than a full background.",
    "Keep garment information quiet and never track body paragraphs.",
    "Centered silk-white hero with a narrow high-contrast serif and a wide blush ribbon image. Quiet product captions and fine rules; rouge is a small punctuation only.",
    "Use the supplied artwork and SVG logos; keep glyph proportions intact.",
    "Preserve the existing project content, routes, data fetching, and interaction handlers."
  ],
  "fonts": [
    {
      "id": "prata",
      "family": "Prata",
      "path": "fonts/prata.ttf",
      "license": "fonts/prata-OFL.txt",
      "weight": "400",
      "style": "normal"
    },
    {
      "id": "urbanist",
      "family": "Urbanist",
      "path": "fonts/urbanist.ttf",
      "license": "fonts/urbanist-OFL.txt",
      "weight": "100 900",
      "style": "normal"
    },
    {
      "id": "instrument-serif-italic",
      "family": "Instrument Serif",
      "path": "fonts/instrument-serif-italic.ttf",
      "license": "fonts/instrument-serif-italic-OFL.txt",
      "weight": "400",
      "style": "italic"
    }
  ],
  "exports": [
    "mark.svg",
    "lockup.svg",
    "wordmark.svg",
    "monochrome.svg",
    "pattern.svg",
    "poster.svg",
    "social.svg",
    "avatar.svg",
    "favicon.svg",
    "artwork.svg",
    "identity-board.svg",
    "stationery.svg",
    "packaging.svg",
    "website.svg",
    "social-story.svg",
    "icon-set.svg",
    "palette.svg",
    "typography.svg",
    "business-card.svg",
    "tokens.json",
    "theme.css",
    "theme.json",
    "theme.js",
    "reference.html",
    "components.html",
    "components.tsx",
    "install-theme.mjs",
    "AI-PROMPT.md",
    "INSTALL.md",
    "guidelines.md"
  ],
  "license": {
    "artwork": "CC0-1.0",
    "code": "MIT",
    "fonts": "OFL-1.1"
  },
  "acceptance": [
    "The exact stylesheet loads without a 404.",
    "All local fonts load; there are no requests to remote font services.",
    "The root or intended subtree carries the exact data-openform attribute.",
    "The supplied display font, colors, radius, spacing, and layout family are used consistently.",
    "At 360px, 768px, and 1440px there is no horizontal page overflow.",
    "Navigation, forms, routes, and existing business behavior still work.",
    "Controls are keyboard accessible with visible focus; reduced-motion preferences are respected.",
    "The final interface follows reference.html and components.html rather than a guessed visual style."
  ]
}
