  "spacing": {
    "unit": {
      "$type": "dimension",
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "pageMinimum": {
      "$type": "dimension",
      "$value": {
        "value": 20,
        "unit": "px"
      }
    },
    "pageMaximum": {
      "$type": "dimension",
      "$value": {
        "value": 64,
        "unit": "px"
      }
    }
  },
  "$extensions": {
    "openform": {
      "name": "Folio",
      "version": "2.0.0",
      "style": "Editorial",
      "direction": "The authored presentation",
      "voice": "Articulate, generous, and author-centered.",
      "layout": {
        "id": "folio",
        "family": "editorial",
        "mode": "paper",
        "alignment": "left",
        "maxWidthPx": 1320,
        "pageGutter": "clamp(20px, 4vw, 64px)",
        "sectionGap": "clamp(64px, 9vw, 128px)",
        "heroTextRatio": 0.5,
        "gridColumns": 3,
        "breakpoints": {
          "mobile": 640,
          "tablet": 960
        },
        "description": "Endpaper hero with terracotta serif type and an angled portfolio object. A thin metadata rail, large project titles, and distinctly separated author credits."
      },
      "contrast": [
        {
          "foreground": "#69402F",
          "background": "#DDBB91",
          "ratio": 4.88,
          "aaNormal": true
        },
        {
          "foreground": "#69402F",
          "background": "#F9F1E2",
          "ratio": 7.88,
          "aaNormal": true
        }
      ]
    }
  }
}
