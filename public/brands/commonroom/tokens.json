{
  "$description": "Commonroom / The open noticeboard / Edition 02",
  "color": {
    "ink": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.14902,
          0.2549,
          0.60392
        ],
        "alpha": 1
      },
      "$extensions": {
        "openform.hex": "#26419A"
      }
    },
    "accent": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.92941,
          0.78431,
          0.5098
        ],
        "alpha": 1
      },
      "$extensions": {
        "openform.hex": "#EDC882"
      }
    },
    "paper": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.96471,
          0.94118,
          0.87451
        ],
        "alpha": 1
      },
      "$extensions": {
        "openform.hex": "#F6F0DF"
      }
    },
    "support": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.6549,
          0.72941,
          0.76863
        ],
        "alpha": 1
      },
      "$extensions": {
        "openform.hex": "#A7BAC4"
      }
    }
  },
  "typography": {
    "heading": {
      "$type": "fontFamily",
      "$value": "Bricolage Grotesque"
    },
    "body": {
      "$type": "fontFamily",
      "$value": "Work Sans"
    },
    "headingWeight": {
      "$type": "fontWeight",
      "$value": 500
    },
    "tracking": {
      "$type": "number",
      "$value": -0.03,
      "$description": "Display letter spacing in em units."
    },
    "bodySize": {
      "$type": "dimension",
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "bodyLeading": {
      "$type": "number",
      "$value": 1.7
    }
  },
  "radius": {
    "$type": "dimension",
    "$value": {
      "value": 8,
      "unit": "px"
    }
  },
  "spacing": {
    "unit": {
      "$type": "dimension",
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "pageMinimum": {
      "$type": "dimension",
      "$value": {
        "value": 20,
        "unit": "px"
      }
    },
    "pageMaximum": {
      "$type": "dimension",
      "$value": {
        "value": 64,
        "unit": "px"
      }
    }
  },
  "$extensions": {
    "openform": {
      "name": "Commonroom",
      "version": "2.0.0",
      "style": "Editorial",
      "direction": "The open noticeboard",
      "voice": "Welcoming, informative, and conversational.",
      "layout": {
        "id": "noticeboard",
        "family": "editorial",
        "mode": "paper",
        "alignment": "left",
        "maxWidthPx": 1340,
        "pageGutter": "clamp(20px, 4vw, 64px)",
        "sectionGap": "clamp(64px, 9vw, 128px)",
        "heroTextRatio": 0.55,
        "gridColumns": 3,
        "breakpoints": {
          "mobile": 640,
          "tablet": 960
        },
        "description": "Paper hero with blue noticeboard-like typography and a geometric table image. Events use clear date columns, fine rules, and warm yellow notice backgrounds."
      },
      "contrast": [
        {
          "foreground": "#26419A",
          "background": "#EDC882",
          "ratio": 5.72,
          "aaNormal": true
        },
        {
          "foreground": "#26419A",
          "background": "#F6F0DF",
          "ratio": 8,
          "aaNormal": true
        }
      ]
    }
  }
}
