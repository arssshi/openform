{
  "format": "openform-theme",
  "version": "2.0.0",
  "id": "commonroom",
  "name": "Commonroom",
  "direction": "The open noticeboard",
  "concept": "Overlapping civic tickets, a communal-table emblem, bold blue notices, and deeply human editorial type. The information feels public, legible, and worth showing up for.",
  "scope": {
    "attribute": "data-openform",
    "value": "commonroom",
    "selector": "[data-openform=\"commonroom\"]"
  },
  "installation": {
    "command": "node install-theme.mjs --target /path/to/your/project",
    "publicDirectory": "public",
    "destination": "themes/commonroom",
    "stylesheet": "/themes/commonroom/theme.css",
    "reference": "/themes/commonroom/reference.html",
    "components": "/themes/commonroom/components.html",
    "htmlAttribute": "data-openform=\"commonroom\""
  },
  "colors": {
    "ink": "#26419A",
    "accent": "#EDC882",
    "paper": "#F6F0DF",
    "support": "#A7BAC4",
    "secondary": "#455ba4",
    "border": "#bec1cc",
    "heroBackground": "#F6F0DF",
    "heroForeground": "#26419A",
    "buttonBackground": "#26419A",
    "buttonForeground": "#F6F0DF"
  },
  "typography": {
    "display": {
      "family": "Bricolage Grotesque",
      "file": "fonts/bricolage.ttf",
      "weight": 500,
      "trackingEm": -0.03,
      "lineHeight": 1.02,
      "desktopMaxPx": 96,
      "mobileMinPx": 38
    },
    "body": {
      "family": "Work Sans",
      "file": "fonts/work-sans.ttf",
      "weight": 400,
      "sizePx": 16,
      "lineHeight": 1.7
    },
    "accent": {
      "family": "Instrument Serif",
      "file": "fonts/instrument-serif-italic.ttf",
      "style": "italic"
    },
    "label": {
      "sizePx": 11,
      "trackingEm": 0.08,
      "lineHeight": 1.5
    }
  },
  "layout": {
    "id": "noticeboard",
    "family": "editorial",
    "mode": "paper",
    "alignment": "left",
    "maxWidthPx": 1340,
    "pageGutter": "clamp(20px, 4vw, 64px)",
    "sectionGap": "clamp(64px, 9vw, 128px)",
    "heroTextRatio": 0.55,
    "gridColumns": 3,
    "breakpoints": {
      "mobile": 640,
      "tablet": 960
    },
    "description": "Paper hero with blue noticeboard-like typography and a geometric table image. Events use clear date columns, fine rules, and warm yellow notice backgrounds."
  },
  "components": {
    "classes": {
      "root": "of-theme",
      "container": "of-container",
      "header": "of-header",
      "navigation": "of-nav",
      "mobileNavigation": "of-mobile-nav",
      "logo": "of-logo",
      "eyebrow": "of-eyebrow",
      "hero": "of-hero",
      "heroCopy": "of-hero-copy",
      "heroHeading": "of-display",
      "heroMedia": "of-hero-media",
      "heading": "of-heading",
      "body": "of-body",
      "actions": "of-actions",
      "button": "of-button",
      "secondaryButton": "of-button of-button--ghost",
      "section": "of-section",
      "sectionHeading": "of-section-heading",
      "grid": "of-grid",
      "card": "of-card",
      "cardImage": "of-card-image",
      "badge": "of-badge",
      "form": "of-form",
      "field": "of-field",
      "input": "of-input",
      "select": "of-select",
      "textarea": "of-textarea",
      "notice": "of-notice",
      "table": "of-table",
      "accordion": "of-accordion",
      "footer": "of-footer"
    },
    "radiusPx": 8,
    "cardRadiusPx": 0,
    "borderPx": 1,
    "buttonShape": "soft",
    "minimumControlHeightPx": 48,
    "inputHeightPx": 52,
    "focus": {
      "widthPx": 3,
      "offsetPx": 4,
      "color": "#26419A"
    }
  },
  "content": {
    "headline": [
      "Come on in.",
      "There is room."
    ],
    "eyebrow": "YOUR NEIGHBORHOOD / YOUR SHARED SPACE",
    "cta": "See what is on",
    "secondaryCta": "Find your place",
    "nav": [
      "What is on",
      "The space",
      "Our neighborhood"
    ],
    "features": [
      [
        "A space to meet",
        "A useful neighborhood place for conversation and new connections."
      ],
      [
        "Something to be part of",
        "A thoughtful program that welcomes different interests."
      ],
      [
        "Bring your own voice",
        "A community gets better when more perspectives can be heard."
      ]
    ]
  },
  "rules": [
    "Keep the open center of the table mark clear.",
    "Use visible rules to organize notices and event dates.",
    "Information hierarchy takes priority over expressive headline placement.",
    "Paper hero with blue noticeboard-like typography and a geometric table image. Events use clear date columns, fine rules, and warm yellow notice backgrounds.",
    "Use the supplied artwork and SVG logos; keep glyph proportions intact.",
    "Preserve the existing project content, routes, data fetching, and interaction handlers."
  ],
  "fonts": [
    {
      "id": "bricolage",
      "family": "Bricolage Grotesque",
      "path": "fonts/bricolage.ttf",
      "license": "fonts/bricolage-OFL.txt",
      "weight": "200 800",
      "style": "normal"
    },
    {
      "id": "work-sans",
      "family": "Work Sans",
      "path": "fonts/work-sans.ttf",
      "license": "fonts/work-sans-OFL.txt",
      "weight": "100 900",
      "style": "normal"
    },
    {
      "id": "instrument-serif-italic",
      "family": "Instrument Serif",
      "path": "fonts/instrument-serif-italic.ttf",
      "license": "fonts/instrument-serif-italic-OFL.txt",
      "weight": "400",
      "style": "italic"
    }
  ],
  "exports": [
    "mark.svg",
    "lockup.svg",
    "wordmark.svg",
    "monochrome.svg",
    "pattern.svg",
    "poster.svg",
    "social.svg",
    "avatar.svg",
    "favicon.svg",
    "artwork.svg",
    "identity-board.svg",
    "stationery.svg",
    "packaging.svg",
    "website.svg",
    "social-story.svg",
    "icon-set.svg",
    "palette.svg",
    "typography.svg",
    "business-card.svg",
    "tokens.json",
    "theme.css",
    "theme.json",
    "theme.js",
    "reference.html",
    "components.html",
    "components.tsx",
    "install-theme.mjs",
    "AI-PROMPT.md",
    "INSTALL.md",
    "guidelines.md"
  ],
  "license": {
    "artwork": "CC0-1.0",
    "code": "MIT",
    "fonts": "OFL-1.1"
  },
  "acceptance": [
    "The exact stylesheet loads without a 404.",
    "All local fonts load; there are no requests to remote font services.",
    "The root or intended subtree carries the exact data-openform attribute.",
    "The supplied display font, colors, radius, spacing, and layout family are used consistently.",
    "At 360px, 768px, and 1440px there is no horizontal page overflow.",
    "Navigation, forms, routes, and existing business behavior still work.",
    "Controls are keyboard accessible with visible focus; reduced-motion preferences are respected.",
    "The final interface follows reference.html and components.html rather than a guessed visual style."
  ]
}
