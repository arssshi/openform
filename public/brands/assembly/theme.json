{
  "format": "openform-theme",
  "version": "2.0.0",
  "id": "assembly",
  "name": "ASSEMBLY",
  "direction": "Public possibility",
  "concept": "Fitted graphic modules, large civic type, constructive street-poster layouts, and a high-visibility citron palette. Many voices combine into one deliberately public system.",
  "scope": {
    "attribute": "data-openform",
    "value": "assembly",
    "selector": "[data-openform=\"assembly\"]"
  },
  "installation": {
    "command": "node install-theme.mjs --target /path/to/your/project",
    "publicDirectory": "public",
    "destination": "themes/assembly",
    "stylesheet": "/themes/assembly/theme.css",
    "reference": "/themes/assembly/reference.html",
    "components": "/themes/assembly/components.html",
    "htmlAttribute": "data-openform=\"assembly\""
  },
  "colors": {
    "ink": "#344735",
    "accent": "#DAE67B",
    "paper": "#F2F0E1",
    "support": "#E79366",
    "secondary": "#51604f",
    "border": "#bfc2b3",
    "heroBackground": "#DAE67B",
    "heroForeground": "#344735",
    "buttonBackground": "#344735",
    "buttonForeground": "#F2F0E1"
  },
  "typography": {
    "display": {
      "family": "Bebas Neue",
      "file": "fonts/bebas.ttf",
      "weight": 400,
      "trackingEm": 0.03,
      "lineHeight": 0.96,
      "desktopMaxPx": 96,
      "mobileMinPx": 38
    },
    "body": {
      "family": "Space Grotesk",
      "file": "fonts/space-grotesk.ttf",
      "weight": 400,
      "sizePx": 16,
      "lineHeight": 1.7
    },
    "accent": {
      "family": "DM Mono",
      "file": "fonts/dm-mono.ttf",
      "style": "normal"
    },
    "label": {
      "sizePx": 11,
      "trackingEm": 0.08,
      "lineHeight": 1.5
    }
  },
  "layout": {
    "id": "public",
    "family": "poster",
    "mode": "accent",
    "alignment": "left",
    "maxWidthPx": 1460,
    "pageGutter": "clamp(20px, 4vw, 64px)",
    "sectionGap": "clamp(64px, 9vw, 128px)",
    "heroTextRatio": 0.56,
    "gridColumns": 3,
    "breakpoints": {
      "mobile": 640,
      "tablet": 960
    },
    "description": "Citron poster hero with condensed civic headings, fitted-module artwork, 2px section lines, and square controls. Event details use practical date / title / place columns."
  },
  "components": {
    "classes": {
      "root": "of-theme",
      "container": "of-container",
      "header": "of-header",
      "navigation": "of-nav",
      "mobileNavigation": "of-mobile-nav",
      "logo": "of-logo",
      "eyebrow": "of-eyebrow",
      "hero": "of-hero",
      "heroCopy": "of-hero-copy",
      "heroHeading": "of-display",
      "heroMedia": "of-hero-media",
      "heading": "of-heading",
      "body": "of-body",
      "actions": "of-actions",
      "button": "of-button",
      "secondaryButton": "of-button of-button--ghost",
      "section": "of-section",
      "sectionHeading": "of-section-heading",
      "grid": "of-grid",
      "card": "of-card",
      "cardImage": "of-card-image",
      "badge": "of-badge",
      "form": "of-form",
      "field": "of-field",
      "input": "of-input",
      "select": "of-select",
      "textarea": "of-textarea",
      "notice": "of-notice",
      "table": "of-table",
      "accordion": "of-accordion",
      "footer": "of-footer"
    },
    "radiusPx": 0,
    "cardRadiusPx": 0,
    "borderPx": 2,
    "buttonShape": "square",
    "minimumControlHeightPx": 48,
    "inputHeightPx": 52,
    "focus": {
      "widthPx": 3,
      "offsetPx": 4,
      "color": "#344735"
    }
  },
  "content": {
    "headline": [
      "Bring your part.",
      "Build something together."
    ],
    "eyebrow": "PUBLIC ARTS / COLLECTIVE POSSIBILITY",
    "cta": "Find your part",
    "secondaryCta": "See what is happening",
    "nav": [
      "The program",
      "The collective",
      "Public notes"
    ],
    "features": [
      [
        "A part for everyone",
        "A public practice with room for many kinds of contribution."
      ],
      [
        "Make the idea visible",
        "Useful graphic expression that brings people toward a shared goal."
      ],
      [
        "Build it together",
        "A collective that values participation as much as the finished work."
      ]
    ]
  },
  "rules": [
    "The four fitted pieces must remain distinguishable.",
    "Use sign-like large capitals and keep event details in consistent blocks.",
    "Citron surfaces carry workshop-colored text for accessible contrast.",
    "Citron poster hero with condensed civic headings, fitted-module artwork, 2px section lines, and square controls. Event details use practical date / title / place columns.",
    "Use the supplied artwork and SVG logos; keep glyph proportions intact.",
    "Preserve the existing project content, routes, data fetching, and interaction handlers."
  ],
  "fonts": [
    {
      "id": "bebas",
      "family": "Bebas Neue",
      "path": "fonts/bebas.ttf",
      "license": "fonts/bebas-OFL.txt",
      "weight": "400",
      "style": "normal"
    },
    {
      "id": "space-grotesk",
      "family": "Space Grotesk",
      "path": "fonts/space-grotesk.ttf",
      "license": "fonts/space-grotesk-OFL.txt",
      "weight": "300 700",
      "style": "normal"
    },
    {
      "id": "dm-mono",
      "family": "DM Mono",
      "path": "fonts/dm-mono.ttf",
      "license": "fonts/dm-mono-OFL.txt",
      "weight": "400",
      "style": "normal"
    }
  ],
  "exports": [
    "mark.svg",
    "lockup.svg",
    "wordmark.svg",
    "monochrome.svg",
    "pattern.svg",
    "poster.svg",
    "social.svg",
    "avatar.svg",
    "favicon.svg",
    "artwork.svg",
    "identity-board.svg",
    "stationery.svg",
    "packaging.svg",
    "website.svg",
    "social-story.svg",
    "icon-set.svg",
    "palette.svg",
    "typography.svg",
    "business-card.svg",
    "tokens.json",
    "theme.css",
    "theme.json",
    "theme.js",
    "reference.html",
    "components.html",
    "components.tsx",
    "install-theme.mjs",
    "AI-PROMPT.md",
    "INSTALL.md",
    "guidelines.md"
  ],
  "license": {
    "artwork": "CC0-1.0",
    "code": "MIT",
    "fonts": "OFL-1.1"
  },
  "acceptance": [
    "The exact stylesheet loads without a 404.",
    "All local fonts load; there are no requests to remote font services.",
    "The root or intended subtree carries the exact data-openform attribute.",
    "The supplied display font, colors, radius, spacing, and layout family are used consistently.",
    "At 360px, 768px, and 1440px there is no horizontal page overflow.",
    "Navigation, forms, routes, and existing business behavior still work.",
    "Controls are keyboard accessible with visible focus; reduced-motion preferences are respected.",
    "The final interface follows reference.html and components.html rather than a guessed visual style."
  ]
}
