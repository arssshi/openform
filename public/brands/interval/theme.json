{
  "format": "openform-theme",
  "version": "2.0.0",
  "id": "interval",
  "name": "interval",
  "direction": "The space between",
  "concept": "Quiet light wells, precisely separated planes, softened navy-and-blue surfaces, and unusually open typographic rhythm. Restraint is a measurable design decision.",
  "scope": {
    "attribute": "data-openform",
    "value": "interval",
    "selector": "[data-openform=\"interval\"]"
  },
  "installation": {
    "command": "node install-theme.mjs --target /path/to/your/project",
    "publicDirectory": "public",
    "destination": "themes/interval",
    "stylesheet": "/themes/interval/theme.css",
    "reference": "/themes/interval/reference.html",
    "components": "/themes/interval/components.html",
    "htmlAttribute": "data-openform=\"interval\""
  },
  "colors": {
    "ink": "#293F57",
    "accent": "#C0D5E7",
    "paper": "#F4F5EF",
    "support": "#AFBCA0",
    "secondary": "#475a6e",
    "border": "#bdc4c6",
    "heroBackground": "#F4F5EF",
    "heroForeground": "#293F57",
    "buttonBackground": "#293F57",
    "buttonForeground": "#F4F5EF"
  },
  "typography": {
    "display": {
      "family": "Outfit",
      "file": "fonts/outfit.ttf",
      "weight": 400,
      "trackingEm": -0.02,
      "lineHeight": 1.02,
      "desktopMaxPx": 96,
      "mobileMinPx": 38
    },
    "body": {
      "family": "Manrope",
      "file": "fonts/manrope.ttf",
      "weight": 400,
      "sizePx": 16,
      "lineHeight": 1.7
    },
    "accent": {
      "family": "Instrument Serif",
      "file": "fonts/instrument-serif-italic.ttf",
      "style": "italic"
    },
    "label": {
      "sizePx": 11,
      "trackingEm": 0.08,
      "lineHeight": 1.5
    }
  },
  "layout": {
    "id": "spacious",
    "family": "minimal",
    "mode": "paper",
    "alignment": "center",
    "maxWidthPx": 1120,
    "pageGutter": "clamp(20px, 4vw, 64px)",
    "sectionGap": "clamp(64px, 9vw, 128px)",
    "heroTextRatio": 0.5,
    "gridColumns": 2,
    "breakpoints": {
      "mobile": 640,
      "tablet": 960
    },
    "description": "Centered, extremely open white hero with a small pause symbol and a broad light-well artwork. Two understated bordered cards; no dense decorative sections."
  },
  "components": {
    "classes": {
      "root": "of-theme",
      "container": "of-container",
      "header": "of-header",
      "navigation": "of-nav",
      "mobileNavigation": "of-mobile-nav",
      "logo": "of-logo",
      "eyebrow": "of-eyebrow",
      "hero": "of-hero",
      "heroCopy": "of-hero-copy",
      "heroHeading": "of-display",
      "heroMedia": "of-hero-media",
      "heading": "of-heading",
      "body": "of-body",
      "actions": "of-actions",
      "button": "of-button",
      "secondaryButton": "of-button of-button--ghost",
      "section": "of-section",
      "sectionHeading": "of-section-heading",
      "grid": "of-grid",
      "card": "of-card",
      "cardImage": "of-card-image",
      "badge": "of-badge",
      "form": "of-form",
      "field": "of-field",
      "input": "of-input",
      "select": "of-select",
      "textarea": "of-textarea",
      "notice": "of-notice",
      "table": "of-table",
      "accordion": "of-accordion",
      "footer": "of-footer"
    },
    "radiusPx": 12,
    "cardRadiusPx": 0,
    "borderPx": 1,
    "buttonShape": "soft",
    "minimumControlHeightPx": 48,
    "inputHeightPx": 52,
    "focus": {
      "widthPx": 3,
      "offsetPx": 4,
      "color": "#293F57"
    }
  },
  "content": {
    "headline": [
      "A little space",
      "between everything."
    ],
    "eyebrow": "FOCUS / REST / A MORE USEFUL RHYTHM",
    "cta": "Find your interval",
    "secondaryCta": "See the approach",
    "nav": [
      "The practice",
      "The approach",
      "Notes"
    ],
    "features": [
      [
        "A clearer beginning",
        "One thoughtful step toward making more room in the day."
      ],
      [
        "A useful pause",
        "Simple practices with enough structure to become familiar."
      ],
      [
        "Less to get around",
        "An open, considered experience that keeps the essentials clear."
      ]
    ]
  },
  "rules": [
    "The space between pause bars equals one bar width.",
    "Let whitespace communicate rest instead of adding decorative calm imagery.",
    "Use one concise message per view and keep secondary information small.",
    "Centered, extremely open white hero with a small pause symbol and a broad light-well artwork. Two understated bordered cards; no dense decorative sections.",
    "Use the supplied artwork and SVG logos; keep glyph proportions intact.",
    "Preserve the existing project content, routes, data fetching, and interaction handlers."
  ],
  "fonts": [
    {
      "id": "outfit",
      "family": "Outfit",
      "path": "fonts/outfit.ttf",
      "license": "fonts/outfit-OFL.txt",
      "weight": "100 900",
      "style": "normal"
    },
    {
      "id": "manrope",
      "family": "Manrope",
      "path": "fonts/manrope.ttf",
      "license": "fonts/manrope-OFL.txt",
      "weight": "200 800",
      "style": "normal"
    },
    {
      "id": "instrument-serif-italic",
      "family": "Instrument Serif",
      "path": "fonts/instrument-serif-italic.ttf",
      "license": "fonts/instrument-serif-italic-OFL.txt",
      "weight": "400",
      "style": "italic"
    }
  ],
  "exports": [
    "mark.svg",
    "lockup.svg",
    "wordmark.svg",
    "monochrome.svg",
    "pattern.svg",
    "poster.svg",
    "social.svg",
    "avatar.svg",
    "favicon.svg",
    "artwork.svg",
    "identity-board.svg",
    "stationery.svg",
    "packaging.svg",
    "website.svg",
    "social-story.svg",
    "icon-set.svg",
    "palette.svg",
    "typography.svg",
    "business-card.svg",
    "tokens.json",
    "theme.css",
    "theme.json",
    "theme.js",
    "reference.html",
    "components.html",
    "components.tsx",
    "install-theme.mjs",
    "AI-PROMPT.md",
    "INSTALL.md",
    "guidelines.md"
  ],
  "license": {
    "artwork": "CC0-1.0",
    "code": "MIT",
    "fonts": "OFL-1.1"
  },
  "acceptance": [
    "The exact stylesheet loads without a 404.",
    "All local fonts load; there are no requests to remote font services.",
    "The root or intended subtree carries the exact data-openform attribute.",
    "The supplied display font, colors, radius, spacing, and layout family are used consistently.",
    "At 360px, 768px, and 1440px there is no horizontal page overflow.",
    "Navigation, forms, routes, and existing business behavior still work.",
    "Controls are keyboard accessible with visible focus; reduced-motion preferences are respected.",
    "The final interface follows reference.html and components.html rather than a guessed visual style."
  ]
}
