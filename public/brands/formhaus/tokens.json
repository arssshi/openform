        "components": [
          0.14902,
          0.22353,
          0.6549
        ],
        "alpha": 1
      },
      "$extensions": {
        "openform.hex": "#2639A7"
      }
    },
    "accent": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.9098,
          0.86667,
          0.57647
        ],
        "alpha": 1
      },
      "$extensions": {
        "openform.hex": "#E8DD93"
      }
    },
    "paper": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.94902,
          0.94118,
          0.89412
        ],
        "alpha": 1
      },
      "$extensions": {
        "openform.hex": "#F2F0E4"
      }
    },
    "support": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.1451,
          0.15294,
          0.18824
        ],
        "alpha": 1
      },
      "$extensions": {
        "openform.hex": "#252730"
      }
    }
  },
  "typography": {
    "heading": {
      "$type": "fontFamily",
      "$value": "Syne"
    },
    "body": {
      "$type": "fontFamily",
      "$value": "Work Sans"
    },
    "headingWeight": {
      "$type": "fontWeight",
      "$value": 800
    },
    "tracking": {
      "$type": "number",
      "$value": -0.03,
      "$description": "Display letter spacing in em units."
    },
    "bodySize": {
      "$type": "dimension",
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "bodyLeading": {
      "$type": "number",
      "$value": 1.7
    }
  },
  "radius": {
    "$type": "dimension",
    "$value": {
      "value": 0,
      "unit": "px"
    }
  },
  "spacing": {
    "unit": {
      "$type": "dimension",
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "pageMinimum": {
      "$type": "dimension",
      "$value": {
        "value": 20,
        "unit": "px"
      }
    },
    "pageMaximum": {
      "$type": "dimension",
      "$value": {
        "value": 64,
        "unit": "px"
      }
    }
  },
  "$extensions": {
    "openform": {
      "name": "FORMHAUS",
      "version": "2.0.0",
      "style": "Brutalist",
      "direction": "Visible construction",
      "voice": "Constructive, exacting, and unapologetic.",
      "layout": {
        "id": "modular",
        "family": "architecture",
        "mode": "dark",
        "alignment": "left",
        "maxWidthPx": 1440,
        "pageGutter": "clamp(20px, 4vw, 64px)",
        "sectionGap": "clamp(64px, 9vw, 128px)",
        "heroTextRatio": 0.53,
        "gridColumns": 3,
        "breakpoints": {
          "mobile": 640,
          "tablet": 960
        },
        "description": "Ultramarine structural hero with plywood light type and isometric joinery. A visible modular grid, square frames, dimension-like labels, and full-width object rows."
      },
      "contrast": [
        {
          "foreground": "#2639A7",
          "background": "#E8DD93",
          "ratio": 6.83,
          "aaNormal": true
        },
        {
          "foreground": "#2639A7",
          "background": "#F2F0E4",
          "ratio": 8.25,
          "aaNormal": true
        }
      ]
    }
  }
}
