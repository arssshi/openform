{
  "format": "openform-theme",
  "version": "2.0.0",
  "id": "formhaus",
  "name": "FORMHAUS",
  "direction": "Visible construction",
  "concept": "Isometric furniture studies, exposed joins, ultramarine structural frames, and expanded industrial type. Nothing disguises how the system is put together.",
  "scope": {
    "attribute": "data-openform",
    "value": "formhaus",
    "selector": "[data-openform=\"formhaus\"]"
  },
  "installation": {
    "command": "node install-theme.mjs --target /path/to/your/project",
    "publicDirectory": "public",
    "destination": "themes/formhaus",
    "stylesheet": "/themes/formhaus/theme.css",
    "reference": "/themes/formhaus/reference.html",
    "components": "/themes/formhaus/components.html",
    "htmlAttribute": "data-openform=\"formhaus\""
  },
  "colors": {
    "ink": "#2639A7",
    "accent": "#E8DD93",
    "paper": "#F2F0E4",
    "support": "#252730",
    "secondary": "#4554b0",
    "border": "#bbbfd4",
    "heroBackground": "#2639A7",
    "heroForeground": "#F2F0E4",
    "buttonBackground": "#E8DD93",
    "buttonForeground": "#2639A7"
  },
  "typography": {
    "display": {
      "family": "Syne",
      "file": "fonts/syne.ttf",
      "weight": 800,
      "trackingEm": -0.03,
      "lineHeight": 1.02,
      "desktopMaxPx": 96,
      "mobileMinPx": 38
    },
    "body": {
      "family": "Work Sans",
      "file": "fonts/work-sans.ttf",
      "weight": 400,
      "sizePx": 16,
      "lineHeight": 1.7
    },
    "accent": {
      "family": "DM Mono",
      "file": "fonts/dm-mono.ttf",
      "style": "normal"
    },
    "label": {
      "sizePx": 11,
      "trackingEm": 0.08,
      "lineHeight": 1.5
    }
  },
  "layout": {
    "id": "modular",
    "family": "architecture",
    "mode": "dark",
    "alignment": "left",
    "maxWidthPx": 1440,
    "pageGutter": "clamp(20px, 4vw, 64px)",
    "sectionGap": "clamp(64px, 9vw, 128px)",
    "heroTextRatio": 0.53,
    "gridColumns": 3,
    "breakpoints": {
      "mobile": 640,
      "tablet": 960
    },
    "description": "Ultramarine structural hero with plywood light type and isometric joinery. A visible modular grid, square frames, dimension-like labels, and full-width object rows."
  },
  "components": {
    "classes": {
      "root": "of-theme",
      "container": "of-container",
      "header": "of-header",
      "navigation": "of-nav",
      "mobileNavigation": "of-mobile-nav",
      "logo": "of-logo",
      "eyebrow": "of-eyebrow",
      "hero": "of-hero",
      "heroCopy": "of-hero-copy",
      "heroHeading": "of-display",
      "heroMedia": "of-hero-media",
      "heading": "of-heading",
      "body": "of-body",
      "actions": "of-actions",
      "button": "of-button",
      "secondaryButton": "of-button of-button--ghost",
      "section": "of-section",
      "sectionHeading": "of-section-heading",
      "grid": "of-grid",
      "card": "of-card",
      "cardImage": "of-card-image",
      "badge": "of-badge",
      "form": "of-form",
      "field": "of-field",
      "input": "of-input",
      "select": "of-select",
      "textarea": "of-textarea",
      "notice": "of-notice",
      "table": "of-table",
      "accordion": "of-accordion",
      "footer": "of-footer"
    },
    "radiusPx": 0,
    "cardRadiusPx": 0,
    "borderPx": 2,
    "buttonShape": "square",
    "minimumControlHeightPx": 48,
    "inputHeightPx": 52,
    "focus": {
      "widthPx": 3,
      "offsetPx": 4,
      "color": "#2639A7"
    }
  },
  "content": {
    "headline": [
      "Good form.",
      "Built from the inside."
    ],
    "eyebrow": "FURNITURE / FORM / CONSTRUCTION",
    "cta": "See the objects",
    "secondaryCta": "The workshop",
    "nav": [
      "Objects",
      "Workshop",
      "Construction notes"
    ],
    "features": [
      [
        "Construction first",
        "Objects whose structure is also their character."
      ],
      [
        "Material, honestly",
        "Useful forms made with respect for what they are made from."
      ],
      [
        "A place in real life",
        "Design that earns its space by being used."
      ]
    ]
  },
  "rules": [
    "Build all graphic frames from the same beam thickness.",
    "Let ultramarine dominate with plywood as the counterweight.",
    "Keep titles flush left and attach measurements to visible grid lines.",
    "Ultramarine structural hero with plywood light type and isometric joinery. A visible modular grid, square frames, dimension-like labels, and full-width object rows.",
    "Use the supplied artwork and SVG logos; keep glyph proportions intact.",
    "Preserve the existing project content, routes, data fetching, and interaction handlers."
  ],
  "fonts": [
    {
      "id": "syne",
      "family": "Syne",
      "path": "fonts/syne.ttf",
      "license": "fonts/syne-OFL.txt",
      "weight": "400 800",
      "style": "normal"
    },
    {
      "id": "work-sans",
      "family": "Work Sans",
      "path": "fonts/work-sans.ttf",
      "license": "fonts/work-sans-OFL.txt",
      "weight": "100 900",
      "style": "normal"
    },
    {
      "id": "dm-mono",
      "family": "DM Mono",
      "path": "fonts/dm-mono.ttf",
      "license": "fonts/dm-mono-OFL.txt",
      "weight": "400",
      "style": "normal"
    }
  ],
  "exports": [
    "mark.svg",
    "lockup.svg",
    "wordmark.svg",
    "monochrome.svg",
    "pattern.svg",
    "poster.svg",
    "social.svg",
    "avatar.svg",
    "favicon.svg",
    "artwork.svg",
    "identity-board.svg",
    "stationery.svg",
    "packaging.svg",
    "website.svg",
    "social-story.svg",
    "icon-set.svg",
    "palette.svg",
    "typography.svg",
    "business-card.svg",
    "tokens.json",
    "theme.css",
    "theme.json",
    "theme.js",
    "reference.html",
    "components.html",
    "components.tsx",
    "install-theme.mjs",
    "AI-PROMPT.md",
    "INSTALL.md",
    "guidelines.md"
  ],
  "license": {
    "artwork": "CC0-1.0",
    "code": "MIT",
    "fonts": "OFL-1.1"
  },
  "acceptance": [
    "The exact stylesheet loads without a 404.",
    "All local fonts load; there are no requests to remote font services.",
    "The root or intended subtree carries the exact data-openform attribute.",
    "The supplied display font, colors, radius, spacing, and layout family are used consistently.",
    "At 360px, 768px, and 1440px there is no horizontal page overflow.",
    "Navigation, forms, routes, and existing business behavior still work.",
    "Controls are keyboard accessible with visible focus; reduced-motion preferences are respected.",
    "The final interface follows reference.html and components.html rather than a guessed visual style."
  ]
}
