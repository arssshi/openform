{
  "format": "openform-theme",
  "version": "2.0.0",
  "id": "mellow",
  "name": "mellow",
  "direction": "Soft-focus optimism",
  "concept": "Rounded sunburst ceramics, grooved color bands, hand-friendly shapes, and delightfully plump serif lettering. Nostalgia becomes an optimistic, useful everyday system.",
  "scope": {
    "attribute": "data-openform",
    "value": "mellow",
    "selector": "[data-openform=\"mellow\"]"
  },
  "installation": {
    "command": "node install-theme.mjs --target /path/to/your/project",
    "publicDirectory": "public",
    "destination": "themes/mellow",
    "stylesheet": "/themes/mellow/theme.css",
    "reference": "/themes/mellow/reference.html",
    "components": "/themes/mellow/components.html",
    "htmlAttribute": "data-openform=\"mellow\""
  },
  "colors": {
    "ink": "#713F4A",
    "accent": "#F0BA99",
    "paper": "#FCEDCE",
    "support": "#B7B885",
    "secondary": "#86595e",
    "border": "#d6beaa",
    "heroBackground": "#F0BA99",
    "heroForeground": "#713F4A",
    "buttonBackground": "#713F4A",
    "buttonForeground": "#FCEDCE"
  },
  "typography": {
    "display": {
      "family": "Fraunces",
      "file": "fonts/fraunces.ttf",
      "weight": 900,
      "trackingEm": -0.05,
      "lineHeight": 1.02,
      "desktopMaxPx": 96,
      "mobileMinPx": 38
    },
    "body": {
      "family": "Outfit",
      "file": "fonts/outfit.ttf",
      "weight": 400,
      "sizePx": 16,
      "lineHeight": 1.7
    },
    "accent": {
      "family": "Fraunces",
      "file": "fonts/fraunces.ttf",
      "style": "normal"
    },
    "label": {
      "sizePx": 11,
      "trackingEm": 0.08,
      "lineHeight": 1.5
    }
  },
  "layout": {
    "id": "groovy",
    "family": "retro",
    "mode": "accent",
    "alignment": "center",
    "maxWidthPx": 1220,
    "pageGutter": "clamp(20px, 4vw, 64px)",
    "sectionGap": "clamp(64px, 9vw, 128px)",
    "heroTextRatio": 0.5,
    "gridColumns": 3,
    "breakpoints": {
      "mobile": 640,
      "tablet": 960
    },
    "description": "Peach centered hero with chunky Fraunces lettering and a grooved sunburst. Mulberry controls, butter-colored rounded cards, and a relaxed sectional rhythm."
  },
  "components": {
    "classes": {
      "root": "of-theme",
      "container": "of-container",
      "header": "of-header",
      "navigation": "of-nav",
      "mobileNavigation": "of-mobile-nav",
      "logo": "of-logo",
      "eyebrow": "of-eyebrow",
      "hero": "of-hero",
      "heroCopy": "of-hero-copy",
      "heroHeading": "of-display",
      "heroMedia": "of-hero-media",
      "heading": "of-heading",
      "body": "of-body",
      "actions": "of-actions",
      "button": "of-button",
      "secondaryButton": "of-button of-button--ghost",
      "section": "of-section",
      "sectionHeading": "of-section-heading",
      "grid": "of-grid",
      "card": "of-card",
      "cardImage": "of-card-image",
      "badge": "of-badge",
      "form": "of-form",
      "field": "of-field",
      "input": "of-input",
      "select": "of-select",
      "textarea": "of-textarea",
      "notice": "of-notice",
      "table": "of-table",
      "accordion": "of-accordion",
      "footer": "of-footer"
    },
    "radiusPx": 26,
    "cardRadiusPx": 0,
    "borderPx": 1,
    "buttonShape": "pill",
    "minimumControlHeightPx": 48,
    "inputHeightPx": 52,
    "focus": {
      "widthPx": 3,
      "offsetPx": 4,
      "color": "#713F4A"
    }
  },
  "content": {
    "headline": [
      "Good days.",
      "At your own pace."
    ],
    "eyebrow": "GOOD OBJECTS / SOFT LANDINGS",
    "cta": "Meet your mellow",
    "secondaryCta": "The way we see things",
    "nav": [
      "Good objects",
      "The good feeling",
      "Notes"
    ],
    "features": [
      [
        "A warm beginning",
        "Everyday objects with a generous, easygoing personality."
      ],
      [
        "The soft details",
        "Form and texture that make a place feel more like yours."
      ],
      [
        "Take it your way",
        "A collection that leaves room for your own rhythm."
      ]
    ]
  },
  "rules": [
    "Sparkles use soft inward curves, never sharp straight spokes.",
    "Keep backgrounds warm and use mulberry to anchor the composition.",
    "Set short, chunky headlines with tight spacing and spacious supporting copy.",
    "Peach centered hero with chunky Fraunces lettering and a grooved sunburst. Mulberry controls, butter-colored rounded cards, and a relaxed sectional rhythm.",
    "Use the supplied artwork and SVG logos; keep glyph proportions intact.",
    "Preserve the existing project content, routes, data fetching, and interaction handlers."
  ],
  "fonts": [
    {
      "id": "fraunces",
      "family": "Fraunces",
      "path": "fonts/fraunces.ttf",
      "license": "fonts/fraunces-OFL.txt",
      "weight": "100 900",
      "style": "normal"
    },
    {
      "id": "outfit",
      "family": "Outfit",
      "path": "fonts/outfit.ttf",
      "license": "fonts/outfit-OFL.txt",
      "weight": "100 900",
      "style": "normal"
    }
  ],
  "exports": [
    "mark.svg",
    "lockup.svg",
    "wordmark.svg",
    "monochrome.svg",
    "pattern.svg",
    "poster.svg",
    "social.svg",
    "avatar.svg",
    "favicon.svg",
    "artwork.svg",
    "identity-board.svg",
    "stationery.svg",
    "packaging.svg",
    "website.svg",
    "social-story.svg",
    "icon-set.svg",
    "palette.svg",
    "typography.svg",
    "business-card.svg",
    "tokens.json",
    "theme.css",
    "theme.json",
    "theme.js",
    "reference.html",
    "components.html",
    "components.tsx",
    "install-theme.mjs",
    "AI-PROMPT.md",
    "INSTALL.md",
    "guidelines.md"
  ],
  "license": {
    "artwork": "CC0-1.0",
    "code": "MIT",
    "fonts": "OFL-1.1"
  },
  "acceptance": [
    "The exact stylesheet loads without a 404.",
    "All local fonts load; there are no requests to remote font services.",
    "The root or intended subtree carries the exact data-openform attribute.",
    "The supplied display font, colors, radius, spacing, and layout family are used consistently.",
    "At 360px, 768px, and 1440px there is no horizontal page overflow.",
    "Navigation, forms, routes, and existing business behavior still work.",
    "Controls are keyboard accessible with visible focus; reduced-motion preferences are respected.",
    "The final interface follows reference.html and components.html rather than a guessed visual style."
  ]
}
