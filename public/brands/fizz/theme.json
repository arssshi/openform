{
  "format": "openform-theme",
  "version": "2.0.0",
  "id": "fizz",
  "name": "fizz!",
  "direction": "Botanical pop culture",
  "concept": "Playful exploded bubbles, juicy gradient fruit forms, loud can labels, and exuberant rounded lettering. Flavor becomes a bold, clear graphic system.",
  "scope": {
    "attribute": "data-openform",
    "value": "fizz",
    "selector": "[data-openform=\"fizz\"]"
  },
  "installation": {
    "command": "node install-theme.mjs --target /path/to/your/project",
    "publicDirectory": "public",
    "destination": "themes/fizz",
    "stylesheet": "/themes/fizz/theme.css",
    "reference": "/themes/fizz/reference.html",
    "components": "/themes/fizz/components.html",
    "htmlAttribute": "data-openform=\"fizz\""
  },
  "colors": {
    "ink": "#4E3048",
    "accent": "#F8AA64",
    "paper": "#FFF1C9",
    "support": "#CAA7D8",
    "secondary": "#694d5b",
    "border": "#cfbda6",
    "heroBackground": "#F8AA64",
    "heroForeground": "#4E3048",
    "buttonBackground": "#4E3048",
    "buttonForeground": "#FFF1C9"
  },
  "typography": {
    "display": {
      "family": "Outfit",
      "file": "fonts/outfit.ttf",
      "weight": 900,
      "trackingEm": -0.06,
      "lineHeight": 1.02,
      "desktopMaxPx": 96,
      "mobileMinPx": 38
    },
    "body": {
      "family": "Rubik",
      "file": "fonts/rubik.ttf",
      "weight": 400,
      "sizePx": 16,
      "lineHeight": 1.7
    },
    "accent": {
      "family": "Rubik",
      "file": "fonts/rubik.ttf",
      "style": "normal"
    },
    "label": {
      "sizePx": 11,
      "trackingEm": 0.08,
      "lineHeight": 1.5
    }
  },
  "layout": {
    "id": "pop",
    "family": "playful",
    "mode": "accent",
    "alignment": "left",
    "maxWidthPx": 1300,
    "pageGutter": "clamp(20px, 4vw, 64px)",
    "sectionGap": "clamp(64px, 9vw, 128px)",
    "heroTextRatio": 0.54,
    "gridColumns": 3,
    "breakpoints": {
      "mobile": 640,
      "tablet": 960
    },
    "description": "Tangerine hero with massive playful lowercase, a sculptural fruit-and-bubble image, and blackcurrant pill controls. Flavor cards alternate grape and foam surfaces."
  },
  "components": {
    "classes": {
      "root": "of-theme",
      "container": "of-container",
      "header": "of-header",
      "navigation": "of-nav",
      "mobileNavigation": "of-mobile-nav",
      "logo": "of-logo",
      "eyebrow": "of-eyebrow",
      "hero": "of-hero",
      "heroCopy": "of-hero-copy",
      "heroHeading": "of-display",
      "heroMedia": "of-hero-media",
      "heading": "of-heading",
      "body": "of-body",
      "actions": "of-actions",
      "button": "of-button",
      "secondaryButton": "of-button of-button--ghost",
      "section": "of-section",
      "sectionHeading": "of-section-heading",
      "grid": "of-grid",
      "card": "of-card",
      "cardImage": "of-card-image",
      "badge": "of-badge",
      "form": "of-form",
      "field": "of-field",
      "input": "of-input",
      "select": "of-select",
      "textarea": "of-textarea",
      "notice": "of-notice",
      "table": "of-table",
      "accordion": "of-accordion",
      "footer": "of-footer"
    },
    "radiusPx": 24,
    "cardRadiusPx": 0,
    "borderPx": 1,
    "buttonShape": "pill",
    "minimumControlHeightPx": 48,
    "inputHeightPx": 52,
    "focus": {
      "widthPx": 3,
      "offsetPx": 4,
      "color": "#4E3048"
    }
  },
  "content": {
    "headline": [
      "A little fizz.",
      "A lot of bright side."
    ],
    "eyebrow": "BOTANICAL SODA / GOOD SPIRITS",
    "cta": "Find your flavor",
    "secondaryCta": "What is inside",
    "nav": [
      "The flavors",
      "The good ingredients",
      "Pop notes"
    ],
    "features": [
      [
        "A bright first sip",
        "Botanical combinations with a character of their own."
      ],
      [
        "Good things inside",
        "Useful, plainly stated ingredients without the mystery."
      ],
      [
        "Pop open a moment",
        "A small, sunny pleasure for the way your day goes."
      ]
    ]
  },
  "rules": [
    "The burst uses alternating spoke lengths and a clear central dot.",
    "Keep flavor information in distinct color blocks.",
    "The exclamation point is part of the wordmark and should never be omitted.",
    "Tangerine hero with massive playful lowercase, a sculptural fruit-and-bubble image, and blackcurrant pill controls. Flavor cards alternate grape and foam surfaces.",
    "Use the supplied artwork and SVG logos; keep glyph proportions intact.",
    "Preserve the existing project content, routes, data fetching, and interaction handlers."
  ],
  "fonts": [
    {
      "id": "outfit",
      "family": "Outfit",
      "path": "fonts/outfit.ttf",
      "license": "fonts/outfit-OFL.txt",
      "weight": "100 900",
      "style": "normal"
    },
    {
      "id": "rubik",
      "family": "Rubik",
      "path": "fonts/rubik.ttf",
      "license": "fonts/rubik-OFL.txt",
      "weight": "300 900",
      "style": "normal"
    }
  ],
  "exports": [
    "mark.svg",
    "lockup.svg",
    "wordmark.svg",
    "monochrome.svg",
    "pattern.svg",
    "poster.svg",
    "social.svg",
    "avatar.svg",
    "favicon.svg",
    "artwork.svg",
    "identity-board.svg",
    "stationery.svg",
    "packaging.svg",
    "website.svg",
    "social-story.svg",
    "icon-set.svg",
    "palette.svg",
    "typography.svg",
    "business-card.svg",
    "tokens.json",
    "theme.css",
    "theme.json",
    "theme.js",
    "reference.html",
    "components.html",
    "components.tsx",
    "install-theme.mjs",
    "AI-PROMPT.md",
    "INSTALL.md",
    "guidelines.md"
  ],
  "license": {
    "artwork": "CC0-1.0",
    "code": "MIT",
    "fonts": "OFL-1.1"
  },
  "acceptance": [
    "The exact stylesheet loads without a 404.",
    "All local fonts load; there are no requests to remote font services.",
    "The root or intended subtree carries the exact data-openform attribute.",
    "The supplied display font, colors, radius, spacing, and layout family are used consistently.",
    "At 360px, 768px, and 1440px there is no horizontal page overflow.",
    "Navigation, forms, routes, and existing business behavior still work.",
    "Controls are keyboard accessible with visible focus; reduced-motion preferences are respected.",
    "The final interface follows reference.html and components.html rather than a guessed visual style."
  ]
}
