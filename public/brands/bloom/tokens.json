    "bodyLeading": {
      "$type": "number",
      "$value": 1.7
    }
  },
  "radius": {
    "$type": "dimension",
    "$value": {
      "value": 32,
      "unit": "px"
    }
  },
  "spacing": {
    "unit": {
      "$type": "dimension",
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "pageMinimum": {
      "$type": "dimension",
      "$value": {
        "value": 20,
        "unit": "px"
      }
    },
    "pageMaximum": {
      "$type": "dimension",
      "$value": {
        "value": 64,
        "unit": "px"
      }
    }
  },
  "$extensions": {
    "openform": {
      "name": "bloom",
      "version": "2.0.0",
      "style": "Playful",
      "direction": "Joyful object culture",
      "voice": "Sunny, conversational, and a little cheeky.",
      "layout": {
        "id": "sticker",
        "family": "playful",
        "mode": "accent",
        "alignment": "center",
        "maxWidthPx": 1240,
        "pageGutter": "clamp(20px, 4vw, 64px)",
        "sectionGap": "clamp(64px, 9vw, 128px)",
        "heroTextRatio": 0.5,
        "gridColumns": 3,
        "breakpoints": {
          "mobile": 640,
          "tablet": 960
        },
        "description": "Centered coral hero, rounded petal artwork below the headline, wide cream pill CTAs, and alternating lilac / vanilla product tiles. Keep the berry text anchor."
      },
      "contrast": [
        {
          "foreground": "#592D48",
          "background": "#F7A6A0",
          "ratio": 5.76,
          "aaNormal": true
        },
        {
          "foreground": "#592D48",
          "background": "#FFF4DA",
          "ratio": 10.14,
          "aaNormal": true
        }
      ]
    }
  }
