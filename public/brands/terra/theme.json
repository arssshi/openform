{
  "format": "openform-theme",
  "version": "2.0.0",
  "id": "terra",
  "name": "terra",
  "direction": "Built from the ground",
  "concept": "Stratified clay objects, contour-like architecture, raw material studies, and grounded serif contrasts. The identity keeps the landscape visibly present in every application.",
  "scope": {
    "attribute": "data-openform",
    "value": "terra",
    "selector": "[data-openform=\"terra\"]"
  },
  "installation": {
    "command": "node install-theme.mjs --target /path/to/your/project",
    "publicDirectory": "public",
    "destination": "themes/terra",
    "stylesheet": "/themes/terra/theme.css",
    "reference": "/themes/terra/reference.html",
    "components": "/themes/terra/components.html",
    "htmlAttribute": "data-openform=\"terra\""
  },
  "colors": {
    "ink": "#4D3026",
    "accent": "#D5A383",
    "paper": "#F1E9D9",
    "support": "#69817D",
    "secondary": "#664c41",
    "border": "#c5b7a9",
    "heroBackground": "#F1E9D9",
    "heroForeground": "#4D3026",
    "buttonBackground": "#4D3026",
    "buttonForeground": "#F1E9D9"
  },
  "typography": {
    "display": {
      "family": "Lora",
      "file": "fonts/lora.ttf",
      "weight": 600,
      "trackingEm": -0.02,
      "lineHeight": 1.02,
      "desktopMaxPx": 96,
      "mobileMinPx": 38
    },
    "body": {
      "family": "Manrope",
      "file": "fonts/manrope.ttf",
      "weight": 400,
      "sizePx": 16,
      "lineHeight": 1.7
    },
    "accent": {
      "family": "Instrument Serif",
      "file": "fonts/instrument-serif-italic.ttf",
      "style": "italic"
    },
    "label": {
      "sizePx": 11,
      "trackingEm": 0.08,
      "lineHeight": 1.5
    }
  },
  "layout": {
    "id": "strata",
    "family": "architecture",
    "mode": "paper",
    "alignment": "left",
    "maxWidthPx": 1380,
    "pageGutter": "clamp(20px, 4vw, 64px)",
    "sectionGap": "clamp(64px, 9vw, 128px)",
    "heroTextRatio": 0.48,
    "gridColumns": 3,
    "breakpoints": {
      "mobile": 640,
      "tablet": 960
    },
    "description": "Limestone hero with earth serif type and layered clay architecture. Horizontal unequal-height sections, weathered-green annotations, and generous project imagery."
  },
  "components": {
    "classes": {
      "root": "of-theme",
      "container": "of-container",
      "header": "of-header",
      "navigation": "of-nav",
      "mobileNavigation": "of-mobile-nav",
      "logo": "of-logo",
      "eyebrow": "of-eyebrow",
      "hero": "of-hero",
      "heroCopy": "of-hero-copy",
      "heroHeading": "of-display",
      "heroMedia": "of-hero-media",
      "heading": "of-heading",
      "body": "of-body",
      "actions": "of-actions",
      "button": "of-button",
      "secondaryButton": "of-button of-button--ghost",
      "section": "of-section",
      "sectionHeading": "of-section-heading",
      "grid": "of-grid",
      "card": "of-card",
      "cardImage": "of-card-image",
      "badge": "of-badge",
      "form": "of-form",
      "field": "of-field",
      "input": "of-input",
      "select": "of-select",
      "textarea": "of-textarea",
      "notice": "of-notice",
      "table": "of-table",
      "accordion": "of-accordion",
      "footer": "of-footer"
    },
    "radiusPx": 6,
    "cardRadiusPx": 0,
    "borderPx": 1,
    "buttonShape": "soft",
    "minimumControlHeightPx": 48,
    "inputHeightPx": 52,
    "focus": {
      "widthPx": 3,
      "offsetPx": 4,
      "color": "#4D3026"
    }
  },
  "content": {
    "headline": [
      "Good places.",
      "Made from good ground."
    ],
    "eyebrow": "ARCHITECTURE / LANDSCAPE / MATERIAL",
    "cta": "Explore the places",
    "secondaryCta": "Our material approach",
    "nav": [
      "Places",
      "Material approach",
      "Field studies"
    ],
    "features": [
      [
        "Begin with the place",
        "An approach shaped by the landscape and the life already there."
      ],
      [
        "Material with a memory",
        "Honest surfaces, local character, and carefully considered form."
      ],
      [
        "Build with care",
        "Thoughtful decisions for the way a place will be lived in."
      ]
    ]
  },
  "rules": [
    "Hill layers are offset but share one continuous lower edge.",
    "Build compositions from horizontal strata with unequal heights.",
    "Use earth text on limestone for all technical explanations.",
    "Limestone hero with earth serif type and layered clay architecture. Horizontal unequal-height sections, weathered-green annotations, and generous project imagery.",
    "Use the supplied artwork and SVG logos; keep glyph proportions intact.",
    "Preserve the existing project content, routes, data fetching, and interaction handlers."
  ],
  "fonts": [
    {
      "id": "lora",
      "family": "Lora",
      "path": "fonts/lora.ttf",
      "license": "fonts/lora-OFL.txt",
      "weight": "400 700",
      "style": "normal"
    },
    {
      "id": "manrope",
      "family": "Manrope",
      "path": "fonts/manrope.ttf",
      "license": "fonts/manrope-OFL.txt",
      "weight": "200 800",
      "style": "normal"
    },
    {
      "id": "instrument-serif-italic",
      "family": "Instrument Serif",
      "path": "fonts/instrument-serif-italic.ttf",
      "license": "fonts/instrument-serif-italic-OFL.txt",
      "weight": "400",
      "style": "italic"
    }
  ],
  "exports": [
    "mark.svg",
    "lockup.svg",
    "wordmark.svg",
    "monochrome.svg",
    "pattern.svg",
    "poster.svg",
    "social.svg",
    "avatar.svg",
    "favicon.svg",
    "artwork.svg",
    "identity-board.svg",
    "stationery.svg",
    "packaging.svg",
    "website.svg",
    "social-story.svg",
    "icon-set.svg",
    "palette.svg",
    "typography.svg",
    "business-card.svg",
    "tokens.json",
    "theme.css",
    "theme.json",
    "theme.js",
    "reference.html",
    "components.html",
    "components.tsx",
    "install-theme.mjs",
    "AI-PROMPT.md",
    "INSTALL.md",
    "guidelines.md"
  ],
  "license": {
    "artwork": "CC0-1.0",
    "code": "MIT",
    "fonts": "OFL-1.1"
  },
  "acceptance": [
    "The exact stylesheet loads without a 404.",
    "All local fonts load; there are no requests to remote font services.",
    "The root or intended subtree carries the exact data-openform attribute.",
    "The supplied display font, colors, radius, spacing, and layout family are used consistently.",
    "At 360px, 768px, and 1440px there is no horizontal page overflow.",
    "Navigation, forms, routes, and existing business behavior still work.",
    "Controls are keyboard accessible with visible focus; reduced-motion preferences are respected.",
    "The final interface follows reference.html and components.html rather than a guessed visual style."
  ]
}
