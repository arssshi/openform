{
  "format": "openform-theme",
  "version": "2.0.0",
  "id": "serein",
  "name": "SEREIN",
  "direction": "The small hours",
  "concept": "Moonlit tea objects, celestial hairline diagrams, deep-blue packaging, and gracefully tracked serif capitals. A nocturnal world with unmistakable hospitality.",
  "scope": {
    "attribute": "data-openform",
    "value": "serein",
    "selector": "[data-openform=\"serein\"]"
  },
  "installation": {
    "command": "node install-theme.mjs --target /path/to/your/project",
    "publicDirectory": "public",
    "destination": "themes/serein",
    "stylesheet": "/themes/serein/theme.css",
    "reference": "/themes/serein/reference.html",
    "components": "/themes/serein/components.html",
    "htmlAttribute": "data-openform=\"serein\""
  },
  "colors": {
    "ink": "#293A4F",
    "accent": "#DCCAA0",
    "paper": "#F3EDE0",
    "support": "#A1AFAB",
    "secondary": "#475565",
    "border": "#bcbdb9",
    "heroBackground": "#293A4F",
    "heroForeground": "#F3EDE0",
    "buttonBackground": "#DCCAA0",
    "buttonForeground": "#293A4F"
  },
  "typography": {
    "display": {
      "family": "Prata",
      "file": "fonts/prata.ttf",
      "weight": 400,
      "trackingEm": 0.08,
      "lineHeight": 1.04,
      "desktopMaxPx": 96,
      "mobileMinPx": 38
    },
    "body": {
      "family": "Manrope",
      "file": "fonts/manrope.ttf",
      "weight": 400,
      "sizePx": 16,
      "lineHeight": 1.7
    },
    "accent": {
      "family": "Instrument Serif",
      "file": "fonts/instrument-serif-italic.ttf",
      "style": "italic"
    },
    "label": {
      "sizePx": 11,
      "trackingEm": 0.08,
      "lineHeight": 1.5
    }
  },
  "layout": {
    "id": "nocturne",
    "family": "hospitality",
    "mode": "dark",
    "alignment": "center",
    "maxWidthPx": 1180,
    "pageGutter": "clamp(20px, 4vw, 64px)",
    "sectionGap": "clamp(64px, 9vw, 128px)",
    "heroTextRatio": 0.5,
    "gridColumns": 3,
    "breakpoints": {
      "mobile": 640,
      "tablet": 960
    },
    "description": "Midnight centered serif hero, champagne type, moonlit tea artwork, and thin celestial frames. Keep the tracked capitals for labels and the wordmark, not paragraphs."
  },
  "components": {
    "classes": {
      "root": "of-theme",
      "container": "of-container",
      "header": "of-header",
      "navigation": "of-nav",
      "mobileNavigation": "of-mobile-nav",
      "logo": "of-logo",
      "eyebrow": "of-eyebrow",
      "hero": "of-hero",
      "heroCopy": "of-hero-copy",
      "heroHeading": "of-display",
      "heroMedia": "of-hero-media",
      "heading": "of-heading",
      "body": "of-body",
      "actions": "of-actions",
      "button": "of-button",
      "secondaryButton": "of-button of-button--ghost",
      "section": "of-section",
      "sectionHeading": "of-section-heading",
      "grid": "of-grid",
      "card": "of-card",
      "cardImage": "of-card-image",
      "badge": "of-badge",
      "form": "of-form",
      "field": "of-field",
      "input": "of-input",
      "select": "of-select",
      "textarea": "of-textarea",
      "notice": "of-notice",
      "table": "of-table",
      "accordion": "of-accordion",
      "footer": "of-footer"
    },
    "radiusPx": 2,
    "cardRadiusPx": 0,
    "borderPx": 1,
    "buttonShape": "outline",
    "minimumControlHeightPx": 48,
    "inputHeightPx": 52,
    "focus": {
      "widthPx": 3,
      "offsetPx": 4,
      "color": "#293A4F"
    }
  },
  "content": {
    "headline": [
      "Stay for",
      "a softer evening."
    ],
    "eyebrow": "TEA / CONVERSATION / THE SMALL HOURS",
    "cta": "Explore the evening",
    "secondaryCta": "The salon",
    "nav": [
      "The tea",
      "The salon",
      "Evening notes"
    ],
    "features": [
      [
        "An evening, unhurried",
        "A thoughtful place to let the day become something softer."
      ],
      [
        "Tea with a point of view",
        "Small, considered pleasures and a table worth lingering at."
      ],
      [
        "A quieter conversation",
        "Room for company, reflection, and the passing of time."
      ]
    ]
  },
  "rules": [
    "The crescent opens to the right and retains a fine inner curve.",
    "Use tracked capitals for the wordmark, never for paragraphs.",
    "Let champagne lines and borders remain subtle against after dark.",
    "Midnight centered serif hero, champagne type, moonlit tea artwork, and thin celestial frames. Keep the tracked capitals for labels and the wordmark, not paragraphs.",
    "Use the supplied artwork and SVG logos; keep glyph proportions intact.",
    "Preserve the existing project content, routes, data fetching, and interaction handlers."
  ],
  "fonts": [
    {
      "id": "prata",
      "family": "Prata",
      "path": "fonts/prata.ttf",
      "license": "fonts/prata-OFL.txt",
      "weight": "400",
      "style": "normal"
    },
    {
      "id": "manrope",
      "family": "Manrope",
      "path": "fonts/manrope.ttf",
      "license": "fonts/manrope-OFL.txt",
      "weight": "200 800",
      "style": "normal"
    },
    {
      "id": "instrument-serif-italic",
      "family": "Instrument Serif",
      "path": "fonts/instrument-serif-italic.ttf",
      "license": "fonts/instrument-serif-italic-OFL.txt",
      "weight": "400",
      "style": "italic"
    }
  ],
  "exports": [
    "mark.svg",
    "lockup.svg",
    "wordmark.svg",
    "monochrome.svg",
    "pattern.svg",
    "poster.svg",
    "social.svg",
    "avatar.svg",
    "favicon.svg",
    "artwork.svg",
    "identity-board.svg",
    "stationery.svg",
    "packaging.svg",
    "website.svg",
    "social-story.svg",
    "icon-set.svg",
    "palette.svg",
    "typography.svg",
    "business-card.svg",
    "tokens.json",
    "theme.css",
    "theme.json",
    "theme.js",
    "reference.html",
    "components.html",
    "components.tsx",
    "install-theme.mjs",
    "AI-PROMPT.md",
    "INSTALL.md",
    "guidelines.md"
  ],
  "license": {
    "artwork": "CC0-1.0",
    "code": "MIT",
    "fonts": "OFL-1.1"
  },
  "acceptance": [
    "The exact stylesheet loads without a 404.",
    "All local fonts load; there are no requests to remote font services.",
    "The root or intended subtree carries the exact data-openform attribute.",
    "The supplied display font, colors, radius, spacing, and layout family are used consistently.",
    "At 360px, 768px, and 1440px there is no horizontal page overflow.",
    "Navigation, forms, routes, and existing business behavior still work.",
    "Controls are keyboard accessible with visible focus; reduced-motion preferences are respected.",
    "The final interface follows reference.html and components.html rather than a guessed visual style."
  ]
}
