{
  "$description": "OUTLIER / The independent issue / Edition 02",
  "color": {
    "ink": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.1451,
          0.12941,
          0.12549
        ],
        "alpha": 1
      },
      "$extensions": {
        "openform.hex": "#252120"
      }
    },
    "accent": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.84706,
          0.46275,
          0.36471
        ],
        "alpha": 1
      },
      "$extensions": {
        "openform.hex": "#D8765D"
      }
    },
    "paper": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.94118,
          0.9098,
          0.85098
        ],
        "alpha": 1
      },
      "$extensions": {
        "openform.hex": "#F0E8D9"
      }
    },
    "support": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.72157,
          0.77647,
          0.66667
        ],
        "alpha": 1
      },
      "$extensions": {
        "openform.hex": "#B8C6AA"
      }
    }
  },
  "typography": {
    "heading": {
      "$type": "fontFamily",
      "$value": "Bebas Neue"
    },
    "body": {
      "$type": "fontFamily",
      "$value": "DM Mono"
    },
    "headingWeight": {
      "$type": "fontWeight",
      "$value": 400
    },
    "tracking": {
      "$type": "number",
      "$value": 0.02,
      "$description": "Display letter spacing in em units."
    },
    "bodySize": {
      "$type": "dimension",
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "bodyLeading": {
      "$type": "number",
      "$value": 1.7
    }
  },
  "radius": {
    "$type": "dimension",
    "$value": {
      "value": 0,
      "unit": "px"
    }
  },
  "spacing": {
    "unit": {
      "$type": "dimension",
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "pageMinimum": {
      "$type": "dimension",
      "$value": {
        "value": 20,
        "unit": "px"
      }
    },
    "pageMaximum": {
      "$type": "dimension",
      "$value": {
        "value": 64,
        "unit": "px"
      }
    }
  },
  "$extensions": {
    "openform": {
      "name": "OUTLIER",
      "version": "2.0.0",
      "style": "Brutalist",
      "direction": "The independent issue",
      "voice": "Independent, candid, and fearless.",
      "layout": {
        "id": "disruption",
        "family": "poster",
        "mode": "accent",
        "alignment": "left",
        "maxWidthPx": 1420,
        "pageGutter": "clamp(20px, 4vw, 64px)",
        "sectionGap": "clamp(64px, 9vw, 128px)",
        "heroTextRatio": 0.6,
        "gridColumns": 3,
        "breakpoints": {
          "mobile": 640,
          "tablet": 960
        },
        "description": "Oxide poster hero with condensed giant type and displaced fabric geometry. Square black CTA, strong grid rules, and utilitarian care-label captions."
      },
      "contrast": [
        {
          "foreground": "#252120",
          "background": "#D8765D",
          "ratio": 5.06,
          "aaNormal": true
        },
        {
          "foreground": "#252120",
          "background": "#F0E8D9",
          "ratio": 13.1,
          "aaNormal": true
        }
      ]
    }
  }
}
