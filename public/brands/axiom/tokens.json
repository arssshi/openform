{
  "$description": "AXIOM / Open intellectual structure / Edition 02",
  "color": {
    "ink": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.1451,
          0.21569,
          0.27059
        ],
        "alpha": 1
      },
      "$extensions": {
        "openform.hex": "#253745"
      }
    },
    "accent": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.65098,
          0.83137,
          0.88235
        ],
        "alpha": 1
      },
      "$extensions": {
        "openform.hex": "#A6D4E1"
      }
    },
    "paper": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.93725,
          0.95686,
          0.94902
        ],
        "alpha": 1
      },
      "$extensions": {
        "openform.hex": "#EFF4F2"
      }
    },
    "support": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.82745,
          0.72549,
          0.52549
        ],
        "alpha": 1
      },
      "$extensions": {
        "openform.hex": "#D3B986"
      }
    }
  },
  "typography": {
    "heading": {
      "$type": "fontFamily",
      "$value": "Space Grotesk"
    },
    "body": {
      "$type": "fontFamily",
      "$value": "Archivo"
    },
    "headingWeight": {
      "$type": "fontWeight",
      "$value": 500
    },
    "tracking": {
      "$type": "number",
      "$value": 0.07,
      "$description": "Display letter spacing in em units."
    },
    "bodySize": {
      "$type": "dimension",
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "bodyLeading": {
      "$type": "number",
      "$value": 1.7
    }
  },
  "radius": {
    "$type": "dimension",
    "$value": {
      "value": 2,
      "unit": "px"
    }
  },
  "spacing": {
    "unit": {
      "$type": "dimension",
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "pageMinimum": {
      "$type": "dimension",
      "$value": {
        "value": 20,
        "unit": "px"
      }
    },
    "pageMaximum": {
      "$type": "dimension",
      "$value": {
        "value": 64,
        "unit": "px"
      }
    }
  },
  "$extensions": {
    "openform": {
      "name": "AXIOM",
      "version": "2.0.0",
      "style": "Futuristic",
      "direction": "Open intellectual structure",
      "voice": "Inquisitive, rigorous, and accessible.",
      "layout": {
        "id": "blueprint",
        "family": "terminal",
        "mode": "paper",
        "alignment": "left",
        "maxWidthPx": 1420,
        "pageGutter": "clamp(20px, 4vw, 64px)",
        "sectionGap": "clamp(64px, 9vw, 128px)",
        "heroTextRatio": 0.48,
        "gridColumns": 3,
        "breakpoints": {
          "mobile": 640,
          "tablet": 960
        },
        "description": "Clarity-white technical hero, a glacial triangular study, wide-set titles, and fine blueprint lines. Research details use a strict, readable module grid."
      },
      "contrast": [
        {
          "foreground": "#253745",
          "background": "#A6D4E1",
          "ratio": 7.67,
          "aaNormal": true
        },
        {
          "foreground": "#253745",
          "background": "#EFF4F2",
          "ratio": 11.04,
          "aaNormal": true
        }
      ]
    }
  }
}
