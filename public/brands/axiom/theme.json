{
  "format": "openform-theme",
  "version": "2.0.0",
  "id": "axiom",
  "name": "AXIOM",
  "direction": "Open intellectual structure",
  "concept": "Impossible triangular studies, glacial blueprint fields, precise research annotations, and wide-set modern type. Complexity is presented with a deeply legible visual order.",
  "scope": {
    "attribute": "data-openform",
    "value": "axiom",
    "selector": "[data-openform=\"axiom\"]"
  },
  "installation": {
    "command": "node install-theme.mjs --target /path/to/your/project",
    "publicDirectory": "public",
    "destination": "themes/axiom",
    "stylesheet": "/themes/axiom/theme.css",
    "reference": "/themes/axiom/reference.html",
    "components": "/themes/axiom/components.html",
    "htmlAttribute": "data-openform=\"axiom\""
  },
  "colors": {
    "ink": "#253745",
    "accent": "#A6D4E1",
    "paper": "#EFF4F2",
    "support": "#D3B986",
    "secondary": "#43535f",
    "border": "#b8c1c3",
    "heroBackground": "#EFF4F2",
    "heroForeground": "#253745",
    "buttonBackground": "#253745",
    "buttonForeground": "#EFF4F2"
  },
  "typography": {
    "display": {
      "family": "Space Grotesk",
      "file": "fonts/space-grotesk.ttf",
      "weight": 500,
      "trackingEm": 0.07,
      "lineHeight": 1.02,
      "desktopMaxPx": 96,
      "mobileMinPx": 38
    },
    "body": {
      "family": "Archivo",
      "file": "fonts/archivo.ttf",
      "weight": 400,
      "sizePx": 16,
      "lineHeight": 1.7
    },
    "accent": {
      "family": "DM Mono",
      "file": "fonts/dm-mono.ttf",
      "style": "normal"
    },
    "label": {
      "sizePx": 11,
      "trackingEm": 0.08,
      "lineHeight": 1.5
    }
  },
  "layout": {
    "id": "blueprint",
    "family": "terminal",
    "mode": "paper",
    "alignment": "left",
    "maxWidthPx": 1420,
    "pageGutter": "clamp(20px, 4vw, 64px)",
    "sectionGap": "clamp(64px, 9vw, 128px)",
    "heroTextRatio": 0.48,
    "gridColumns": 3,
    "breakpoints": {
      "mobile": 640,
      "tablet": 960
    },
    "description": "Clarity-white technical hero, a glacial triangular study, wide-set titles, and fine blueprint lines. Research details use a strict, readable module grid."
  },
  "components": {
    "classes": {
      "root": "of-theme",
      "container": "of-container",
      "header": "of-header",
      "navigation": "of-nav",
      "mobileNavigation": "of-mobile-nav",
      "logo": "of-logo",
      "eyebrow": "of-eyebrow",
      "hero": "of-hero",
      "heroCopy": "of-hero-copy",
      "heroHeading": "of-display",
      "heroMedia": "of-hero-media",
      "heading": "of-heading",
      "body": "of-body",
      "actions": "of-actions",
      "button": "of-button",
      "secondaryButton": "of-button of-button--ghost",
      "section": "of-section",
      "sectionHeading": "of-section-heading",
      "grid": "of-grid",
      "card": "of-card",
      "cardImage": "of-card-image",
      "badge": "of-badge",
      "form": "of-form",
      "field": "of-field",
      "input": "of-input",
      "select": "of-select",
      "textarea": "of-textarea",
      "notice": "of-notice",
      "table": "of-table",
      "accordion": "of-accordion",
      "footer": "of-footer"
    },
    "radiusPx": 2,
    "cardRadiusPx": 0,
    "borderPx": 1,
    "buttonShape": "square",
    "minimumControlHeightPx": 48,
    "inputHeightPx": 52,
    "focus": {
      "widthPx": 3,
      "offsetPx": 4,
      "color": "#253745"
    }
  },
  "content": {
    "headline": [
      "A stronger foundation",
      "for the next question."
    ],
    "eyebrow": "OPEN RESEARCH / SHARED DISCOVERY",
    "cta": "Explore the research",
    "secondaryCta": "Read the principles",
    "nav": [
      "Research",
      "Principles",
      "The open archive"
    ],
    "features": [
      [
        "Make a question clear",
        "A useful structure for research that others can understand."
      ],
      [
        "Build on what is known",
        "Thoughtful connections between ideas, evidence, and new possibilities."
      ],
      [
        "Share the foundation",
        "A practice that makes discovery more open and more useful."
      ]
    ]
  },
  "rules": [
    "The three sides of the triangle use matching thickness.",
    "Blueprint lines should support structure, not compete with content.",
    "Use glacier for diagram fields and deep logic for explanatory text.",
    "Clarity-white technical hero, a glacial triangular study, wide-set titles, and fine blueprint lines. Research details use a strict, readable module grid.",
    "Use the supplied artwork and SVG logos; keep glyph proportions intact.",
    "Preserve the existing project content, routes, data fetching, and interaction handlers."
  ],
  "fonts": [
    {
      "id": "space-grotesk",
      "family": "Space Grotesk",
      "path": "fonts/space-grotesk.ttf",
      "license": "fonts/space-grotesk-OFL.txt",
      "weight": "300 700",
      "style": "normal"
    },
    {
      "id": "archivo",
      "family": "Archivo",
      "path": "fonts/archivo.ttf",
      "license": "fonts/archivo-OFL.txt",
      "weight": "100 900",
      "style": "normal"
    },
    {
      "id": "dm-mono",
      "family": "DM Mono",
      "path": "fonts/dm-mono.ttf",
      "license": "fonts/dm-mono-OFL.txt",
      "weight": "400",
      "style": "normal"
    }
  ],
  "exports": [
    "mark.svg",
    "lockup.svg",
    "wordmark.svg",
    "monochrome.svg",
    "pattern.svg",
    "poster.svg",
    "social.svg",
    "avatar.svg",
    "favicon.svg",
    "artwork.svg",
    "identity-board.svg",
    "stationery.svg",
    "packaging.svg",
    "website.svg",
    "social-story.svg",
    "icon-set.svg",
    "palette.svg",
    "typography.svg",
    "business-card.svg",
    "tokens.json",
    "theme.css",
    "theme.json",
    "theme.js",
    "reference.html",
    "components.html",
    "components.tsx",
    "install-theme.mjs",
    "AI-PROMPT.md",
    "INSTALL.md",
    "guidelines.md"
  ],
  "license": {
    "artwork": "CC0-1.0",
    "code": "MIT",
    "fonts": "OFL-1.1"
  },
  "acceptance": [
    "The exact stylesheet loads without a 404.",
    "All local fonts load; there are no requests to remote font services.",
    "The root or intended subtree carries the exact data-openform attribute.",
    "The supplied display font, colors, radius, spacing, and layout family are used consistently.",
    "At 360px, 768px, and 1440px there is no horizontal page overflow.",
    "Navigation, forms, routes, and existing business behavior still work.",
    "Controls are keyboard accessible with visible focus; reduced-motion preferences are respected.",
    "The final interface follows reference.html and components.html rather than a guessed visual style."
  ]
}
