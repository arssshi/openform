{
  "format": "openform-theme",
  "version": "2.0.0",
  "id": "marginalia",
  "name": "Marginalia",
  "direction": "The thoughtful annotation",
  "concept": "Hand-annotated page objects, expressive bracket geometry, faint writing rules, and large literary serifs. The margins become a purposeful second voice.",
  "scope": {
    "attribute": "data-openform",
    "value": "marginalia",
    "selector": "[data-openform=\"marginalia\"]"
  },
  "installation": {
    "command": "node install-theme.mjs --target /path/to/your/project",
    "publicDirectory": "public",
    "destination": "themes/marginalia",
    "stylesheet": "/themes/marginalia/theme.css",
    "reference": "/themes/marginalia/reference.html",
    "components": "/themes/marginalia/components.html",
    "htmlAttribute": "data-openform=\"marginalia\""
  },
  "colors": {
    "ink": "#3B3342",
    "accent": "#CABAE0",
    "paper": "#F5F0E6",
    "support": "#B4B99A",
    "secondary": "#574f5b",
    "border": "#c3bdba",
    "heroBackground": "#F5F0E6",
    "heroForeground": "#3B3342",
    "buttonBackground": "#3B3342",
    "buttonForeground": "#F5F0E6"
  },
  "typography": {
    "display": {
      "family": "Instrument Serif",
      "file": "fonts/instrument-serif.ttf",
      "weight": 400,
      "trackingEm": 0,
      "lineHeight": 1.02,
      "desktopMaxPx": 96,
      "mobileMinPx": 38
    },
    "body": {
      "family": "Work Sans",
      "file": "fonts/work-sans.ttf",
      "weight": 400,
      "sizePx": 16,
      "lineHeight": 1.7
    },
    "accent": {
      "family": "Instrument Serif",
      "file": "fonts/instrument-serif-italic.ttf",
      "style": "italic"
    },
    "label": {
      "sizePx": 11,
      "trackingEm": 0.08,
      "lineHeight": 1.5
    }
  },
  "layout": {
    "id": "margins",
    "family": "editorial",
    "mode": "paper",
    "alignment": "left",
    "maxWidthPx": 1300,
    "pageGutter": "clamp(20px, 4vw, 64px)",
    "sectionGap": "clamp(64px, 9vw, 128px)",
    "heroTextRatio": 0.57,
    "gridColumns": 3,
    "breakpoints": {
      "mobile": 640,
      "tablet": 960
    },
    "description": "Manuscript hero with a lilac annotation rail and expressive serif type. Brackets frame selected ideas; a real wide margin holds secondary notes."
  },
  "components": {
    "classes": {
      "root": "of-theme",
      "container": "of-container",
      "header": "of-header",
      "navigation": "of-nav",
      "mobileNavigation": "of-mobile-nav",
      "logo": "of-logo",
      "eyebrow": "of-eyebrow",
      "hero": "of-hero",
      "heroCopy": "of-hero-copy",
      "heroHeading": "of-display",
      "heroMedia": "of-hero-media",
      "heading": "of-heading",
      "body": "of-body",
      "actions": "of-actions",
      "button": "of-button",
      "secondaryButton": "of-button of-button--ghost",
      "section": "of-section",
      "sectionHeading": "of-section-heading",
      "grid": "of-grid",
      "card": "of-card",
      "cardImage": "of-card-image",
      "badge": "of-badge",
      "form": "of-form",
      "field": "of-field",
      "input": "of-input",
      "select": "of-select",
      "textarea": "of-textarea",
      "notice": "of-notice",
      "table": "of-table",
      "accordion": "of-accordion",
      "footer": "of-footer"
    },
    "radiusPx": 0,
    "cardRadiusPx": 0,
    "borderPx": 1,
    "buttonShape": "outline",
    "minimumControlHeightPx": 48,
    "inputHeightPx": 52,
    "focus": {
      "widthPx": 3,
      "offsetPx": 4,
      "color": "#3B3342"
    }
  },
  "content": {
    "headline": [
      "There is more",
      "in the margins."
    ],
    "eyebrow": "RESEARCH / WRITING / POINTS OF VIEW",
    "cta": "Explore the observations",
    "secondaryCta": "About the practice",
    "nav": [
      "Observations",
      "The practice",
      "Reading notes"
    ],
    "features": [
      [
        "Notice what others pass",
        "Thoughtful research that starts with a closer look."
      ],
      [
        "Find the useful story",
        "Writing that gives an interesting idea a clear place to live."
      ],
      [
        "Leave room for thought",
        "A practice that values the question as much as the conclusion."
      ]
    ]
  },
  "rules": [
    "Brackets frame a thought without closing it in.",
    "Use a deliberately wide margin for notes and secondary commentary.",
    "Keep long reading text on manuscript white, with lilac as an annotation field.",
    "Manuscript hero with a lilac annotation rail and expressive serif type. Brackets frame selected ideas; a real wide margin holds secondary notes.",
    "Use the supplied artwork and SVG logos; keep glyph proportions intact.",
    "Preserve the existing project content, routes, data fetching, and interaction handlers."
  ],
  "fonts": [
    {
      "id": "instrument-serif",
      "family": "Instrument Serif",
      "path": "fonts/instrument-serif.ttf",
      "license": "fonts/instrument-serif-OFL.txt",
      "weight": "400",
      "style": "normal"
    },
    {
      "id": "work-sans",
      "family": "Work Sans",
      "path": "fonts/work-sans.ttf",
      "license": "fonts/work-sans-OFL.txt",
      "weight": "100 900",
      "style": "normal"
    },
    {
      "id": "instrument-serif-italic",
      "family": "Instrument Serif",
      "path": "fonts/instrument-serif-italic.ttf",
      "license": "fonts/instrument-serif-italic-OFL.txt",
      "weight": "400",
      "style": "italic"
    }
  ],
  "exports": [
    "mark.svg",
    "lockup.svg",
    "wordmark.svg",
    "monochrome.svg",
    "pattern.svg",
    "poster.svg",
    "social.svg",
    "avatar.svg",
    "favicon.svg",
    "artwork.svg",
    "identity-board.svg",
    "stationery.svg",
    "packaging.svg",
    "website.svg",
    "social-story.svg",
    "icon-set.svg",
    "palette.svg",
    "typography.svg",
    "business-card.svg",
    "tokens.json",
    "theme.css",
    "theme.json",
    "theme.js",
    "reference.html",
    "components.html",
    "components.tsx",
    "install-theme.mjs",
    "AI-PROMPT.md",
    "INSTALL.md",
    "guidelines.md"
  ],
  "license": {
    "artwork": "CC0-1.0",
    "code": "MIT",
    "fonts": "OFL-1.1"
  },
  "acceptance": [
    "The exact stylesheet loads without a 404.",
    "All local fonts load; there are no requests to remote font services.",
    "The root or intended subtree carries the exact data-openform attribute.",
    "The supplied display font, colors, radius, spacing, and layout family are used consistently.",
    "At 360px, 768px, and 1440px there is no horizontal page overflow.",
    "Navigation, forms, routes, and existing business behavior still work.",
    "Controls are keyboard accessible with visible focus; reduced-motion preferences are respected.",
    "The final interface follows reference.html and components.html rather than a guessed visual style."
  ]
}
