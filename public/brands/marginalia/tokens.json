{
  "$description": "Marginalia / The thoughtful annotation / Edition 02",
  "color": {
    "ink": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.23137,
          0.2,
          0.25882
        ],
        "alpha": 1
      },
      "$extensions": {
        "openform.hex": "#3B3342"
      }
    },
    "accent": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.79216,
          0.72941,
          0.87843
        ],
        "alpha": 1
      },
      "$extensions": {
        "openform.hex": "#CABAE0"
      }
    },
    "paper": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.96078,
          0.94118,
          0.90196
        ],
        "alpha": 1
      },
      "$extensions": {
        "openform.hex": "#F5F0E6"
      }
    },
    "support": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.70588,
          0.72549,
          0.60392
        ],
        "alpha": 1
      },
      "$extensions": {
        "openform.hex": "#B4B99A"
      }
    }
  },
  "typography": {
    "heading": {
      "$type": "fontFamily",
      "$value": "Instrument Serif"
    },
    "body": {
      "$type": "fontFamily",
      "$value": "Work Sans"
    },
    "headingWeight": {
      "$type": "fontWeight",
      "$value": 400
    },
    "tracking": {
      "$type": "number",
      "$value": 0,
      "$description": "Display letter spacing in em units."
    },
    "bodySize": {
      "$type": "dimension",
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "bodyLeading": {
      "$type": "number",
      "$value": 1.7
    }
  },
  "radius": {
    "$type": "dimension",
    "$value": {
      "value": 0,
      "unit": "px"
    }
  },
  "spacing": {
    "unit": {
      "$type": "dimension",
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "pageMinimum": {
      "$type": "dimension",
      "$value": {
        "value": 20,
        "unit": "px"
      }
    },
    "pageMaximum": {
      "$type": "dimension",
      "$value": {
        "value": 64,
        "unit": "px"
      }
    }
  },
  "$extensions": {
    "openform": {
      "name": "Marginalia",
      "version": "2.0.0",
      "style": "Editorial",
      "direction": "The thoughtful annotation",
      "voice": "Perceptive, personal, and quietly witty.",
      "layout": {
        "id": "margins",
        "family": "editorial",
        "mode": "paper",
        "alignment": "left",
        "maxWidthPx": 1300,
        "pageGutter": "clamp(20px, 4vw, 64px)",
        "sectionGap": "clamp(64px, 9vw, 128px)",
        "heroTextRatio": 0.57,
        "gridColumns": 3,
        "breakpoints": {
          "mobile": 640,
          "tablet": 960
        },
        "description": "Manuscript hero with a lilac annotation rail and expressive serif type. Brackets frame selected ideas; a real wide margin holds secondary notes."
      },
      "contrast": [
        {
          "foreground": "#3B3342",
          "background": "#CABAE0",
          "ratio": 6.68,
          "aaNormal": true
        },
        {
          "foreground": "#3B3342",
          "background": "#F5F0E6",
          "ratio": 10.64,
          "aaNormal": true
        }
      ]
    }
  }
}
