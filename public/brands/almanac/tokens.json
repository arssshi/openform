{
  "$description": "Almanac / The living archive / Edition 02",
  "color": {
    "ink": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.20392,
          0.29412,
          0.23137
        ],
        "alpha": 1
      },
      "$extensions": {
        "openform.hex": "#344B3B"
      }
    },
    "accent": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.72157,
          0.77255,
          0.62745
        ],
        "alpha": 1
      },
      "$extensions": {
        "openform.hex": "#B8C5A0"
      }
    },
    "paper": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.9451,
          0.92157,
          0.86667
        ],
        "alpha": 1
      },
      "$extensions": {
        "openform.hex": "#F1EBDD"
      }
    },
    "support": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.78824,
          0.72157,
          0.81176
        ],
        "alpha": 1
      },
      "$extensions": {
        "openform.hex": "#C9B8CF"
      }
    }
  },
  "typography": {
    "heading": {
      "$type": "fontFamily",
      "$value": "Playfair Display"
    },
    "body": {
      "$type": "fontFamily",
      "$value": "Karla"
    },
    "headingWeight": {
      "$type": "fontWeight",
      "$value": 500
    },
    "tracking": {
      "$type": "number",
      "$value": -0.02,
      "$description": "Display letter spacing in em units."
    },
    "bodySize": {
      "$type": "dimension",
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "bodyLeading": {
      "$type": "number",
      "$value": 1.7
    }
  },
  "radius": {
    "$type": "dimension",
    "$value": {
      "value": 0,
      "unit": "px"
    }
  },
  "spacing": {
    "unit": {
      "$type": "dimension",
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "pageMinimum": {
      "$type": "dimension",
      "$value": {
        "value": 20,
        "unit": "px"
      }
    },
    "pageMaximum": {
      "$type": "dimension",
      "$value": {
        "value": 64,
        "unit": "px"
      }
    }
  },
  "$extensions": {
    "openform": {
      "name": "Almanac",
      "version": "2.0.0",
      "style": "Editorial",
      "direction": "The living archive",
      "voice": "Inquisitive, thoughtful, and observant.",
      "layout": {
        "id": "index",
        "family": "editorial",
        "mode": "paper",
        "alignment": "left",
        "maxWidthPx": 1280,
        "pageGutter": "clamp(20px, 4vw, 64px)",
        "sectionGap": "clamp(64px, 9vw, 128px)",
        "heroTextRatio": 0.52,
        "gridColumns": 3,
        "breakpoints": {
          "mobile": 640,
          "tablet": 960
        },
        "description": "Vellum editorial hero with an open-page graphic, large serif title, running headers, and archive-green dividers. Two-column story rows on desktop, one on mobile."
      },
      "contrast": [
        {
          "foreground": "#344B3B",
          "background": "#B8C5A0",
          "ratio": 5.21,
          "aaNormal": true
        },
        {
          "foreground": "#344B3B",
          "background": "#F1EBDD",
          "ratio": 7.97,
          "aaNormal": true
        }
      ]
    }
  }
}
