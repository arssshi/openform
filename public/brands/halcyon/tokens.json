  "$extensions": {
    "openform": {
      "name": "Halcyon",
      "version": "2.0.0",
      "style": "Elegant",
      "direction": "The geometry of rest",
      "voice": "Attentive, understated, and deeply calm.",
      "layout": {
        "id": "serene",
        "family": "hospitality",
        "mode": "paper",
        "alignment": "center",
        "maxWidthPx": 1160,
        "pageGutter": "clamp(20px, 4vw, 64px)",
        "sectionGap": "clamp(64px, 9vw, 128px)",
        "heroTextRatio": 0.5,
        "gridColumns": 3,
        "breakpoints": {
          "mobile": 640,
          "tablet": 960
        },
        "description": "Stillness-white centered serif hero with an inset pool image and at least one-third open space. Fine driftwood rules and unobtrusive pill controls."
      },
      "contrast": [
        {
          "foreground": "#594B47",
          "background": "#E2C3BD",
          "ratio": 5.06,
          "aaNormal": true
        },
        {
          "foreground": "#594B47",
          "background": "#F5F0E7",
          "ratio": 7.34,
          "aaNormal": true
        }
      ]
    }
