{
  "format": "openform-theme",
  "version": "2.0.0",
  "id": "halcyon",
  "name": "Halcyon",
  "direction": "The geometry of rest",
  "concept": "Concentric pools of light, delicate layered arches, low-relief paper texture, and exceptionally spacious serif typography. The system makes a visual pause tangible.",
  "scope": {
    "attribute": "data-openform",
    "value": "halcyon",
    "selector": "[data-openform=\"halcyon\"]"
  },
  "installation": {
    "command": "node install-theme.mjs --target /path/to/your/project",
    "publicDirectory": "public",
    "destination": "themes/halcyon",
    "stylesheet": "/themes/halcyon/theme.css",
    "reference": "/themes/halcyon/reference.html",
    "components": "/themes/halcyon/components.html",
    "htmlAttribute": "data-openform=\"halcyon\""
  },
  "colors": {
    "ink": "#594B47",
    "accent": "#E2C3BD",
    "paper": "#F5F0E7",
    "support": "#AFA68B",
    "secondary": "#70645f",
    "border": "#cbc3bc",
    "heroBackground": "#F5F0E7",
    "heroForeground": "#594B47",
    "buttonBackground": "#594B47",
    "buttonForeground": "#F5F0E7"
  },
  "typography": {
    "display": {
      "family": "Instrument Serif",
      "file": "fonts/instrument-serif.ttf",
      "weight": 400,
      "trackingEm": 0.01,
      "lineHeight": 1.04,
      "desktopMaxPx": 96,
      "mobileMinPx": 38
    },
    "body": {
      "family": "Outfit",
      "file": "fonts/outfit.ttf",
      "weight": 400,
      "sizePx": 16,
      "lineHeight": 1.7
    },
    "accent": {
      "family": "Instrument Serif",
      "file": "fonts/instrument-serif-italic.ttf",
      "style": "italic"
    },
    "label": {
      "sizePx": 11,
      "trackingEm": 0.08,
      "lineHeight": 1.5
    }
  },
  "layout": {
    "id": "serene",
    "family": "hospitality",
    "mode": "paper",
    "alignment": "center",
    "maxWidthPx": 1160,
    "pageGutter": "clamp(20px, 4vw, 64px)",
    "sectionGap": "clamp(64px, 9vw, 128px)",
    "heroTextRatio": 0.5,
    "gridColumns": 3,
    "breakpoints": {
      "mobile": 640,
      "tablet": 960
    },
    "description": "Stillness-white centered serif hero with an inset pool image and at least one-third open space. Fine driftwood rules and unobtrusive pill controls."
  },
  "components": {
    "classes": {
      "root": "of-theme",
      "container": "of-container",
      "header": "of-header",
      "navigation": "of-nav",
      "mobileNavigation": "of-mobile-nav",
      "logo": "of-logo",
      "eyebrow": "of-eyebrow",
      "hero": "of-hero",
      "heroCopy": "of-hero-copy",
      "heroHeading": "of-display",
      "heroMedia": "of-hero-media",
      "heading": "of-heading",
      "body": "of-body",
      "actions": "of-actions",
      "button": "of-button",
      "secondaryButton": "of-button of-button--ghost",
      "section": "of-section",
      "sectionHeading": "of-section-heading",
      "grid": "of-grid",
      "card": "of-card",
      "cardImage": "of-card-image",
      "badge": "of-badge",
      "form": "of-form",
      "field": "of-field",
      "input": "of-input",
      "select": "of-select",
      "textarea": "of-textarea",
      "notice": "of-notice",
      "table": "of-table",
      "accordion": "of-accordion",
      "footer": "of-footer"
    },
    "radiusPx": 16,
    "cardRadiusPx": 0,
    "borderPx": 1,
    "buttonShape": "pill",
    "minimumControlHeightPx": 48,
    "inputHeightPx": 52,
    "focus": {
      "widthPx": 3,
      "offsetPx": 4,
      "color": "#594B47"
    }
  },
  "content": {
    "headline": [
      "The art of",
      "a little stillness."
    ],
    "eyebrow": "REST / RESET / RETURN",
    "cta": "Discover a quieter moment",
    "secondaryCta": "Our approach to rest",
    "nav": [
      "The experience",
      "The place",
      "Notes on rest"
    ],
    "features": [
      [
        "An unhurried beginning",
        "Thoughtful spaces that give you room to settle."
      ],
      [
        "A softer rhythm",
        "Small practices for making more room in the day."
      ],
      [
        "Return feeling present",
        "A restorative experience with no need to rush the moment."
      ]
    ]
  },
  "rules": [
    "Concentric rings share one center and a consistent stroke width.",
    "Use stillness for the majority of every canvas.",
    "Leave at least one-third of each composition free of content.",
    "Stillness-white centered serif hero with an inset pool image and at least one-third open space. Fine driftwood rules and unobtrusive pill controls.",
    "Use the supplied artwork and SVG logos; keep glyph proportions intact.",
    "Preserve the existing project content, routes, data fetching, and interaction handlers."
  ],
  "fonts": [
    {
      "id": "instrument-serif",
      "family": "Instrument Serif",
      "path": "fonts/instrument-serif.ttf",
      "license": "fonts/instrument-serif-OFL.txt",
      "weight": "400",
      "style": "normal"
    },
    {
      "id": "outfit",
      "family": "Outfit",
      "path": "fonts/outfit.ttf",
      "license": "fonts/outfit-OFL.txt",
      "weight": "100 900",
      "style": "normal"
    },
    {
      "id": "instrument-serif-italic",
      "family": "Instrument Serif",
      "path": "fonts/instrument-serif-italic.ttf",
      "license": "fonts/instrument-serif-italic-OFL.txt",
      "weight": "400",
      "style": "italic"
    }
  ],
  "exports": [
    "mark.svg",
    "lockup.svg",
    "wordmark.svg",
    "monochrome.svg",
    "pattern.svg",
    "poster.svg",
    "social.svg",
    "avatar.svg",
    "favicon.svg",
    "artwork.svg",
    "identity-board.svg",
    "stationery.svg",
    "packaging.svg",
    "website.svg",
    "social-story.svg",
    "icon-set.svg",
    "palette.svg",
    "typography.svg",
    "business-card.svg",
    "tokens.json",
    "theme.css",
    "theme.json",
    "theme.js",
    "reference.html",
    "components.html",
    "components.tsx",
    "install-theme.mjs",
    "AI-PROMPT.md",
    "INSTALL.md",
    "guidelines.md"
  ],
  "license": {
    "artwork": "CC0-1.0",
    "code": "MIT",
    "fonts": "OFL-1.1"
  },
  "acceptance": [
    "The exact stylesheet loads without a 404.",
    "All local fonts load; there are no requests to remote font services.",
    "The root or intended subtree carries the exact data-openform attribute.",
    "The supplied display font, colors, radius, spacing, and layout family are used consistently.",
    "At 360px, 768px, and 1440px there is no horizontal page overflow.",
    "Navigation, forms, routes, and existing business behavior still work.",
    "Controls are keyboard accessible with visible focus; reduced-motion preferences are respected.",
    "The final interface follows reference.html and components.html rather than a guessed visual style."
  ]
}
