  "spacing": {
    "unit": {
      "$type": "dimension",
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "pageMinimum": {
      "$type": "dimension",
      "$value": {
        "value": 20,
        "unit": "px"
      }
