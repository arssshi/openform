  },
  "$extensions": {
    "openform": {
      "name": "AUREL",
      "version": "2.0.0",
      "style": "Elegant",
      "direction": "Sunlit heritage",
      "voice": "Warm, gracious, and beautifully unhurried.",
      "layout": {
        "id": "luxury",
        "family": "hospitality",
        "mode": "paper",
        "alignment": "center",
        "maxWidthPx": 1180,
        "pageGutter": "clamp(20px, 4vw, 64px)",
        "sectionGap": "clamp(64px, 9vw, 128px)",
        "heroTextRatio": 0.5,
        "gridColumns": 3,
        "breakpoints": {
          "mobile": 640,
          "tablet": 960
        },
        "description": "Linen hero, centered high-contrast serif, a small sun seal, and a framed courtyard image. Bordeaux fine borders; gold appears as ornament, never small reading text."
      },
      "contrast": [
        {
          "foreground": "#532B39",
          "background": "#DFBB7D",
          "ratio": 6.51,
          "aaNormal": true
        },
        {
          "foreground": "#532B39",
          "background": "#F5EEE1",
          "ratio": 10.27,
          "aaNormal": true
        }
      ]
    }
  }
