{
  "format": "openform-theme",
  "version": "2.0.0",
  "id": "aurel",
  "name": "AUREL",
  "direction": "Sunlit heritage",
  "concept": "A contemporary sun medallion, engraved-looking hairlines, linen-colored stationery, and generous serif setting. The system feels like a beautifully kept personal invitation.",
  "scope": {
    "attribute": "data-openform",
    "value": "aurel",
    "selector": "[data-openform=\"aurel\"]"
  },
  "installation": {
    "command": "node install-theme.mjs --target /path/to/your/project",
    "publicDirectory": "public",
    "destination": "themes/aurel",
    "stylesheet": "/themes/aurel/theme.css",
    "reference": "/themes/aurel/reference.html",
    "components": "/themes/aurel/components.html",
    "htmlAttribute": "data-openform=\"aurel\""
  },
  "colors": {
    "ink": "#532B39",
    "accent": "#DFBB7D",
    "paper": "#F5EEE1",
    "support": "#B18483",
    "secondary": "#6b4852",
    "border": "#c9b9b4",
    "heroBackground": "#F5EEE1",
    "heroForeground": "#532B39",
    "buttonBackground": "#532B39",
    "buttonForeground": "#F5EEE1"
  },
  "typography": {
    "display": {
      "family": "Cormorant Garamond",
      "file": "fonts/cormorant.ttf",
      "weight": 500,
      "trackingEm": 0.08,
      "lineHeight": 1.04,
      "desktopMaxPx": 96,
      "mobileMinPx": 38
    },
    "body": {
      "family": "Manrope",
      "file": "fonts/manrope.ttf",
      "weight": 400,
      "sizePx": 16,
      "lineHeight": 1.7
    },
    "accent": {
      "family": "Instrument Serif",
      "file": "fonts/instrument-serif-italic.ttf",
      "style": "italic"
    },
    "label": {
      "sizePx": 11,
      "trackingEm": 0.08,
      "lineHeight": 1.5
    }
  },
  "layout": {
    "id": "luxury",
    "family": "hospitality",
    "mode": "paper",
    "alignment": "center",
    "maxWidthPx": 1180,
    "pageGutter": "clamp(20px, 4vw, 64px)",
    "sectionGap": "clamp(64px, 9vw, 128px)",
    "heroTextRatio": 0.5,
    "gridColumns": 3,
    "breakpoints": {
      "mobile": 640,
      "tablet": 960
    },
    "description": "Linen hero, centered high-contrast serif, a small sun seal, and a framed courtyard image. Bordeaux fine borders; gold appears as ornament, never small reading text."
  },
  "components": {
    "classes": {
      "root": "of-theme",
      "container": "of-container",
      "header": "of-header",
      "navigation": "of-nav",
      "mobileNavigation": "of-mobile-nav",
      "logo": "of-logo",
      "eyebrow": "of-eyebrow",
      "hero": "of-hero",
      "heroCopy": "of-hero-copy",
      "heroHeading": "of-display",
      "heroMedia": "of-hero-media",
      "heading": "of-heading",
      "body": "of-body",
      "actions": "of-actions",
      "button": "of-button",
      "secondaryButton": "of-button of-button--ghost",
      "section": "of-section",
      "sectionHeading": "of-section-heading",
      "grid": "of-grid",
      "card": "of-card",
      "cardImage": "of-card-image",
      "badge": "of-badge",
      "form": "of-form",
      "field": "of-field",
      "input": "of-input",
      "select": "of-select",
      "textarea": "of-textarea",
      "notice": "of-notice",
      "table": "of-table",
      "accordion": "of-accordion",
      "footer": "of-footer"
    },
    "radiusPx": 4,
    "cardRadiusPx": 0,
    "borderPx": 1,
    "buttonShape": "outline",
    "minimumControlHeightPx": 48,
    "inputHeightPx": 52,
    "focus": {
      "widthPx": 3,
      "offsetPx": 4,
      "color": "#532B39"
    }
  },
  "content": {
    "headline": [
      "A place to stay.",
      "A reason to linger."
    ],
    "eyebrow": "AUREL / ROOMS & SMALL PLEASURES",
    "cta": "Explore your stay",
    "secondaryCta": "The house",
    "nav": [
      "The rooms",
      "The table",
      "The house"
    ],
    "features": [
      [
        "Rooms with a rhythm",
        "Thoughtful spaces, warm materials, and time to settle in."
      ],
      [
        "A table to remember",
        "Seasonal pleasures and the simple grace of eating well."
      ],
      [
        "A sense of place",
        "Stay close to the neighborhood, and a little closer to yourself."
      ]
    ]
  },
  "rules": [
    "The sun seal sits above the wordmark, never inside it.",
    "Reserve gilded for ornaments and spacious surfaces; use bordeaux for body text.",
    "Pair large serif headings with very small, tracked sans-serif labels.",
    "Linen hero, centered high-contrast serif, a small sun seal, and a framed courtyard image. Bordeaux fine borders; gold appears as ornament, never small reading text.",
    "Use the supplied artwork and SVG logos; keep glyph proportions intact.",
    "Preserve the existing project content, routes, data fetching, and interaction handlers."
  ],
  "fonts": [
    {
      "id": "cormorant",
      "family": "Cormorant Garamond",
      "path": "fonts/cormorant.ttf",
      "license": "fonts/cormorant-OFL.txt",
      "weight": "300 700",
      "style": "normal"
    },
    {
      "id": "manrope",
      "family": "Manrope",
      "path": "fonts/manrope.ttf",
      "license": "fonts/manrope-OFL.txt",
      "weight": "200 800",
      "style": "normal"
    },
    {
      "id": "instrument-serif-italic",
      "family": "Instrument Serif",
      "path": "fonts/instrument-serif-italic.ttf",
      "license": "fonts/instrument-serif-italic-OFL.txt",
      "weight": "400",
      "style": "italic"
    }
  ],
  "exports": [
    "mark.svg",
    "lockup.svg",
    "wordmark.svg",
    "monochrome.svg",
    "pattern.svg",
    "poster.svg",
    "social.svg",
    "avatar.svg",
    "favicon.svg",
    "artwork.svg",
    "identity-board.svg",
    "stationery.svg",
    "packaging.svg",
    "website.svg",
    "social-story.svg",
    "icon-set.svg",
    "palette.svg",
    "typography.svg",
    "business-card.svg",
    "tokens.json",
    "theme.css",
    "theme.json",
    "theme.js",
    "reference.html",
    "components.html",
    "components.tsx",
    "install-theme.mjs",
    "AI-PROMPT.md",
    "INSTALL.md",
    "guidelines.md"
  ],
  "license": {
    "artwork": "CC0-1.0",
    "code": "MIT",
    "fonts": "OFL-1.1"
  },
  "acceptance": [
    "The exact stylesheet loads without a 404.",
    "All local fonts load; there are no requests to remote font services.",
    "The root or intended subtree carries the exact data-openform attribute.",
    "The supplied display font, colors, radius, spacing, and layout family are used consistently.",
    "At 360px, 768px, and 1440px there is no horizontal page overflow.",
    "Navigation, forms, routes, and existing business behavior still work.",
    "Controls are keyboard accessible with visible focus; reduced-motion preferences are respected.",
    "The final interface follows reference.html and components.html rather than a guessed visual style."
  ]
}
