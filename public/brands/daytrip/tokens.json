  "$extensions": {
    "openform": {
      "name": "Daytrip",
      "version": "2.0.0",
      "style": "Retro",
      "direction": "The nearby adventure",
      "voice": "Upbeat, curious, and pleasantly practical.",
      "layout": {
        "id": "ticket",
        "family": "retro",
        "mode": "accent",
        "alignment": "center",
        "maxWidthPx": 1260,
        "pageGutter": "clamp(20px, 4vw, 64px)",
        "sectionGap": "clamp(64px, 9vw, 128px)",
        "heroTextRatio": 0.5,
        "gridColumns": 3,
        "breakpoints": {
          "mobile": 640,
          "tablet": 960
        },
        "description": "Sunlit centered hero with a postcard landscape and road-sign typography. Ticket-like borders, coral route chips, and plainly organized itinerary cards."
      },
      "contrast": [
        {
          "foreground": "#394E55",
          "background": "#EAC669",
          "ratio": 5.34,
          "aaNormal": true
        },
        {
          "foreground": "#394E55",
          "background": "#F8EFD9",
          "ratio": 7.66,
          "aaNormal": true
        }
      ]
    }
  }
