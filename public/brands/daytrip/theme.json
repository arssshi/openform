{
  "format": "openform-theme",
  "version": "2.0.0",
  "id": "daytrip",
  "name": "Daytrip",
  "direction": "The nearby adventure",
  "concept": "Mid-century map postcards, compass-cut sun shapes, warm destination tickets, and generously curved serif type. A familiar place becomes a fresh little journey.",
  "scope": {
    "attribute": "data-openform",
    "value": "daytrip",
    "selector": "[data-openform=\"daytrip\"]"
  },
  "installation": {
    "command": "node install-theme.mjs --target /path/to/your/project",
    "publicDirectory": "public",
    "destination": "themes/daytrip",
    "stylesheet": "/themes/daytrip/theme.css",
    "reference": "/themes/daytrip/reference.html",
    "components": "/themes/daytrip/components.html",
    "htmlAttribute": "data-openform=\"daytrip\""
  },
  "colors": {
    "ink": "#394E55",
    "accent": "#EAC669",
    "paper": "#F8EFD9",
    "support": "#D78A6A",
    "secondary": "#566669",
    "border": "#c4c4b5",
    "heroBackground": "#EAC669",
    "heroForeground": "#394E55",
    "buttonBackground": "#394E55",
    "buttonForeground": "#F8EFD9"
  },
  "typography": {
    "display": {
      "family": "Fraunces",
      "file": "fonts/fraunces.ttf",
      "weight": 600,
      "trackingEm": -0.03,
      "lineHeight": 1.02,
      "desktopMaxPx": 96,
      "mobileMinPx": 38
    },
    "body": {
      "family": "Urbanist",
      "file": "fonts/urbanist.ttf",
      "weight": 400,
      "sizePx": 16,
      "lineHeight": 1.7
    },
    "accent": {
      "family": "Fraunces",
      "file": "fonts/fraunces.ttf",
      "style": "normal"
    },
    "label": {
      "sizePx": 11,
      "trackingEm": 0.08,
      "lineHeight": 1.5
    }
  },
  "layout": {
    "id": "ticket",
    "family": "retro",
    "mode": "accent",
    "alignment": "center",
    "maxWidthPx": 1260,
    "pageGutter": "clamp(20px, 4vw, 64px)",
    "sectionGap": "clamp(64px, 9vw, 128px)",
    "heroTextRatio": 0.5,
    "gridColumns": 3,
    "breakpoints": {
      "mobile": 640,
      "tablet": 960
    },
    "description": "Sunlit centered hero with a postcard landscape and road-sign typography. Ticket-like borders, coral route chips, and plainly organized itinerary cards."
  },
  "components": {
    "classes": {
      "root": "of-theme",
      "container": "of-container",
      "header": "of-header",
      "navigation": "of-nav",
      "mobileNavigation": "of-mobile-nav",
      "logo": "of-logo",
      "eyebrow": "of-eyebrow",
      "hero": "of-hero",
      "heroCopy": "of-hero-copy",
      "heroHeading": "of-display",
      "heroMedia": "of-hero-media",
      "heading": "of-heading",
      "body": "of-body",
      "actions": "of-actions",
      "button": "of-button",
      "secondaryButton": "of-button of-button--ghost",
      "section": "of-section",
      "sectionHeading": "of-section-heading",
      "grid": "of-grid",
      "card": "of-card",
      "cardImage": "of-card-image",
      "badge": "of-badge",
      "form": "of-form",
      "field": "of-field",
      "input": "of-input",
      "select": "of-select",
      "textarea": "of-textarea",
      "notice": "of-notice",
      "table": "of-table",
      "accordion": "of-accordion",
      "footer": "of-footer"
    },
    "radiusPx": 16,
    "cardRadiusPx": 0,
    "borderPx": 1,
    "buttonShape": "pill",
    "minimumControlHeightPx": 48,
    "inputHeightPx": 52,
    "focus": {
      "widthPx": 3,
      "offsetPx": 4,
      "color": "#394E55"
    }
  },
  "content": {
    "headline": [
      "Go somewhere.",
      "Make a day of it."
    ],
    "eyebrow": "NEARBY ADVENTURES / A GOOD WAY TO GO",
    "cta": "Find your daytrip",
    "secondaryCta": "Read the local notes",
    "nav": [
      "The daytrips",
      "Local notes",
      "Our scenic approach"
    ],
    "features": [
      [
        "Start nearby",
        "Thoughtful guides to the places just beyond the usual route."
      ],
      [
        "Take your time",
        "A more curious way to make a day feel different."
      ],
      [
        "Keep a good note",
        "Useful details and small observations worth bringing along."
      ]
    ]
  },
  "rules": [
    "Compass points align vertically even when the surrounding badge rotates.",
    "Use ticket-style borders with route information in a distinct lower strip.",
    "Place sunshine behind short display headlines, not long itineraries.",
    "Sunlit centered hero with a postcard landscape and road-sign typography. Ticket-like borders, coral route chips, and plainly organized itinerary cards.",
    "Use the supplied artwork and SVG logos; keep glyph proportions intact.",
    "Preserve the existing project content, routes, data fetching, and interaction handlers."
  ],
  "fonts": [
    {
      "id": "fraunces",
      "family": "Fraunces",
      "path": "fonts/fraunces.ttf",
      "license": "fonts/fraunces-OFL.txt",
      "weight": "100 900",
      "style": "normal"
    },
    {
      "id": "urbanist",
      "family": "Urbanist",
      "path": "fonts/urbanist.ttf",
      "license": "fonts/urbanist-OFL.txt",
      "weight": "100 900",
      "style": "normal"
    }
  ],
  "exports": [
    "mark.svg",
    "lockup.svg",
    "wordmark.svg",
    "monochrome.svg",
    "pattern.svg",
    "poster.svg",
    "social.svg",
    "avatar.svg",
    "favicon.svg",
    "artwork.svg",
    "identity-board.svg",
    "stationery.svg",
    "packaging.svg",
    "website.svg",
    "social-story.svg",
    "icon-set.svg",
    "palette.svg",
    "typography.svg",
    "business-card.svg",
    "tokens.json",
    "theme.css",
    "theme.json",
    "theme.js",
    "reference.html",
    "components.html",
    "components.tsx",
    "install-theme.mjs",
    "AI-PROMPT.md",
    "INSTALL.md",
    "guidelines.md"
  ],
  "license": {
    "artwork": "CC0-1.0",
    "code": "MIT",
    "fonts": "OFL-1.1"
  },
  "acceptance": [
    "The exact stylesheet loads without a 404.",
    "All local fonts load; there are no requests to remote font services.",
    "The root or intended subtree carries the exact data-openform attribute.",
    "The supplied display font, colors, radius, spacing, and layout family are used consistently.",
    "At 360px, 768px, and 1440px there is no horizontal page overflow.",
    "Navigation, forms, routes, and existing business behavior still work.",
    "Controls are keyboard accessible with visible focus; reduced-motion preferences are respected.",
    "The final interface follows reference.html and components.html rather than a guessed visual style."
  ]
}
