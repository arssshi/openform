{
  "format": "openform-theme",
  "version": "2.0.0",
  "id": "juno",
  "name": "juno",
  "direction": "Many-sided expression",
  "concept": "Asymmetric color orbs, editorial cutouts, highly rounded lettering, and accessories-as-sculpture. Confident complementary blocks celebrate the many versions of you.",
  "scope": {
    "attribute": "data-openform",
    "value": "juno",
    "selector": "[data-openform=\"juno\"]"
  },
  "installation": {
    "command": "node install-theme.mjs --target /path/to/your/project",
    "publicDirectory": "public",
    "destination": "themes/juno",
    "stylesheet": "/themes/juno/theme.css",
    "reference": "/themes/juno/reference.html",
    "components": "/themes/juno/components.html",
    "htmlAttribute": "data-openform=\"juno\""
  },
  "colors": {
    "ink": "#55358D",
    "accent": "#C7DB73",
    "paper": "#FAF1DB",
    "support": "#D69CBD",
    "secondary": "#6e5199",
    "border": "#cdbec6",
    "heroBackground": "#55358D",
    "heroForeground": "#FAF1DB",
    "buttonBackground": "#C7DB73",
    "buttonForeground": "#55358D"
  },
  "typography": {
    "display": {
      "family": "Outfit",
      "file": "fonts/outfit.ttf",
      "weight": 800,
      "trackingEm": -0.05,
      "lineHeight": 1.02,
      "desktopMaxPx": 96,
      "mobileMinPx": 38
    },
    "body": {
      "family": "Karla",
      "file": "fonts/karla.ttf",
      "weight": 400,
      "sizePx": 16,
      "lineHeight": 1.7
    },
    "accent": {
      "family": "Bricolage Grotesque",
      "file": "fonts/bricolage.ttf",
      "style": "normal"
    },
    "label": {
      "sizePx": 11,
      "trackingEm": 0.08,
      "lineHeight": 1.5
    }
  },
  "layout": {
    "id": "dots",
    "family": "playful",
    "mode": "dark",
    "alignment": "left",
    "maxWidthPx": 1260,
    "pageGutter": "clamp(20px, 4vw, 64px)",
    "sectionGap": "clamp(64px, 9vw, 128px)",
    "heroTextRatio": 0.5,
    "gridColumns": 3,
    "breakpoints": {
      "mobile": 640,
      "tablet": 960
    },
    "description": "Violet split hero with limeade display type and a large constellation of differently scaled orbs. Alternate hard color blocks with round product frames."
  },
  "components": {
    "classes": {
      "root": "of-theme",
      "container": "of-container",
      "header": "of-header",
      "navigation": "of-nav",
      "mobileNavigation": "of-mobile-nav",
      "logo": "of-logo",
      "eyebrow": "of-eyebrow",
      "hero": "of-hero",
      "heroCopy": "of-hero-copy",
      "heroHeading": "of-display",
      "heroMedia": "of-hero-media",
      "heading": "of-heading",
      "body": "of-body",
      "actions": "of-actions",
      "button": "of-button",
      "secondaryButton": "of-button of-button--ghost",
      "section": "of-section",
      "sectionHeading": "of-section-heading",
      "grid": "of-grid",
      "card": "of-card",
      "cardImage": "of-card-image",
      "badge": "of-badge",
      "form": "of-form",
      "field": "of-field",
      "input": "of-input",
      "select": "of-select",
      "textarea": "of-textarea",
      "notice": "of-notice",
      "table": "of-table",
      "accordion": "of-accordion",
      "footer": "of-footer"
    },
    "radiusPx": 24,
    "cardRadiusPx": 0,
    "borderPx": 1,
    "buttonShape": "pill",
    "minimumControlHeightPx": 48,
    "inputHeightPx": 52,
    "focus": {
      "widthPx": 3,
      "offsetPx": 4,
      "color": "#55358D"
    }
  },
  "content": {
    "headline": [
      "Every side",
      "is your good side."
    ],
    "eyebrow": "OBJECTS FOR SELF-EXPRESSION",
    "cta": "Find your side",
    "secondaryCta": "Meet the collection",
    "nav": [
      "The collection",
      "Your many sides",
      "Notes"
    ],
    "features": [
      [
        "Mix it your way",
        "A little collection with a lot of possible combinations."
      ],
      [
        "Express more",
        "Objects chosen for how they make your world feel."
      ],
      [
        "No single version",
        "Room for the changing, interesting person you already are."
      ]
    ]
  },
  "rules": [
    "Keep the dot cluster asymmetrical rather than arranging it in a square.",
    "Let violet and limeade meet at hard-edged background divisions.",
    "Use oversized lowercase words and short, friendly supporting lines.",
    "Violet split hero with limeade display type and a large constellation of differently scaled orbs. Alternate hard color blocks with round product frames.",
    "Use the supplied artwork and SVG logos; keep glyph proportions intact.",
    "Preserve the existing project content, routes, data fetching, and interaction handlers."
  ],
  "fonts": [
    {
      "id": "outfit",
      "family": "Outfit",
      "path": "fonts/outfit.ttf",
      "license": "fonts/outfit-OFL.txt",
      "weight": "100 900",
      "style": "normal"
    },
    {
      "id": "karla",
      "family": "Karla",
      "path": "fonts/karla.ttf",
      "license": "fonts/karla-OFL.txt",
      "weight": "200 800",
      "style": "normal"
    },
    {
      "id": "bricolage",
      "family": "Bricolage Grotesque",
      "path": "fonts/bricolage.ttf",
      "license": "fonts/bricolage-OFL.txt",
      "weight": "200 800",
      "style": "normal"
    }
  ],
  "exports": [
    "mark.svg",
    "lockup.svg",
    "wordmark.svg",
    "monochrome.svg",
    "pattern.svg",
    "poster.svg",
    "social.svg",
    "avatar.svg",
    "favicon.svg",
    "artwork.svg",
    "identity-board.svg",
    "stationery.svg",
    "packaging.svg",
    "website.svg",
    "social-story.svg",
    "icon-set.svg",
    "palette.svg",
    "typography.svg",
    "business-card.svg",
    "tokens.json",
    "theme.css",
    "theme.json",
    "theme.js",
    "reference.html",
    "components.html",
    "components.tsx",
    "install-theme.mjs",
    "AI-PROMPT.md",
    "INSTALL.md",
    "guidelines.md"
  ],
  "license": {
    "artwork": "CC0-1.0",
    "code": "MIT",
    "fonts": "OFL-1.1"
  },
  "acceptance": [
    "The exact stylesheet loads without a 404.",
    "All local fonts load; there are no requests to remote font services.",
    "The root or intended subtree carries the exact data-openform attribute.",
    "The supplied display font, colors, radius, spacing, and layout family are used consistently.",
    "At 360px, 768px, and 1440px there is no horizontal page overflow.",
    "Navigation, forms, routes, and existing business behavior still work.",
    "Controls are keyboard accessible with visible focus; reduced-motion preferences are respected.",
    "The final interface follows reference.html and components.html rather than a guessed visual style."
  ]
}
