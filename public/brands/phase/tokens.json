{
  "$description": "PHASE / The transition toolkit / Edition 02",
  "color": {
    "ink": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.12549,
          0.21961,
          0.22745
        ],
        "alpha": 1
      },
      "$extensions": {
        "openform.hex": "#20383A"
      }
    },
    "accent": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.50196,
          0.91373,
          0.81569
        ],
        "alpha": 1
      },
      "$extensions": {
        "openform.hex": "#80E9D0"
      }
    },
    "paper": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.92941,
          0.95686,
          0.92549
        ],
        "alpha": 1
      },
      "$extensions": {
        "openform.hex": "#EDF4EC"
      }
    },
    "support": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.71373,
          0.7098,
          0.8902
        ],
        "alpha": 1
      },
      "$extensions": {
        "openform.hex": "#B6B5E3"
      }
    }
  },
  "typography": {
    "heading": {
      "$type": "fontFamily",
      "$value": "Syne"
    },
    "body": {
      "$type": "fontFamily",
      "$value": "DM Mono"
    },
    "headingWeight": {
      "$type": "fontWeight",
      "$value": 700
    },
    "tracking": {
      "$type": "number",
      "$value": 0.02,
      "$description": "Display letter spacing in em units."
    },
    "bodySize": {
      "$type": "dimension",
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "bodyLeading": {
      "$type": "number",
      "$value": 1.7
    }
  },
  "radius": {
    "$type": "dimension",
    "$value": {
      "value": 4,
      "unit": "px"
    }
  },
  "spacing": {
    "unit": {
      "$type": "dimension",
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "pageMinimum": {
      "$type": "dimension",
      "$value": {
        "value": 20,
        "unit": "px"
      }
    },
    "pageMaximum": {
      "$type": "dimension",
      "$value": {
        "value": 64,
        "unit": "px"
      }
    }
  },
  "$extensions": {
    "openform": {
      "name": "PHASE",
      "version": "2.0.0",
      "style": "Futuristic",
      "direction": "The transition toolkit",
      "voice": "Progressive, incisive, and enabling.",
      "layout": {
        "id": "diagonal",
        "family": "terminal",
        "mode": "dark",
        "alignment": "left",
        "maxWidthPx": 1380,
        "pageGutter": "clamp(20px, 4vw, 64px)",
        "sectionGap": "clamp(64px, 9vw, 128px)",
        "heroTextRatio": 0.55,
        "gridColumns": 3,
        "breakpoints": {
          "mobile": 640,
          "tablet": 960
        },
        "description": "Dark-mode hero, ion-colored typography, and diagonal folded art. Straight 4px UI corners, mono labels, and a single mint action color. Keep reading panels flat."
      },
      "contrast": [
        {
          "foreground": "#20383A",
          "background": "#80E9D0",
          "ratio": 8.58,
          "aaNormal": true
        },
        {
          "foreground": "#20383A",
          "background": "#EDF4EC",
          "ratio": 11.11,
          "aaNormal": true
        }
      ]
    }
  }
}
