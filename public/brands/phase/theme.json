{
  "format": "openform-theme",
  "version": "2.0.0",
  "id": "phase",
  "name": "PHASE",
  "direction": "The transition toolkit",
  "concept": "Slashed planes, folded technical ribbons, progression diagrams, and a sharp sea-green terminal palette. Progress has a visible direction and a clear structure.",
  "scope": {
    "attribute": "data-openform",
    "value": "phase",
    "selector": "[data-openform=\"phase\"]"
  },
  "installation": {
    "command": "node install-theme.mjs --target /path/to/your/project",
    "publicDirectory": "public",
    "destination": "themes/phase",
    "stylesheet": "/themes/phase/theme.css",
    "reference": "/themes/phase/reference.html",
    "components": "/themes/phase/components.html",
    "htmlAttribute": "data-openform=\"phase\""
  },
  "colors": {
    "ink": "#20383A",
    "accent": "#80E9D0",
    "paper": "#EDF4EC",
    "support": "#B6B5E3",
    "secondary": "#3f5455",
    "border": "#b6c1bc",
    "heroBackground": "#20383A",
    "heroForeground": "#EDF4EC",
    "buttonBackground": "#80E9D0",
    "buttonForeground": "#20383A"
  },
  "typography": {
    "display": {
      "family": "Syne",
      "file": "fonts/syne.ttf",
      "weight": 700,
      "trackingEm": 0.02,
      "lineHeight": 1.02,
      "desktopMaxPx": 96,
      "mobileMinPx": 38
    },
    "body": {
      "family": "DM Mono",
      "file": "fonts/dm-mono.ttf",
      "weight": 400,
      "sizePx": 16,
      "lineHeight": 1.7
    },
    "accent": {
      "family": "DM Mono",
      "file": "fonts/dm-mono.ttf",
      "style": "normal"
    },
    "label": {
      "sizePx": 11,
      "trackingEm": 0.08,
      "lineHeight": 1.5
    }
  },
  "layout": {
    "id": "diagonal",
    "family": "terminal",
    "mode": "dark",
    "alignment": "left",
    "maxWidthPx": 1380,
    "pageGutter": "clamp(20px, 4vw, 64px)",
    "sectionGap": "clamp(64px, 9vw, 128px)",
    "heroTextRatio": 0.55,
    "gridColumns": 3,
    "breakpoints": {
      "mobile": 640,
      "tablet": 960
    },
    "description": "Dark-mode hero, ion-colored typography, and diagonal folded art. Straight 4px UI corners, mono labels, and a single mint action color. Keep reading panels flat."
  },
  "components": {
    "classes": {
      "root": "of-theme",
      "container": "of-container",
      "header": "of-header",
      "navigation": "of-nav",
      "mobileNavigation": "of-mobile-nav",
      "logo": "of-logo",
      "eyebrow": "of-eyebrow",
      "hero": "of-hero",
      "heroCopy": "of-hero-copy",
      "heroHeading": "of-display",
      "heroMedia": "of-hero-media",
      "heading": "of-heading",
      "body": "of-body",
      "actions": "of-actions",
      "button": "of-button",
      "secondaryButton": "of-button of-button--ghost",
      "section": "of-section",
      "sectionHeading": "of-section-heading",
      "grid": "of-grid",
      "card": "of-card",
      "cardImage": "of-card-image",
      "badge": "of-badge",
      "form": "of-form",
      "field": "of-field",
      "input": "of-input",
      "select": "of-select",
      "textarea": "of-textarea",
      "notice": "of-notice",
      "table": "of-table",
      "accordion": "of-accordion",
      "footer": "of-footer"
    },
    "radiusPx": 4,
    "cardRadiusPx": 0,
    "borderPx": 1,
    "buttonShape": "square",
    "minimumControlHeightPx": 48,
    "inputHeightPx": 52,
    "focus": {
      "widthPx": 3,
      "offsetPx": 4,
      "color": "#20383A"
    }
  },
  "content": {
    "headline": [
      "What comes next",
      "starts with a phase."
    ],
    "eyebrow": "AN OPEN TOOLKIT FOR THE NEXT VERSION",
    "cta": "Explore the toolkit",
    "secondaryCta": "Read the principles",
    "nav": [
      "Toolkit",
      "Documentation",
      "Principles"
    ],
    "features": [
      [
        "A clear transition",
        "A practical structure for getting from an idea to its next version."
      ],
      [
        "Tools with purpose",
        "Useful primitives and fewer unnecessary choices."
      ],
      [
        "Keep building",
        "A foundation that supports iteration rather than getting in its way."
      ]
    ]
  },
  "rules": [
    "Diagonal shapes share a 35-degree angle.",
    "Use dark mode as the dominant developer-facing background.",
    "Highlight a single transition with ion instead of adding gradients.",
    "Dark-mode hero, ion-colored typography, and diagonal folded art. Straight 4px UI corners, mono labels, and a single mint action color. Keep reading panels flat.",
    "Use the supplied artwork and SVG logos; keep glyph proportions intact.",
    "Preserve the existing project content, routes, data fetching, and interaction handlers."
  ],
  "fonts": [
    {
      "id": "syne",
      "family": "Syne",
      "path": "fonts/syne.ttf",
      "license": "fonts/syne-OFL.txt",
      "weight": "400 800",
      "style": "normal"
    },
    {
      "id": "dm-mono",
      "family": "DM Mono",
      "path": "fonts/dm-mono.ttf",
      "license": "fonts/dm-mono-OFL.txt",
      "weight": "400",
      "style": "normal"
    }
  ],
  "exports": [
    "mark.svg",
    "lockup.svg",
    "wordmark.svg",
    "monochrome.svg",
    "pattern.svg",
    "poster.svg",
    "social.svg",
    "avatar.svg",
    "favicon.svg",
    "artwork.svg",
    "identity-board.svg",
    "stationery.svg",
    "packaging.svg",
    "website.svg",
    "social-story.svg",
    "icon-set.svg",
    "palette.svg",
    "typography.svg",
    "business-card.svg",
    "tokens.json",
    "theme.css",
    "theme.json",
    "theme.js",
    "reference.html",
    "components.html",
    "components.tsx",
    "install-theme.mjs",
    "AI-PROMPT.md",
    "INSTALL.md",
    "guidelines.md"
  ],
  "license": {
    "artwork": "CC0-1.0",
    "code": "MIT",
    "fonts": "OFL-1.1"
  },
  "acceptance": [
    "The exact stylesheet loads without a 404.",
    "All local fonts load; there are no requests to remote font services.",
    "The root or intended subtree carries the exact data-openform attribute.",
    "The supplied display font, colors, radius, spacing, and layout family are used consistently.",
    "At 360px, 768px, and 1440px there is no horizontal page overflow.",
    "Navigation, forms, routes, and existing business behavior still work.",
    "Controls are keyboard accessible with visible focus; reduced-motion preferences are respected.",
    "The final interface follows reference.html and components.html rather than a guessed visual style."
  ]
}
