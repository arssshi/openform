  "$extensions": {
    "openform": {
      "name": "Elsewhere",
      "version": "2.0.0",
      "style": "Editorial",
      "direction": "The considered journey",
      "voice": "Observant, transportive, and open-minded.",
      "layout": {
        "id": "postcard",
        "family": "editorial",
        "mode": "paper",
        "alignment": "left",
        "maxWidthPx": 1340,
        "pageGutter": "clamp(20px, 4vw, 64px)",
        "sectionGap": "clamp(64px, 9vw, 128px)",
        "heroTextRatio": 0.45,
        "gridColumns": 3,
        "breakpoints": {
          "mobile": 640,
          "tablet": 960
        },
        "description": "Warm postcard hero with oversized expressive serif and a framed persimmon portal. Use running location captions, inset imagery, and a calm left-aligned reading rhythm."
      },
      "contrast": [
        {
          "foreground": "#51405D",
          "background": "#F2BC96",
          "ratio": 5.54,
          "aaNormal": true
        },
        {
          "foreground": "#51405D",
          "background": "#FAF2DF",
          "ratio": 8.4,
          "aaNormal": true
        }
      ]
    }
