{
  "format": "openform-theme",
  "version": "2.0.0",
  "id": "elsewhere",
  "name": "Elsewhere",
  "direction": "The considered journey",
  "concept": "Surreal doorways into layered landscapes, postcard framing, beautifully oversized reading serifs, and destination-like color blocks. Travel as a point of view.",
  "scope": {
    "attribute": "data-openform",
    "value": "elsewhere",
    "selector": "[data-openform=\"elsewhere\"]"
  },
  "installation": {
    "command": "node install-theme.mjs --target /path/to/your/project",
    "publicDirectory": "public",
    "destination": "themes/elsewhere",
    "stylesheet": "/themes/elsewhere/theme.css",
    "reference": "/themes/elsewhere/reference.html",
    "components": "/themes/elsewhere/components.html",
    "htmlAttribute": "data-openform=\"elsewhere\""
  },
  "colors": {
    "ink": "#51405D",
    "accent": "#F2BC96",
    "paper": "#FAF2DF",
    "support": "#C5C7E2",
    "secondary": "#6a5b71",
    "border": "#ccc2bc",
    "heroBackground": "#FAF2DF",
    "heroForeground": "#51405D",
    "buttonBackground": "#51405D",
    "buttonForeground": "#FAF2DF"
  },
  "typography": {
    "display": {
      "family": "Instrument Serif",
      "file": "fonts/instrument-serif.ttf",
      "weight": 400,
      "trackingEm": -0.02,
      "lineHeight": 1.02,
      "desktopMaxPx": 96,
      "mobileMinPx": 38
    },
    "body": {
      "family": "Manrope",
      "file": "fonts/manrope.ttf",
      "weight": 400,
      "sizePx": 16,
      "lineHeight": 1.7
    },
    "accent": {
      "family": "Instrument Serif",
      "file": "fonts/instrument-serif-italic.ttf",
      "style": "italic"
    },
    "label": {
      "sizePx": 11,
      "trackingEm": 0.08,
      "lineHeight": 1.5
    }
  },
  "layout": {
    "id": "postcard",
    "family": "editorial",
    "mode": "paper",
    "alignment": "left",
    "maxWidthPx": 1340,
    "pageGutter": "clamp(20px, 4vw, 64px)",
    "sectionGap": "clamp(64px, 9vw, 128px)",
    "heroTextRatio": 0.45,
    "gridColumns": 3,
    "breakpoints": {
      "mobile": 640,
      "tablet": 960
    },
    "description": "Warm postcard hero with oversized expressive serif and a framed persimmon portal. Use running location captions, inset imagery, and a calm left-aligned reading rhythm."
  },
  "components": {
    "classes": {
      "root": "of-theme",
      "container": "of-container",
      "header": "of-header",
      "navigation": "of-nav",
      "mobileNavigation": "of-mobile-nav",
      "logo": "of-logo",
      "eyebrow": "of-eyebrow",
      "hero": "of-hero",
      "heroCopy": "of-hero-copy",
      "heroHeading": "of-display",
      "heroMedia": "of-hero-media",
      "heading": "of-heading",
      "body": "of-body",
      "actions": "of-actions",
      "button": "of-button",
      "secondaryButton": "of-button of-button--ghost",
      "section": "of-section",
      "sectionHeading": "of-section-heading",
      "grid": "of-grid",
      "card": "of-card",
      "cardImage": "of-card-image",
      "badge": "of-badge",
      "form": "of-form",
      "field": "of-field",
      "input": "of-input",
      "select": "of-select",
      "textarea": "of-textarea",
      "notice": "of-notice",
      "table": "of-table",
      "accordion": "of-accordion",
      "footer": "of-footer"
    },
    "radiusPx": 0,
    "cardRadiusPx": 0,
    "borderPx": 1,
    "buttonShape": "outline",
    "minimumControlHeightPx": 48,
    "inputHeightPx": 52,
    "focus": {
      "widthPx": 3,
      "offsetPx": 4,
      "color": "#51405D"
    }
  },
  "content": {
    "headline": [
      "There is another",
      "way to be away."
    ],
    "eyebrow": "JOURNEYS WITH A POINT OF VIEW",
    "cta": "Find your elsewhere",
    "secondaryCta": "Read the travel notes",
    "nav": [
      "Journeys",
      "Field notes",
      "Our point of view"
    ],
    "features": [
      [
        "The scenic approach",
        "A journey shaped by curiosity rather than a checklist."
      ],
      [
        "Places with a story",
        "Thoughtful notes on what makes somewhere feel different."
      ],
      [
        "Time to notice",
        "More room for the moments between the destinations."
      ]
    ]
  },
  "rules": [
    "The doorway is a window, so leave its center visually open.",
    "Frame photography with a generous postcard border.",
    "Use large serif headlines and small, uppercase location captions.",
    "Warm postcard hero with oversized expressive serif and a framed persimmon portal. Use running location captions, inset imagery, and a calm left-aligned reading rhythm.",
    "Use the supplied artwork and SVG logos; keep glyph proportions intact.",
    "Preserve the existing project content, routes, data fetching, and interaction handlers."
  ],
  "fonts": [
    {
      "id": "instrument-serif",
      "family": "Instrument Serif",
      "path": "fonts/instrument-serif.ttf",
      "license": "fonts/instrument-serif-OFL.txt",
      "weight": "400",
      "style": "normal"
    },
    {
      "id": "manrope",
      "family": "Manrope",
      "path": "fonts/manrope.ttf",
      "license": "fonts/manrope-OFL.txt",
      "weight": "200 800",
      "style": "normal"
    },
    {
      "id": "instrument-serif-italic",
      "family": "Instrument Serif",
      "path": "fonts/instrument-serif-italic.ttf",
      "license": "fonts/instrument-serif-italic-OFL.txt",
      "weight": "400",
      "style": "italic"
    }
  ],
  "exports": [
    "mark.svg",
    "lockup.svg",
    "wordmark.svg",
    "monochrome.svg",
    "pattern.svg",
    "poster.svg",
    "social.svg",
    "avatar.svg",
    "favicon.svg",
    "artwork.svg",
    "identity-board.svg",
    "stationery.svg",
    "packaging.svg",
    "website.svg",
    "social-story.svg",
    "icon-set.svg",
    "palette.svg",
    "typography.svg",
    "business-card.svg",
    "tokens.json",
    "theme.css",
    "theme.json",
    "theme.js",
    "reference.html",
    "components.html",
    "components.tsx",
    "install-theme.mjs",
    "AI-PROMPT.md",
    "INSTALL.md",
    "guidelines.md"
  ],
  "license": {
    "artwork": "CC0-1.0",
    "code": "MIT",
    "fonts": "OFL-1.1"
  },
  "acceptance": [
    "The exact stylesheet loads without a 404.",
    "All local fonts load; there are no requests to remote font services.",
    "The root or intended subtree carries the exact data-openform attribute.",
    "The supplied display font, colors, radius, spacing, and layout family are used consistently.",
    "At 360px, 768px, and 1440px there is no horizontal page overflow.",
    "Navigation, forms, routes, and existing business behavior still work.",
    "Controls are keyboard accessible with visible focus; reduced-motion preferences are respected.",
    "The final interface follows reference.html and components.html rather than a guessed visual style."
  ]
}
