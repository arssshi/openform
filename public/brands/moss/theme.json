{
  "format": "openform-theme",
  "version": "2.0.0",
  "id": "moss",
  "name": "moss",
  "direction": "Botanical modernism",
  "concept": "Sculptural herbarium silhouettes, apothecary labels, and expansive forest-green fields. The warmth comes from material, not decorative clutter.",
  "scope": {
    "attribute": "data-openform",
    "value": "moss",
    "selector": "[data-openform=\"moss\"]"
  },
  "installation": {
    "command": "node install-theme.mjs --target /path/to/your/project",
    "publicDirectory": "public",
    "destination": "themes/moss",
    "stylesheet": "/themes/moss/theme.css",
    "reference": "/themes/moss/reference.html",
    "components": "/themes/moss/components.html",
    "htmlAttribute": "data-openform=\"moss\""
  },
  "colors": {
    "ink": "#153E35",
    "accent": "#D5E8A0",
    "paper": "#F3F0DF",
    "support": "#A7B8A0",
    "secondary": "#36594f",
    "border": "#b7c0b1",
    "heroBackground": "#153E35",
    "heroForeground": "#F3F0DF",
    "buttonBackground": "#D5E8A0",
    "buttonForeground": "#153E35"
  },
  "typography": {
    "display": {
      "family": "Manrope",
      "file": "fonts/manrope.ttf",
      "weight": 600,
      "trackingEm": -0.05,
      "lineHeight": 1.02,
      "desktopMaxPx": 96,
      "mobileMinPx": 38
    },
    "body": {
      "family": "DM Sans",
      "file": "fonts/dm-sans.ttf",
      "weight": 400,
      "sizePx": 16,
      "lineHeight": 1.7
    },
    "accent": {
      "family": "Instrument Serif",
      "file": "fonts/instrument-serif-italic.ttf",
      "style": "italic"
    },
    "label": {
      "sizePx": 11,
      "trackingEm": 0.08,
      "lineHeight": 1.5
    }
  },
  "layout": {
    "id": "botanical",
    "family": "botanical",
    "mode": "dark",
    "alignment": "left",
    "maxWidthPx": 1280,
    "pageGutter": "clamp(20px, 4vw, 64px)",
    "sectionGap": "clamp(64px, 9vw, 128px)",
    "heroTextRatio": 0.54,
    "gridColumns": 3,
    "breakpoints": {
      "mobile": 640,
      "tablet": 960
    },
    "description": "Forest hero; left-aligned, two-line display; a large botanical image occupies the right half. Cream product cards follow a 3-column desktop / 1-column mobile grid."
  },
  "components": {
    "classes": {
      "root": "of-theme",
      "container": "of-container",
      "header": "of-header",
      "navigation": "of-nav",
      "mobileNavigation": "of-mobile-nav",
      "logo": "of-logo",
      "eyebrow": "of-eyebrow",
      "hero": "of-hero",
      "heroCopy": "of-hero-copy",
      "heroHeading": "of-display",
      "heroMedia": "of-hero-media",
      "heading": "of-heading",
      "body": "of-body",
      "actions": "of-actions",
      "button": "of-button",
      "secondaryButton": "of-button of-button--ghost",
      "section": "of-section",
      "sectionHeading": "of-section-heading",
      "grid": "of-grid",
      "card": "of-card",
      "cardImage": "of-card-image",
      "badge": "of-badge",
      "form": "of-form",
      "field": "of-field",
      "input": "of-input",
      "select": "of-select",
      "textarea": "of-textarea",
      "notice": "of-notice",
      "table": "of-table",
      "accordion": "of-accordion",
      "footer": "of-footer"
    },
    "radiusPx": 24,
    "cardRadiusPx": 0,
    "borderPx": 1,
    "buttonShape": "pill",
    "minimumControlHeightPx": 48,
    "inputHeightPx": 52,
    "focus": {
      "widthPx": 3,
      "offsetPx": 4,
      "color": "#153E35"
    }
  },
  "content": {
    "headline": [
      "Nature, in",
      "your nature."
    ],
    "eyebrow": "BOTANICAL CARE / CONSIDERED DAILY",
    "cta": "Discover the formulas",
    "secondaryCta": "Our approach",
    "nav": [
      "Formulas",
      "Philosophy",
      "Field notes"
    ],
    "features": [
      [
        "Rooted in something real",
        "Plant-led formulas with a purposeful place in your daily ritual."
      ],
      [
        "Less, thoughtfully",
        "A smaller collection. A clearer intention. Every ingredient belongs."
      ],
      [
        "A softer daily ritual",
        "Good care is a practice, not a promise of perfection."
      ]
    ]
  },
  "rules": [
    "Keep the leaf upright and give it half its height in clear space.",
    "Use forest for text; new leaf is a supporting surface, never small text on oat.",
    "Let the oversized mark crop at the edge of photography or packaging.",
    "Forest hero; left-aligned, two-line display; a large botanical image occupies the right half. Cream product cards follow a 3-column desktop / 1-column mobile grid.",
    "Use the supplied artwork and SVG logos; keep glyph proportions intact.",
    "Preserve the existing project content, routes, data fetching, and interaction handlers."
  ],
  "fonts": [
    {
      "id": "manrope",
      "family": "Manrope",
      "path": "fonts/manrope.ttf",
      "license": "fonts/manrope-OFL.txt",
      "weight": "200 800",
      "style": "normal"
    },
    {
      "id": "dm-sans",
      "family": "DM Sans",
      "path": "fonts/dm-sans.ttf",
      "license": "fonts/dm-sans-OFL.txt",
      "weight": "100 1000",
      "style": "normal"
    },
    {
      "id": "instrument-serif-italic",
      "family": "Instrument Serif",
      "path": "fonts/instrument-serif-italic.ttf",
      "license": "fonts/instrument-serif-italic-OFL.txt",
      "weight": "400",
      "style": "italic"
    }
  ],
  "exports": [
    "mark.svg",
    "lockup.svg",
    "wordmark.svg",
    "monochrome.svg",
    "pattern.svg",
    "poster.svg",
    "social.svg",
    "avatar.svg",
    "favicon.svg",
    "artwork.svg",
    "identity-board.svg",
    "stationery.svg",
    "packaging.svg",
    "website.svg",
    "social-story.svg",
    "icon-set.svg",
    "palette.svg",
    "typography.svg",
    "business-card.svg",
    "tokens.json",
    "theme.css",
    "theme.json",
    "theme.js",
    "reference.html",
    "components.html",
    "components.tsx",
    "install-theme.mjs",
    "AI-PROMPT.md",
    "INSTALL.md",
    "guidelines.md"
  ],
  "license": {
    "artwork": "CC0-1.0",
    "code": "MIT",
    "fonts": "OFL-1.1"
  },
  "acceptance": [
    "The exact stylesheet loads without a 404.",
    "All local fonts load; there are no requests to remote font services.",
    "The root or intended subtree carries the exact data-openform attribute.",
    "The supplied display font, colors, radius, spacing, and layout family are used consistently.",
    "At 360px, 768px, and 1440px there is no horizontal page overflow.",
    "Navigation, forms, routes, and existing business behavior still work.",
    "Controls are keyboard accessible with visible focus; reduced-motion preferences are respected.",
    "The final interface follows reference.html and components.html rather than a guessed visual style."
  ]
}
