        "components": [
          0.08235,
          0.24314,
          0.20784
        ],
        "alpha": 1
      },
      "$extensions": {
        "openform.hex": "#153E35"
      }
    },
    "accent": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.83529,
          0.9098,
          0.62745
        ],
        "alpha": 1
      },
      "$extensions": {
        "openform.hex": "#D5E8A0"
      }
    },
    "paper": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.95294,
          0.94118,
          0.87451
        ],
        "alpha": 1
      },
      "$extensions": {
        "openform.hex": "#F3F0DF"
      }
    },
    "support": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.6549,
          0.72157,
          0.62745
        ],
        "alpha": 1
      },
      "$extensions": {
        "openform.hex": "#A7B8A0"
      }
    }
  },
  "typography": {
    "heading": {
      "$type": "fontFamily",
      "$value": "Manrope"
    },
    "body": {
      "$type": "fontFamily",
      "$value": "DM Sans"
    },
    "headingWeight": {
      "$type": "fontWeight",
      "$value": 600
    },
    "tracking": {
      "$type": "number",
      "$value": -0.05,
      "$description": "Display letter spacing in em units."
    },
    "bodySize": {
      "$type": "dimension",
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "bodyLeading": {
      "$type": "number",
      "$value": 1.7
    }
  },
  "radius": {
    "$type": "dimension",
    "$value": {
      "value": 24,
      "unit": "px"
    }
  },
  "spacing": {
    "unit": {
      "$type": "dimension",
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "pageMinimum": {
      "$type": "dimension",
      "$value": {
        "value": 20,
        "unit": "px"
      }
    },
    "pageMaximum": {
      "$type": "dimension",
      "$value": {
        "value": 64,
        "unit": "px"
      }
    }
  },
  "$extensions": {
    "openform": {
      "name": "moss",
      "version": "2.0.0",
      "style": "Organic",
      "direction": "Botanical modernism",
      "voice": "Grounded, gentle, and quietly optimistic.",
      "layout": {
        "id": "botanical",
        "family": "botanical",
        "mode": "dark",
        "alignment": "left",
        "maxWidthPx": 1280,
        "pageGutter": "clamp(20px, 4vw, 64px)",
        "sectionGap": "clamp(64px, 9vw, 128px)",
        "heroTextRatio": 0.54,
        "gridColumns": 3,
        "breakpoints": {
          "mobile": 640,
          "tablet": 960
        },
        "description": "Forest hero; left-aligned, two-line display; a large botanical image occupies the right half. Cream product cards follow a 3-column desktop / 1-column mobile grid."
      },
      "contrast": [
        {
          "foreground": "#153E35",
          "background": "#D5E8A0",
          "ratio": 8.96,
          "aaNormal": true
        },
        {
          "foreground": "#153E35",
          "background": "#F3F0DF",
          "ratio": 10.35,
          "aaNormal": true
        }
      ]
    }
  }
}
