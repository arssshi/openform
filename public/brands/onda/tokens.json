    "bodyLeading": {
      "$type": "number",
      "$value": 1.7
    }
  },
  "radius": {
    "$type": "dimension",
    "$value": {
      "value": 28,
      "unit": "px"
    }
  },
  "spacing": {
    "unit": {
      "$type": "dimension",
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "pageMinimum": {
      "$type": "dimension",
      "$value": {
        "value": 20,
        "unit": "px"
      }
    },
    "pageMaximum": {
      "$type": "dimension",
      "$value": {
        "value": 64,
        "unit": "px"
      }
    }
  },
  "$extensions": {
    "openform": {
      "name": "onda",
      "version": "2.0.0",
      "style": "Organic",
      "direction": "A fluid practice",
      "voice": "Fluid, reassuring, and present.",
      "layout": {
        "id": "tidal",
        "family": "botanical",
        "mode": "paper",
        "alignment": "left",
        "maxWidthPx": 1300,
        "pageGutter": "clamp(20px, 4vw, 64px)",
        "sectionGap": "clamp(64px, 9vw, 128px)",
        "heroTextRatio": 0.5,
        "gridColumns": 3,
        "breakpoints": {
          "mobile": 640,
          "tablet": 960
        },
        "description": "Foam-white hero with sea-glass tidal art, a wide text-to-image gutter, and shell-colored section annotations. Rounded movement cards are balanced by open space."
      },
      "contrast": [
        {
          "foreground": "#204958",
          "background": "#A4D4CB",
          "ratio": 5.97,
          "aaNormal": true
        },
        {
          "foreground": "#204958",
          "background": "#EFF4E8",
          "ratio": 8.71,
          "aaNormal": true
        }
      ]
    }
  }
}
