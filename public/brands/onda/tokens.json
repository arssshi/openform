  "typography": {
    "heading": {
      "$type": "fontFamily",
      "$value": "Urbanist"
    },
    "body": {
      "$type": "fontFamily",
      "$value": "Karla"
    },
    "headingWeight": {
      "$type": "fontWeight",
      "$value": 500
