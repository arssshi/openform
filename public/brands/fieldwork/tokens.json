      "name": "fieldwork",
      "version": "2.0.0",
      "style": "Organic",
      "direction": "The field journal",
      "voice": "Resourceful, observant, and down to earth.",
      "layout": {
        "id": "landscape",
        "family": "expedition",
        "mode": "dark",
        "alignment": "left",
        "maxWidthPx": 1360,
        "pageGutter": "clamp(20px, 4vw, 64px)",
        "sectionGap": "clamp(64px, 9vw, 128px)",
        "heroTextRatio": 0.52,
        "gridColumns": 3,
        "breakpoints": {
          "mobile": 640,
          "tablet": 960
        },
        "description": "Dark canvas split hero, topo landscape, rust annotation chips, and numbered, mono-captioned equipment cards. A utility rhythm rather than decorative wellness softness."
      },
      "contrast": [
        {
          "foreground": "#1D251A",
          "background": "#CB764F",
          "ratio": 4.69,
          "aaNormal": true
        },
        {
          "foreground": "#1D251A",
          "background": "#EAE1C8",
          "ratio": 12.09,
          "aaNormal": true
        }
      ]
    }
