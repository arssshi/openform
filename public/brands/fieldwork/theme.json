{
  "format": "openform-theme",
  "version": "2.0.0",
  "id": "fieldwork",
  "name": "fieldwork",
  "direction": "The field journal",
  "concept": "Layered survey maps, trail-equipment details, and small expedition labels. A rich landscape carries the warmth of worn canvas and useful things.",
  "scope": {
    "attribute": "data-openform",
    "value": "fieldwork",
    "selector": "[data-openform=\"fieldwork\"]"
  },
  "installation": {
    "command": "node install-theme.mjs --target /path/to/your/project",
    "publicDirectory": "public",
    "destination": "themes/fieldwork",
    "stylesheet": "/themes/fieldwork/theme.css",
    "reference": "/themes/fieldwork/reference.html",
    "components": "/themes/fieldwork/components.html",
    "htmlAttribute": "data-openform=\"fieldwork\""
  },
  "colors": {
    "ink": "#1D251A",
    "accent": "#CB764F",
    "paper": "#EAE1C8",
    "support": "#A5B888",
    "secondary": "#3c4134",
    "border": "#b3ae99",
    "heroBackground": "#1D251A",
    "heroForeground": "#EAE1C8",
    "buttonBackground": "#CB764F",
    "buttonForeground": "#1D251A"
  },
  "typography": {
    "display": {
      "family": "Work Sans",
      "file": "fonts/work-sans.ttf",
      "weight": 600,
      "trackingEm": -0.03,
      "lineHeight": 1.02,
      "desktopMaxPx": 96,
      "mobileMinPx": 38
    },
    "body": {
      "family": "DM Mono",
      "file": "fonts/dm-mono.ttf",
      "weight": 400,
      "sizePx": 16,
      "lineHeight": 1.7
    },
    "accent": {
      "family": "DM Mono",
      "file": "fonts/dm-mono.ttf",
      "style": "normal"
    },
    "label": {
      "sizePx": 11,
      "trackingEm": 0.08,
      "lineHeight": 1.5
    }
  },
  "layout": {
    "id": "landscape",
    "family": "expedition",
    "mode": "dark",
    "alignment": "left",
    "maxWidthPx": 1360,
    "pageGutter": "clamp(20px, 4vw, 64px)",
    "sectionGap": "clamp(64px, 9vw, 128px)",
    "heroTextRatio": 0.52,
    "gridColumns": 3,
    "breakpoints": {
      "mobile": 640,
      "tablet": 960
    },
    "description": "Dark canvas split hero, topo landscape, rust annotation chips, and numbered, mono-captioned equipment cards. A utility rhythm rather than decorative wellness softness."
  },
  "components": {
    "classes": {
      "root": "of-theme",
      "container": "of-container",
      "header": "of-header",
      "navigation": "of-nav",
      "mobileNavigation": "of-mobile-nav",
      "logo": "of-logo",
      "eyebrow": "of-eyebrow",
      "hero": "of-hero",
      "heroCopy": "of-hero-copy",
      "heroHeading": "of-display",
      "heroMedia": "of-hero-media",
      "heading": "of-heading",
      "body": "of-body",
      "actions": "of-actions",
      "button": "of-button",
      "secondaryButton": "of-button of-button--ghost",
      "section": "of-section",
      "sectionHeading": "of-section-heading",
      "grid": "of-grid",
      "card": "of-card",
      "cardImage": "of-card-image",
      "badge": "of-badge",
      "form": "of-form",
      "field": "of-field",
      "input": "of-input",
      "select": "of-select",
      "textarea": "of-textarea",
      "notice": "of-notice",
      "table": "of-table",
      "accordion": "of-accordion",
      "footer": "of-footer"
    },
    "radiusPx": 6,
    "cardRadiusPx": 0,
    "borderPx": 1,
    "buttonShape": "square",
    "minimumControlHeightPx": 48,
    "inputHeightPx": 52,
    "focus": {
      "widthPx": 3,
      "offsetPx": 4,
      "color": "#1D251A"
    }
  },
  "content": {
    "headline": [
      "There is more",
      "out there."
    ],
    "eyebrow": "FIELD NOTES / GOODS FOR GOING",
    "cta": "Explore the field",
    "secondaryCta": "Read the journal",
    "nav": [
      "Equipment",
      "Field notes",
      "The approach"
    ],
    "features": [
      [
        "Built for outside",
        "Honest equipment for the places a screen cannot take you."
      ],
      [
        "Observe a little closer",
        "Field notes that make familiar landscapes feel new again."
      ],
      [
        "Take only what helps",
        "A focused collection of objects with a job to do."
      ]
    ]
  },
  "rules": [
    "Use contour lines as full-bleed backgrounds at low visual density.",
    "Keep the horizon mark horizontal even on angled applications.",
    "Give product specifications mono typography and clearly separated rows.",
    "Dark canvas split hero, topo landscape, rust annotation chips, and numbered, mono-captioned equipment cards. A utility rhythm rather than decorative wellness softness.",
    "Use the supplied artwork and SVG logos; keep glyph proportions intact.",
    "Preserve the existing project content, routes, data fetching, and interaction handlers."
  ],
  "fonts": [
    {
      "id": "work-sans",
      "family": "Work Sans",
      "path": "fonts/work-sans.ttf",
      "license": "fonts/work-sans-OFL.txt",
      "weight": "100 900",
      "style": "normal"
    },
    {
      "id": "dm-mono",
      "family": "DM Mono",
      "path": "fonts/dm-mono.ttf",
      "license": "fonts/dm-mono-OFL.txt",
      "weight": "400",
      "style": "normal"
    }
  ],
  "exports": [
    "mark.svg",
    "lockup.svg",
    "wordmark.svg",
    "monochrome.svg",
    "pattern.svg",
    "poster.svg",
    "social.svg",
    "avatar.svg",
    "favicon.svg",
    "artwork.svg",
    "identity-board.svg",
    "stationery.svg",
    "packaging.svg",
    "website.svg",
    "social-story.svg",
    "icon-set.svg",
    "palette.svg",
    "typography.svg",
    "business-card.svg",
    "tokens.json",
    "theme.css",
    "theme.json",
    "theme.js",
    "reference.html",
    "components.html",
    "components.tsx",
    "install-theme.mjs",
    "AI-PROMPT.md",
    "INSTALL.md",
    "guidelines.md"
  ],
  "license": {
    "artwork": "CC0-1.0",
    "code": "MIT",
    "fonts": "OFL-1.1"
  },
  "acceptance": [
    "The exact stylesheet loads without a 404.",
    "All local fonts load; there are no requests to remote font services.",
    "The root or intended subtree carries the exact data-openform attribute.",
    "The supplied display font, colors, radius, spacing, and layout family are used consistently.",
    "At 360px, 768px, and 1440px there is no horizontal page overflow.",
    "Navigation, forms, routes, and existing business behavior still work.",
    "Controls are keyboard accessible with visible focus; reduced-motion preferences are respected.",
    "The final interface follows reference.html and components.html rather than a guessed visual style."
  ]
}
