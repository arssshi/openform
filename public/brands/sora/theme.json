{
  "format": "openform-theme",
  "version": "2.0.0",
  "id": "sora",
  "name": "SORA",
  "direction": "Light as structure",
  "concept": "Monolithic apertures, isometric architectural studies, and rigorously spaced type. Every application treats light and negative space as building materials.",
  "scope": {
    "attribute": "data-openform",
    "value": "sora",
    "selector": "[data-openform=\"sora\"]"
  },
  "installation": {
    "command": "node install-theme.mjs --target /path/to/your/project",
    "publicDirectory": "public",
    "destination": "themes/sora",
    "stylesheet": "/themes/sora/theme.css",
    "reference": "/themes/sora/reference.html",
    "components": "/themes/sora/components.html",
    "htmlAttribute": "data-openform=\"sora\""
  },
  "colors": {
    "ink": "#243E4C",
    "accent": "#B8DDE5",
    "paper": "#F8F6EE",
    "support": "#CF7D58",
    "secondary": "#445a64",
    "border": "#bfc4c2",
    "heroBackground": "#F8F6EE",
    "heroForeground": "#243E4C",
    "buttonBackground": "#243E4C",
    "buttonForeground": "#F8F6EE"
  },
  "typography": {
    "display": {
      "family": "Outfit",
      "file": "fonts/outfit.ttf",
      "weight": 400,
      "trackingEm": 0.1,
      "lineHeight": 1.02,
      "desktopMaxPx": 94,
      "mobileMinPx": 38
    },
    "body": {
      "family": "Work Sans",
      "file": "fonts/work-sans.ttf",
      "weight": 400,
      "sizePx": 16,
      "lineHeight": 1.7
    },
    "accent": {
      "family": "Instrument Serif",
      "file": "fonts/instrument-serif-italic.ttf",
      "style": "italic"
    },
    "label": {
      "sizePx": 11,
      "trackingEm": 0.08,
      "lineHeight": 1.5
    }
  },
  "layout": {
    "id": "architectural",
    "family": "architecture",
    "mode": "paper",
    "alignment": "left",
    "maxWidthPx": 1440,
    "pageGutter": "clamp(20px, 4vw, 64px)",
    "sectionGap": "clamp(64px, 9vw, 128px)",
    "heroTextRatio": 0.42,
    "gridColumns": 3,
    "breakpoints": {
      "mobile": 640,
      "tablet": 960
    },
    "description": "An airy white architectural hero. Use an 8-column feeling, tracked uppercase labels, a wide right-hand image, and numbered project rows instead of bubbly UI."
  },
  "components": {
    "classes": {
      "root": "of-theme",
      "container": "of-container",
      "header": "of-header",
      "navigation": "of-nav",
      "mobileNavigation": "of-mobile-nav",
      "logo": "of-logo",
      "eyebrow": "of-eyebrow",
      "hero": "of-hero",
      "heroCopy": "of-hero-copy",
      "heroHeading": "of-display",
      "heroMedia": "of-hero-media",
      "heading": "of-heading",
      "body": "of-body",
      "actions": "of-actions",
      "button": "of-button",
      "secondaryButton": "of-button of-button--ghost",
      "section": "of-section",
      "sectionHeading": "of-section-heading",
      "grid": "of-grid",
      "card": "of-card",
      "cardImage": "of-card-image",
      "badge": "of-badge",
      "form": "of-form",
      "field": "of-field",
      "input": "of-input",
      "select": "of-select",
      "textarea": "of-textarea",
      "notice": "of-notice",
      "table": "of-table",
      "accordion": "of-accordion",
      "footer": "of-footer"
    },
    "radiusPx": 2,
    "cardRadiusPx": 0,
    "borderPx": 1,
    "buttonShape": "square",
    "minimumControlHeightPx": 48,
    "inputHeightPx": 52,
    "focus": {
      "widthPx": 3,
      "offsetPx": 4,
      "color": "#243E4C"
    }
  },
  "content": {
    "headline": [
      "Spaces for",
      "a different light."
    ],
    "eyebrow": "ARCHITECTURE / INTERIORS / LIGHT",
    "cta": "View selected spaces",
    "secondaryCta": "Meet the practice",
    "nav": [
      "Spaces",
      "Practice",
      "Perspectives"
    ],
    "features": [
      [
        "Begin with the light",
        "A considered approach to how a space feels throughout the day."
      ],
      [
        "Material honesty",
        "Form and texture chosen for their place, purpose, and longevity."
      ],
      [
        "Room to breathe",
        "Measured spaces that leave enough room for real life."
      ]
    ]
  },
  "rules": [
    "Align the arch opening to the baseline of the wordmark.",
    "Set headings in spaced capitals and body copy in sentence case.",
    "Build compositions on an eight-column grid with wide outside margins.",
    "An airy white architectural hero. Use an 8-column feeling, tracked uppercase labels, a wide right-hand image, and numbered project rows instead of bubbly UI.",
    "Use the supplied artwork and SVG logos; keep glyph proportions intact.",
    "Preserve the existing project content, routes, data fetching, and interaction handlers."
  ],
  "fonts": [
    {
      "id": "outfit",
      "family": "Outfit",
      "path": "fonts/outfit.ttf",
      "license": "fonts/outfit-OFL.txt",
      "weight": "100 900",
      "style": "normal"
    },
    {
      "id": "work-sans",
      "family": "Work Sans",
      "path": "fonts/work-sans.ttf",
      "license": "fonts/work-sans-OFL.txt",
      "weight": "100 900",
      "style": "normal"
    },
    {
      "id": "instrument-serif-italic",
      "family": "Instrument Serif",
      "path": "fonts/instrument-serif-italic.ttf",
      "license": "fonts/instrument-serif-italic-OFL.txt",
      "weight": "400",
      "style": "italic"
    }
  ],
  "exports": [
    "mark.svg",
    "lockup.svg",
    "wordmark.svg",
    "monochrome.svg",
    "pattern.svg",
    "poster.svg",
    "social.svg",
    "avatar.svg",
    "favicon.svg",
    "artwork.svg",
    "identity-board.svg",
    "stationery.svg",
    "packaging.svg",
    "website.svg",
    "social-story.svg",
    "icon-set.svg",
    "palette.svg",
    "typography.svg",
    "business-card.svg",
    "tokens.json",
    "theme.css",
    "theme.json",
    "theme.js",
    "reference.html",
    "components.html",
    "components.tsx",
    "install-theme.mjs",
    "AI-PROMPT.md",
    "INSTALL.md",
    "guidelines.md"
  ],
  "license": {
    "artwork": "CC0-1.0",
    "code": "MIT",
    "fonts": "OFL-1.1"
  },
  "acceptance": [
    "The exact stylesheet loads without a 404.",
    "All local fonts load; there are no requests to remote font services.",
    "The root or intended subtree carries the exact data-openform attribute.",
    "The supplied display font, colors, radius, spacing, and layout family are used consistently.",
    "At 360px, 768px, and 1440px there is no horizontal page overflow.",
    "Navigation, forms, routes, and existing business behavior still work.",
    "Controls are keyboard accessible with visible focus; reduced-motion preferences are respected.",
    "The final interface follows reference.html and components.html rather than a guessed visual style."
  ]
}
