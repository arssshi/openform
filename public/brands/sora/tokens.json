{
  "$description": "SORA / Light as structure / Edition 02",
  "color": {
    "ink": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.14118,
          0.24314,
          0.29804
        ],
        "alpha": 1
      },
      "$extensions": {
        "openform.hex": "#243E4C"
      }
    },
    "accent": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.72157,
          0.86667,
          0.89804
        ],
        "alpha": 1
      },
      "$extensions": {
        "openform.hex": "#B8DDE5"
      }
    },
    "paper": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.97255,
          0.96471,
          0.93333
        ],
        "alpha": 1
      },
      "$extensions": {
        "openform.hex": "#F8F6EE"
      }
    },
    "support": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.81176,
          0.4902,
          0.3451
        ],
        "alpha": 1
      },
      "$extensions": {
        "openform.hex": "#CF7D58"
      }
    }
  },
  "typography": {
    "heading": {
      "$type": "fontFamily",
      "$value": "Outfit"
    },
    "body": {
      "$type": "fontFamily",
      "$value": "Work Sans"
    },
    "headingWeight": {
      "$type": "fontWeight",
      "$value": 400
    },
    "tracking": {
      "$type": "number",
      "$value": 0.1,
      "$description": "Display letter spacing in em units."
    },
    "bodySize": {
      "$type": "dimension",
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "bodyLeading": {
      "$type": "number",
      "$value": 1.7
    }
  },
  "radius": {
    "$type": "dimension",
    "$value": {
      "value": 2,
      "unit": "px"
    }
  },
  "spacing": {
    "unit": {
      "$type": "dimension",
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "pageMinimum": {
      "$type": "dimension",
      "$value": {
        "value": 20,
        "unit": "px"
      }
    },
    "pageMaximum": {
      "$type": "dimension",
      "$value": {
        "value": 64,
        "unit": "px"
      }
    }
  },
  "$extensions": {
    "openform": {
      "name": "SORA",
      "version": "2.0.0",
      "style": "Minimal",
      "direction": "Light as structure",
      "voice": "Precise, open, and thoughtful.",
      "layout": {
        "id": "architectural",
        "family": "architecture",
        "mode": "paper",
        "alignment": "left",
        "maxWidthPx": 1440,
        "pageGutter": "clamp(20px, 4vw, 64px)",
        "sectionGap": "clamp(64px, 9vw, 128px)",
        "heroTextRatio": 0.42,
        "gridColumns": 3,
        "breakpoints": {
          "mobile": 640,
          "tablet": 960
        },
        "description": "An airy white architectural hero. Use an 8-column feeling, tracked uppercase labels, a wide right-hand image, and numbered project rows instead of bubbly UI."
      },
      "contrast": [
        {
          "foreground": "#243E4C",
          "background": "#B8DDE5",
          "ratio": 7.77,
          "aaNormal": true
        },
        {
          "foreground": "#243E4C",
          "background": "#F8F6EE",
          "ratio": 10.39,
          "aaNormal": true
        }
      ]
    }
  }
}
