{
  "format": "openform-theme",
  "version": "2.0.0",
  "id": "paloma",
  "name": "Paloma",
  "direction": "The independent imprint",
  "concept": "Cut-paper flight, book-cover rhythm, drop-cap-like display typography, and a rich mustard-and-ink palette. A literary world with a contemporary editorial edge.",
  "scope": {
    "attribute": "data-openform",
    "value": "paloma",
    "selector": "[data-openform=\"paloma\"]"
  },
  "installation": {
    "command": "node install-theme.mjs --target /path/to/your/project",
    "publicDirectory": "public",
    "destination": "themes/paloma",
    "stylesheet": "/themes/paloma/theme.css",
    "reference": "/themes/paloma/reference.html",
    "components": "/themes/paloma/components.html",
    "htmlAttribute": "data-openform=\"paloma\""
  },
  "colors": {
    "ink": "#233048",
    "accent": "#E6C46B",
    "paper": "#FAF4E6",
    "support": "#C5A5AD",
    "secondary": "#434d60",
    "border": "#c0bfbb",
    "heroBackground": "#FAF4E6",
    "heroForeground": "#233048",
    "buttonBackground": "#233048",
    "buttonForeground": "#FAF4E6"
  },
  "typography": {
    "display": {
      "family": "Lora",
      "file": "fonts/lora.ttf",
      "weight": 500,
      "trackingEm": -0.03,
      "lineHeight": 1.02,
      "desktopMaxPx": 96,
      "mobileMinPx": 38
    },
    "body": {
      "family": "Work Sans",
      "file": "fonts/work-sans.ttf",
      "weight": 400,
      "sizePx": 16,
      "lineHeight": 1.7
    },
    "accent": {
      "family": "Instrument Serif",
      "file": "fonts/instrument-serif-italic.ttf",
      "style": "italic"
    },
    "label": {
      "sizePx": 11,
      "trackingEm": 0.08,
      "lineHeight": 1.5
    }
  },
  "layout": {
    "id": "editorial",
    "family": "editorial",
    "mode": "paper",
    "alignment": "left",
    "maxWidthPx": 1260,
    "pageGutter": "clamp(20px, 4vw, 64px)",
    "sectionGap": "clamp(64px, 9vw, 128px)",
    "heroTextRatio": 0.47,
    "gridColumns": 3,
    "breakpoints": {
      "mobile": 640,
      "tablet": 960
    },
    "description": "A paper editorial hero with serif display and a yellow book-jacket image. Hairline columns, large reading margins, and clearly separated editorial metadata."
  },
  "components": {
    "classes": {
      "root": "of-theme",
      "container": "of-container",
      "header": "of-header",
      "navigation": "of-nav",
      "mobileNavigation": "of-mobile-nav",
      "logo": "of-logo",
      "eyebrow": "of-eyebrow",
      "hero": "of-hero",
      "heroCopy": "of-hero-copy",
      "heroHeading": "of-display",
      "heroMedia": "of-hero-media",
      "heading": "of-heading",
      "body": "of-body",
      "actions": "of-actions",
      "button": "of-button",
      "secondaryButton": "of-button of-button--ghost",
      "section": "of-section",
      "sectionHeading": "of-section-heading",
      "grid": "of-grid",
      "card": "of-card",
      "cardImage": "of-card-image",
      "badge": "of-badge",
      "form": "of-form",
      "field": "of-field",
      "input": "of-input",
      "select": "of-select",
      "textarea": "of-textarea",
      "notice": "of-notice",
      "table": "of-table",
      "accordion": "of-accordion",
      "footer": "of-footer"
    },
    "radiusPx": 2,
    "cardRadiusPx": 0,
    "borderPx": 1,
    "buttonShape": "outline",
    "minimumControlHeightPx": 48,
    "inputHeightPx": 52,
    "focus": {
      "widthPx": 3,
      "offsetPx": 4,
      "color": "#233048"
    }
  },
  "content": {
    "headline": [
      "Stay for",
      "the story."
    ],
    "eyebrow": "AN INDEPENDENT PRESS / OPEN WORLDS",
    "cta": "Explore the stories",
    "secondaryCta": "About the imprint",
    "nav": [
      "Books",
      "Writers",
      "The imprint"
    ],
    "features": [
      [
        "A voice of their own",
        "Work chosen for its character, care, and unmistakable perspective."
      ],
      [
        "Books as objects",
        "Considered paper, good typography, and room for the words."
      ],
      [
        "A conversation that lasts",
        "Stories to return to, pass on, and keep close."
      ]
    ]
  },
  "rules": [
    "Let the bird point toward the reading direction.",
    "Use marigold for covers and midnight for all long-form reading text.",
    "Set excerpts with generous leading and a visible opening margin.",
    "A paper editorial hero with serif display and a yellow book-jacket image. Hairline columns, large reading margins, and clearly separated editorial metadata.",
    "Use the supplied artwork and SVG logos; keep glyph proportions intact.",
    "Preserve the existing project content, routes, data fetching, and interaction handlers."
  ],
  "fonts": [
    {
      "id": "lora",
      "family": "Lora",
      "path": "fonts/lora.ttf",
      "license": "fonts/lora-OFL.txt",
      "weight": "400 700",
      "style": "normal"
    },
    {
      "id": "work-sans",
      "family": "Work Sans",
      "path": "fonts/work-sans.ttf",
      "license": "fonts/work-sans-OFL.txt",
      "weight": "100 900",
      "style": "normal"
    },
    {
      "id": "instrument-serif-italic",
      "family": "Instrument Serif",
      "path": "fonts/instrument-serif-italic.ttf",
      "license": "fonts/instrument-serif-italic-OFL.txt",
      "weight": "400",
      "style": "italic"
    }
  ],
  "exports": [
    "mark.svg",
    "lockup.svg",
    "wordmark.svg",
    "monochrome.svg",
    "pattern.svg",
    "poster.svg",
    "social.svg",
    "avatar.svg",
    "favicon.svg",
    "artwork.svg",
    "identity-board.svg",
    "stationery.svg",
    "packaging.svg",
    "website.svg",
    "social-story.svg",
    "icon-set.svg",
    "palette.svg",
    "typography.svg",
    "business-card.svg",
    "tokens.json",
    "theme.css",
    "theme.json",
    "theme.js",
    "reference.html",
    "components.html",
    "components.tsx",
    "install-theme.mjs",
    "AI-PROMPT.md",
    "INSTALL.md",
    "guidelines.md"
  ],
  "license": {
    "artwork": "CC0-1.0",
    "code": "MIT",
    "fonts": "OFL-1.1"
  },
  "acceptance": [
    "The exact stylesheet loads without a 404.",
    "All local fonts load; there are no requests to remote font services.",
    "The root or intended subtree carries the exact data-openform attribute.",
    "The supplied display font, colors, radius, spacing, and layout family are used consistently.",
    "At 360px, 768px, and 1440px there is no horizontal page overflow.",
    "Navigation, forms, routes, and existing business behavior still work.",
    "Controls are keyboard accessible with visible focus; reduced-motion preferences are respected.",
    "The final interface follows reference.html and components.html rather than a guessed visual style."
  ]
}
