        "components": [
          0.13725,
          0.18824,
          0.28235
        ],
        "alpha": 1
      },
      "$extensions": {
        "openform.hex": "#233048"
      }
    },
    "accent": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
