    },
    "bodySize": {
      "$type": "dimension",
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "bodyLeading": {
      "$type": "number",
      "$value": 1.7
    }
  },
  "radius": {
    "$type": "dimension",
    "$value": {
      "value": 2,
      "unit": "px"
    }
  },
  "spacing": {
    "unit": {
      "$type": "dimension",
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "pageMinimum": {
      "$type": "dimension",
      "$value": {
        "value": 20,
        "unit": "px"
      }
    },
    "pageMaximum": {
      "$type": "dimension",
      "$value": {
        "value": 64,
        "unit": "px"
      }
    }
  },
  "$extensions": {
    "openform": {
      "name": "Paloma",
      "version": "2.0.0",
      "style": "Editorial",
      "direction": "The independent imprint",
      "voice": "Reflective, humane, and richly descriptive.",
      "layout": {
        "id": "editorial",
        "family": "editorial",
        "mode": "paper",
        "alignment": "left",
        "maxWidthPx": 1260,
        "pageGutter": "clamp(20px, 4vw, 64px)",
        "sectionGap": "clamp(64px, 9vw, 128px)",
        "heroTextRatio": 0.47,
        "gridColumns": 3,
        "breakpoints": {
          "mobile": 640,
          "tablet": 960
        },
        "description": "A paper editorial hero with serif display and a yellow book-jacket image. Hairline columns, large reading margins, and clearly separated editorial metadata."
      },
      "contrast": [
        {
          "foreground": "#233048",
          "background": "#E6C46B",
          "ratio": 7.86,
          "aaNormal": true
        },
        {
          "foreground": "#233048",
          "background": "#FAF4E6",
          "ratio": 12.06,
          "aaNormal": true
        }
      ]
    }
  }
}
