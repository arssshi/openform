          0.41961
        ],
        "alpha": 1
      },
      "$extensions": {
        "openform.hex": "#E6C46B"
      }
    },
    "paper": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.98039,
          0.95686,
          0.90196
        ],
        "alpha": 1
      },
      "$extensions": {
        "openform.hex": "#FAF4E6"
      }
    },
    "support": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.77255,
          0.64706,
          0.67843
        ],
        "alpha": 1
      },
      "$extensions": {
        "openform.hex": "#C5A5AD"
      }
    }
  },
  "typography": {
    "heading": {
      "$type": "fontFamily",
      "$value": "Lora"
    },
    "body": {
      "$type": "fontFamily",
      "$value": "Work Sans"
    },
    "headingWeight": {
      "$type": "fontWeight",
      "$value": 500
    },
    "tracking": {
      "$type": "number",
      "$value": -0.03,
