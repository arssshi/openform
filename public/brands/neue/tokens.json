  "spacing": {
    "unit": {
      "$type": "dimension",
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "pageMinimum": {
      "$type": "dimension",
      "$value": {
        "value": 20,
        "unit": "px"
      }
    },
    "pageMaximum": {
      "$type": "dimension",
      "$value": {
        "value": 64,
        "unit": "px"
      }
    }
  },
  "$extensions": {
    "openform": {
      "name": "neue",
      "version": "2.0.0",
      "style": "Minimal",
      "direction": "Precision in motion",
      "voice": "Clear, useful, and confident.",
      "layout": {
        "id": "swiss",
        "family": "digital",
        "mode": "paper",
        "alignment": "left",
        "maxWidthPx": 1260,
        "pageGutter": "clamp(20px, 4vw, 64px)",
        "sectionGap": "clamp(64px, 9vw, 128px)",
        "heroTextRatio": 0.56,
        "gridColumns": 3,
        "breakpoints": {
          "mobile": 640,
          "tablet": 960
        },
        "description": "White, left-aligned product hero with an alloy-fold image. Restrained 8px cards, 1px dividers, one mineral accent, and clear numerical hierarchy."
      },
      "contrast": [
        {
          "foreground": "#22282D",
          "background": "#C5CDD3",
          "ratio": 9.26,
          "aaNormal": true
        },
        {
          "foreground": "#22282D",
          "background": "#F5F6F4",
          "ratio": 13.74,
          "aaNormal": true
        }
      ]
    }
  }
