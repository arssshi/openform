{
  "format": "openform-theme",
  "version": "2.0.0",
  "id": "neue",
  "name": "neue",
  "direction": "Precision in motion",
  "concept": "Folded aluminum-like surfaces, disciplined neutral typography, and modular documentation. Contrast, alignment, and sequence create the entire visual language.",
  "scope": {
    "attribute": "data-openform",
    "value": "neue",
    "selector": "[data-openform=\"neue\"]"
  },
  "installation": {
    "command": "node install-theme.mjs --target /path/to/your/project",
    "publicDirectory": "public",
    "destination": "themes/neue",
    "stylesheet": "/themes/neue/theme.css",
    "reference": "/themes/neue/reference.html",
    "components": "/themes/neue/components.html",
    "htmlAttribute": "data-openform=\"neue\""
  },
  "colors": {
    "ink": "#22282D",
    "accent": "#C5CDD3",
    "paper": "#F5F6F4",
    "support": "#798F86",
    "secondary": "#42474b",
    "border": "#bcbebe",
    "heroBackground": "#F5F6F4",
    "heroForeground": "#22282D",
    "buttonBackground": "#22282D",
    "buttonForeground": "#F5F6F4"
  },
  "typography": {
    "display": {
      "family": "DM Sans",
      "file": "fonts/dm-sans.ttf",
      "weight": 500,
      "trackingEm": -0.05,
      "lineHeight": 1.02,
      "desktopMaxPx": 96,
      "mobileMinPx": 38
    },
    "body": {
      "family": "Space Grotesk",
      "file": "fonts/space-grotesk.ttf",
      "weight": 400,
      "sizePx": 16,
      "lineHeight": 1.7
    },
    "accent": {
      "family": "Space Grotesk",
      "file": "fonts/space-grotesk.ttf",
      "style": "normal"
    },
    "label": {
      "sizePx": 11,
      "trackingEm": 0.08,
      "lineHeight": 1.5
    }
  },
  "layout": {
    "id": "swiss",
    "family": "digital",
    "mode": "paper",
    "alignment": "left",
    "maxWidthPx": 1260,
    "pageGutter": "clamp(20px, 4vw, 64px)",
    "sectionGap": "clamp(64px, 9vw, 128px)",
    "heroTextRatio": 0.56,
    "gridColumns": 3,
    "breakpoints": {
      "mobile": 640,
      "tablet": 960
    },
    "description": "White, left-aligned product hero with an alloy-fold image. Restrained 8px cards, 1px dividers, one mineral accent, and clear numerical hierarchy."
  },
  "components": {
    "classes": {
      "root": "of-theme",
      "container": "of-container",
      "header": "of-header",
      "navigation": "of-nav",
      "mobileNavigation": "of-mobile-nav",
      "logo": "of-logo",
      "eyebrow": "of-eyebrow",
      "hero": "of-hero",
      "heroCopy": "of-hero-copy",
      "heroHeading": "of-display",
      "heroMedia": "of-hero-media",
      "heading": "of-heading",
      "body": "of-body",
      "actions": "of-actions",
      "button": "of-button",
      "secondaryButton": "of-button of-button--ghost",
      "section": "of-section",
      "sectionHeading": "of-section-heading",
      "grid": "of-grid",
      "card": "of-card",
      "cardImage": "of-card-image",
      "badge": "of-badge",
      "form": "of-form",
      "field": "of-field",
      "input": "of-input",
      "select": "of-select",
      "textarea": "of-textarea",
      "notice": "of-notice",
      "table": "of-table",
      "accordion": "of-accordion",
      "footer": "of-footer"
    },
    "radiusPx": 8,
    "cardRadiusPx": 0,
    "borderPx": 1,
    "buttonShape": "soft",
    "minimumControlHeightPx": 48,
    "inputHeightPx": 52,
    "focus": {
      "widthPx": 3,
      "offsetPx": 4,
      "color": "#22282D"
    }
  },
  "content": {
    "headline": [
      "A clearer way",
      "to get things done."
    ],
    "eyebrow": "A MORE CONSIDERED DIGITAL WORKSPACE",
    "cta": "Discover a better flow",
    "secondaryCta": "See how it works",
    "nav": [
      "The system",
      "How it works",
      "Resources"
    ],
    "features": [
      [
        "One clear place",
        "A modular workspace that puts the useful things first."
      ],
      [
        "Less to get around",
        "Thoughtful defaults and a hierarchy that makes sense."
      ],
      [
        "More room to focus",
        "A quiet interface that lets the work do the talking."
      ]
    ]
  },
  "rules": [
    "The folded N is always filled, never outlined.",
    "Use a single accent per interface view and maintain strong neutral hierarchy.",
    "Align all headings to the same vertical axis across a page.",
    "White, left-aligned product hero with an alloy-fold image. Restrained 8px cards, 1px dividers, one mineral accent, and clear numerical hierarchy.",
    "Use the supplied artwork and SVG logos; keep glyph proportions intact.",
    "Preserve the existing project content, routes, data fetching, and interaction handlers."
  ],
  "fonts": [
    {
      "id": "dm-sans",
      "family": "DM Sans",
      "path": "fonts/dm-sans.ttf",
      "license": "fonts/dm-sans-OFL.txt",
      "weight": "100 1000",
      "style": "normal"
    },
    {
      "id": "space-grotesk",
      "family": "Space Grotesk",
      "path": "fonts/space-grotesk.ttf",
      "license": "fonts/space-grotesk-OFL.txt",
      "weight": "300 700",
      "style": "normal"
    }
  ],
  "exports": [
    "mark.svg",
    "lockup.svg",
    "wordmark.svg",
    "monochrome.svg",
    "pattern.svg",
    "poster.svg",
    "social.svg",
    "avatar.svg",
    "favicon.svg",
    "artwork.svg",
    "identity-board.svg",
    "stationery.svg",
    "packaging.svg",
    "website.svg",
    "social-story.svg",
    "icon-set.svg",
    "palette.svg",
    "typography.svg",
    "business-card.svg",
    "tokens.json",
    "theme.css",
    "theme.json",
    "theme.js",
    "reference.html",
    "components.html",
    "components.tsx",
    "install-theme.mjs",
    "AI-PROMPT.md",
    "INSTALL.md",
    "guidelines.md"
  ],
  "license": {
    "artwork": "CC0-1.0",
    "code": "MIT",
    "fonts": "OFL-1.1"
  },
  "acceptance": [
    "The exact stylesheet loads without a 404.",
    "All local fonts load; there are no requests to remote font services.",
    "The root or intended subtree carries the exact data-openform attribute.",
    "The supplied display font, colors, radius, spacing, and layout family are used consistently.",
    "At 360px, 768px, and 1440px there is no horizontal page overflow.",
    "Navigation, forms, routes, and existing business behavior still work.",
    "Controls are keyboard accessible with visible focus; reduced-motion preferences are respected.",
    "The final interface follows reference.html and components.html rather than a guessed visual style."
  ]
}
