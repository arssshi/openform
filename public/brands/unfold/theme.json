{
  "format": "openform-theme",
  "version": "2.0.0",
  "id": "unfold",
  "name": "UNFOLD",
  "direction": "The printed perspective",
  "concept": "Folded yellow paper, editorial crop marks, interlocking typographic planes, and full-bleed reading layouts. A publication that treats the page as both content and object.",
  "scope": {
    "attribute": "data-openform",
    "value": "unfold",
    "selector": "[data-openform=\"unfold\"]"
  },
  "installation": {
    "command": "node install-theme.mjs --target /path/to/your/project",
    "publicDirectory": "public",
    "destination": "themes/unfold",
    "stylesheet": "/themes/unfold/theme.css",
    "reference": "/themes/unfold/reference.html",
    "components": "/themes/unfold/components.html",
    "htmlAttribute": "data-openform=\"unfold\""
  },
  "colors": {
    "ink": "#2B2B25",
    "accent": "#F3DA56",
    "paper": "#F1EFE5",
    "support": "#B8B8A9",
    "secondary": "#494842",
    "border": "#bcbab1",
    "heroBackground": "#F3DA56",
    "heroForeground": "#2B2B25",
    "buttonBackground": "#2B2B25",
    "buttonForeground": "#F1EFE5"
  },
  "typography": {
    "display": {
      "family": "Archivo",
      "file": "fonts/archivo.ttf",
      "weight": 800,
      "trackingEm": -0.03,
      "lineHeight": 0.96,
      "desktopMaxPx": 96,
      "mobileMinPx": 38
    },
    "body": {
      "family": "Space Grotesk",
      "file": "fonts/space-grotesk.ttf",
      "weight": 400,
      "sizePx": 16,
      "lineHeight": 1.7
    },
    "accent": {
      "family": "DM Mono",
      "file": "fonts/dm-mono.ttf",
      "style": "normal"
    },
    "label": {
      "sizePx": 11,
      "trackingEm": 0.08,
      "lineHeight": 1.5
    }
  },
  "layout": {
    "id": "folded",
    "family": "poster",
    "mode": "accent",
    "alignment": "left",
    "maxWidthPx": 1400,
    "pageGutter": "clamp(20px, 4vw, 64px)",
    "sectionGap": "clamp(64px, 9vw, 128px)",
    "heroTextRatio": 0.6,
    "gridColumns": 3,
    "breakpoints": {
      "mobile": 640,
      "tablet": 960
    },
    "description": "Yellow poster hero, bold condensed editorial setting, exposed fold graphic, hard black rules, and square issue cards. Metadata always snaps to the grid."
  },
  "components": {
    "classes": {
      "root": "of-theme",
      "container": "of-container",
      "header": "of-header",
      "navigation": "of-nav",
      "mobileNavigation": "of-mobile-nav",
      "logo": "of-logo",
      "eyebrow": "of-eyebrow",
      "hero": "of-hero",
      "heroCopy": "of-hero-copy",
      "heroHeading": "of-display",
      "heroMedia": "of-hero-media",
      "heading": "of-heading",
      "body": "of-body",
      "actions": "of-actions",
      "button": "of-button",
      "secondaryButton": "of-button of-button--ghost",
      "section": "of-section",
      "sectionHeading": "of-section-heading",
      "grid": "of-grid",
      "card": "of-card",
      "cardImage": "of-card-image",
      "badge": "of-badge",
      "form": "of-form",
      "field": "of-field",
      "input": "of-input",
      "select": "of-select",
      "textarea": "of-textarea",
      "notice": "of-notice",
      "table": "of-table",
      "accordion": "of-accordion",
      "footer": "of-footer"
    },
    "radiusPx": 0,
    "cardRadiusPx": 0,
    "borderPx": 2,
    "buttonShape": "square",
    "minimumControlHeightPx": 48,
    "inputHeightPx": 52,
    "focus": {
      "widthPx": 3,
      "offsetPx": 4,
      "color": "#2B2B25"
    }
  },
  "content": {
    "headline": [
      "A different page.",
      "A wider perspective."
    ],
    "eyebrow": "DESIGN / CULTURE / NO FIXED FORMAT",
    "cta": "Open the latest issue",
    "secondaryCta": "Read our point of view",
    "nav": [
      "The latest issue",
      "Archive",
      "Point of view"
    ],
    "features": [
      [
        "Ideas worth opening",
        "Perspectives that make a familiar subject feel newly interesting."
      ],
      [
        "The page as a place",
        "Editorial design that gives each story a useful form."
      ],
      [
        "No fixed conclusion",
        "A publication that leaves room for the next point of view."
      ]
    ]
  },
  "rules": [
    "Fold lines remain visible and meet at exact corners.",
    "Run headlines across the page while captions stay in fixed columns.",
    "Use yellow to designate primary editorial content, not decorative accents.",
    "Yellow poster hero, bold condensed editorial setting, exposed fold graphic, hard black rules, and square issue cards. Metadata always snaps to the grid.",
    "Use the supplied artwork and SVG logos; keep glyph proportions intact.",
    "Preserve the existing project content, routes, data fetching, and interaction handlers."
  ],
  "fonts": [
    {
      "id": "archivo",
      "family": "Archivo",
      "path": "fonts/archivo.ttf",
      "license": "fonts/archivo-OFL.txt",
      "weight": "100 900",
      "style": "normal"
    },
    {
      "id": "space-grotesk",
      "family": "Space Grotesk",
      "path": "fonts/space-grotesk.ttf",
      "license": "fonts/space-grotesk-OFL.txt",
      "weight": "300 700",
      "style": "normal"
    },
    {
      "id": "dm-mono",
      "family": "DM Mono",
      "path": "fonts/dm-mono.ttf",
      "license": "fonts/dm-mono-OFL.txt",
      "weight": "400",
      "style": "normal"
    }
  ],
  "exports": [
    "mark.svg",
    "lockup.svg",
    "wordmark.svg",
    "monochrome.svg",
    "pattern.svg",
    "poster.svg",
    "social.svg",
    "avatar.svg",
    "favicon.svg",
    "artwork.svg",
    "identity-board.svg",
    "stationery.svg",
    "packaging.svg",
    "website.svg",
    "social-story.svg",
    "icon-set.svg",
    "palette.svg",
    "typography.svg",
    "business-card.svg",
    "tokens.json",
    "theme.css",
    "theme.json",
    "theme.js",
    "reference.html",
    "components.html",
    "components.tsx",
    "install-theme.mjs",
    "AI-PROMPT.md",
    "INSTALL.md",
    "guidelines.md"
  ],
  "license": {
    "artwork": "CC0-1.0",
    "code": "MIT",
    "fonts": "OFL-1.1"
  },
  "acceptance": [
    "The exact stylesheet loads without a 404.",
    "All local fonts load; there are no requests to remote font services.",
    "The root or intended subtree carries the exact data-openform attribute.",
    "The supplied display font, colors, radius, spacing, and layout family are used consistently.",
    "At 360px, 768px, and 1440px there is no horizontal page overflow.",
    "Navigation, forms, routes, and existing business behavior still work.",
    "Controls are keyboard accessible with visible focus; reduced-motion preferences are respected.",
    "The final interface follows reference.html and components.html rather than a guessed visual style."
  ]
}
