{
  "$description": "RELAY / Signal infrastructure / Edition 02",
  "color": {
    "ink": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.12549,
          0.14118,
          0.12941
        ],
        "alpha": 1
      },
      "$extensions": {
        "openform.hex": "#202421"
      }
    },
    "accent": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.85882,
          0.96471,
          0.37255
        ],
        "alpha": 1
      },
      "$extensions": {
        "openform.hex": "#DBF65F"
      }
    },
    "paper": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.9451,
          0.95686,
          0.9098
        ],
        "alpha": 1
      },
      "$extensions": {
        "openform.hex": "#F1F4E8"
      }
    },
    "support": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.61569,
          0.67451,
          0.65098
        ],
        "alpha": 1
      },
      "$extensions": {
        "openform.hex": "#9DACA6"
      }
    }
  },
  "typography": {
    "heading": {
      "$type": "fontFamily",
      "$value": "Unbounded"
    },
    "body": {
      "$type": "fontFamily",
      "$value": "DM Mono"
    },
    "headingWeight": {
      "$type": "fontWeight",
      "$value": 600
    },
    "tracking": {
      "$type": "number",
      "$value": -0.02,
      "$description": "Display letter spacing in em units."
    },
    "bodySize": {
      "$type": "dimension",
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "bodyLeading": {
      "$type": "number",
      "$value": 1.7
    }
  },
  "radius": {
    "$type": "dimension",
    "$value": {
      "value": 3,
      "unit": "px"
    }
  },
  "spacing": {
    "unit": {
      "$type": "dimension",
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "pageMinimum": {
      "$type": "dimension",
      "$value": {
        "value": 20,
        "unit": "px"
      }
    },
    "pageMaximum": {
      "$type": "dimension",
      "$value": {
        "value": 64,
        "unit": "px"
      }
    }
  },
  "$extensions": {
    "openform": {
      "name": "RELAY",
      "version": "2.0.0",
      "style": "Futuristic",
      "direction": "Signal infrastructure",
      "voice": "Fast, capable, and straightforward.",
      "layout": {
        "id": "terminal",
        "family": "terminal",
        "mode": "dark",
        "alignment": "left",
        "maxWidthPx": 1400,
        "pageGutter": "clamp(20px, 4vw, 64px)",
        "sectionGap": "clamp(64px, 9vw, 128px)",
        "heroTextRatio": 0.6,
        "gridColumns": 3,
        "breakpoints": {
          "mobile": 640,
          "tablet": 960
        },
        "description": "Terminal-black hero with acid-yellow type and waveform art. Numbered modules, monospaced labels, 3px corners, and rectangular controls. No candy gradients or floating cards."
      },
      "contrast": [
        {
          "foreground": "#202421",
          "background": "#DBF65F",
          "ratio": 13,
          "aaNormal": true
        },
        {
          "foreground": "#202421",
          "background": "#F1F4E8",
          "ratio": 14.11,
          "aaNormal": true
        }
      ]
    }
  }
}
