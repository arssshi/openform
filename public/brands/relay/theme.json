{
  "format": "openform-theme",
  "version": "2.0.0",
  "id": "relay",
  "name": "RELAY",
  "direction": "Signal infrastructure",
  "concept": "Oscilloscope ribbons, precise terminal frames, numbered modules, and sharply electric signal color. A technical world with unmistakable speed and editorial discipline.",
  "scope": {
    "attribute": "data-openform",
    "value": "relay",
    "selector": "[data-openform=\"relay\"]"
  },
  "installation": {
    "command": "node install-theme.mjs --target /path/to/your/project",
    "publicDirectory": "public",
    "destination": "themes/relay",
    "stylesheet": "/themes/relay/theme.css",
    "reference": "/themes/relay/reference.html",
    "components": "/themes/relay/components.html",
    "htmlAttribute": "data-openform=\"relay\""
  },
  "colors": {
    "ink": "#202421",
    "accent": "#DBF65F",
    "paper": "#F1F4E8",
    "support": "#9DACA6",
    "secondary": "#3f433f",
    "border": "#b9bcb2",
    "heroBackground": "#202421",
    "heroForeground": "#F1F4E8",
    "buttonBackground": "#DBF65F",
    "buttonForeground": "#202421"
  },
  "typography": {
    "display": {
      "family": "Unbounded",
      "file": "fonts/unbounded.ttf",
      "weight": 600,
      "trackingEm": -0.02,
      "lineHeight": 1.02,
      "desktopMaxPx": 96,
      "mobileMinPx": 38
    },
    "body": {
      "family": "DM Mono",
      "file": "fonts/dm-mono.ttf",
      "weight": 400,
      "sizePx": 16,
      "lineHeight": 1.7
    },
    "accent": {
      "family": "DM Mono",
      "file": "fonts/dm-mono.ttf",
      "style": "normal"
    },
    "label": {
      "sizePx": 11,
      "trackingEm": 0.08,
      "lineHeight": 1.5
    }
  },
  "layout": {
    "id": "terminal",
    "family": "terminal",
    "mode": "dark",
    "alignment": "left",
    "maxWidthPx": 1400,
    "pageGutter": "clamp(20px, 4vw, 64px)",
    "sectionGap": "clamp(64px, 9vw, 128px)",
    "heroTextRatio": 0.6,
    "gridColumns": 3,
    "breakpoints": {
      "mobile": 640,
      "tablet": 960
    },
    "description": "Terminal-black hero with acid-yellow type and waveform art. Numbered modules, monospaced labels, 3px corners, and rectangular controls. No candy gradients or floating cards."
  },
  "components": {
    "classes": {
      "root": "of-theme",
      "container": "of-container",
      "header": "of-header",
      "navigation": "of-nav",
      "mobileNavigation": "of-mobile-nav",
      "logo": "of-logo",
      "eyebrow": "of-eyebrow",
      "hero": "of-hero",
      "heroCopy": "of-hero-copy",
      "heroHeading": "of-display",
      "heroMedia": "of-hero-media",
      "heading": "of-heading",
      "body": "of-body",
      "actions": "of-actions",
      "button": "of-button",
      "secondaryButton": "of-button of-button--ghost",
      "section": "of-section",
      "sectionHeading": "of-section-heading",
      "grid": "of-grid",
      "card": "of-card",
      "cardImage": "of-card-image",
      "badge": "of-badge",
      "form": "of-form",
      "field": "of-field",
      "input": "of-input",
      "select": "of-select",
      "textarea": "of-textarea",
      "notice": "of-notice",
      "table": "of-table",
      "accordion": "of-accordion",
      "footer": "of-footer"
    },
    "radiusPx": 3,
    "cardRadiusPx": 0,
    "borderPx": 1,
    "buttonShape": "square",
    "minimumControlHeightPx": 48,
    "inputHeightPx": 52,
    "focus": {
      "widthPx": 3,
      "offsetPx": 4,
      "color": "#202421"
    }
  },
  "content": {
    "headline": [
      "Keep your ideas",
      "moving forward."
    ],
    "eyebrow": "REAL-TIME TOOLS / OPEN SIGNAL",
    "cta": "Explore the system",
    "secondaryCta": "Read the docs",
    "nav": [
      "Platform",
      "Documentation",
      "Journal"
    ],
    "features": [
      [
        "Always in sync",
        "A clear foundation for information that keeps moving."
      ],
      [
        "Useful at every layer",
        "Technical detail organized around the job you need to do."
      ],
      [
        "A signal worth following",
        "Purposeful tools, legible interfaces, and fewer unnecessary steps."
      ]
    ]
  },
  "rules": [
    "Use the three-step signal at fixed proportions.",
    "Acid yellow carries action; terminal carries technical detail.",
    "Number modules and keep specification labels in monospaced capitals.",
    "Terminal-black hero with acid-yellow type and waveform art. Numbered modules, monospaced labels, 3px corners, and rectangular controls. No candy gradients or floating cards.",
    "Use the supplied artwork and SVG logos; keep glyph proportions intact.",
    "Preserve the existing project content, routes, data fetching, and interaction handlers."
  ],
  "fonts": [
    {
      "id": "unbounded",
      "family": "Unbounded",
      "path": "fonts/unbounded.ttf",
      "license": "fonts/unbounded-OFL.txt",
      "weight": "200 900",
      "style": "normal"
    },
    {
      "id": "dm-mono",
      "family": "DM Mono",
      "path": "fonts/dm-mono.ttf",
      "license": "fonts/dm-mono-OFL.txt",
      "weight": "400",
      "style": "normal"
    }
  ],
  "exports": [
    "mark.svg",
    "lockup.svg",
    "wordmark.svg",
    "monochrome.svg",
    "pattern.svg",
    "poster.svg",
    "social.svg",
    "avatar.svg",
    "favicon.svg",
    "artwork.svg",
    "identity-board.svg",
    "stationery.svg",
    "packaging.svg",
    "website.svg",
    "social-story.svg",
    "icon-set.svg",
    "palette.svg",
    "typography.svg",
    "business-card.svg",
    "tokens.json",
    "theme.css",
    "theme.json",
    "theme.js",
    "reference.html",
    "components.html",
    "components.tsx",
    "install-theme.mjs",
    "AI-PROMPT.md",
    "INSTALL.md",
    "guidelines.md"
  ],
  "license": {
    "artwork": "CC0-1.0",
    "code": "MIT",
    "fonts": "OFL-1.1"
  },
  "acceptance": [
    "The exact stylesheet loads without a 404.",
    "All local fonts load; there are no requests to remote font services.",
    "The root or intended subtree carries the exact data-openform attribute.",
    "The supplied display font, colors, radius, spacing, and layout family are used consistently.",
    "At 360px, 768px, and 1440px there is no horizontal page overflow.",
    "Navigation, forms, routes, and existing business behavior still work.",
    "Controls are keyboard accessible with visible focus; reduced-motion preferences are respected.",
    "The final interface follows reference.html and components.html rather than a guessed visual style."
  ]
}
