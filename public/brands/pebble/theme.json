{
  "format": "openform-theme",
  "version": "2.0.0",
  "id": "pebble",
  "name": "pebble",
  "direction": "Progress, gently shaped",
  "concept": "Soft dimensional stones, stacked organic frames, warm editorial annotations, and unforced friendly type. The system makes small progress feel worth noticing.",
  "scope": {
    "attribute": "data-openform",
    "value": "pebble",
    "selector": "[data-openform=\"pebble\"]"
  },
  "installation": {
    "command": "node install-theme.mjs --target /path/to/your/project",
    "publicDirectory": "public",
    "destination": "themes/pebble",
    "stylesheet": "/themes/pebble/theme.css",
    "reference": "/themes/pebble/reference.html",
    "components": "/themes/pebble/components.html",
    "htmlAttribute": "data-openform=\"pebble\""
  },
  "colors": {
    "ink": "#334D8A",
    "accent": "#ABC3EA",
    "paper": "#FAF4E6",
    "support": "#EEAC8F",
    "secondary": "#516698",
    "border": "#c4c7cd",
    "heroBackground": "#FAF4E6",
    "heroForeground": "#334D8A",
    "buttonBackground": "#334D8A",
    "buttonForeground": "#FAF4E6"
  },
  "typography": {
    "display": {
      "family": "Bricolage Grotesque",
      "file": "fonts/bricolage.ttf",
      "weight": 600,
      "trackingEm": -0.05,
      "lineHeight": 1.02,
      "desktopMaxPx": 96,
      "mobileMinPx": 38
    },
    "body": {
      "family": "DM Sans",
      "file": "fonts/dm-sans.ttf",
      "weight": 400,
      "sizePx": 16,
      "lineHeight": 1.7
    },
    "accent": {
      "family": "Instrument Serif",
      "file": "fonts/instrument-serif-italic.ttf",
      "style": "italic"
    },
    "label": {
      "sizePx": 11,
      "trackingEm": 0.08,
      "lineHeight": 1.5
    }
  },
  "layout": {
    "id": "scattered",
    "family": "playful",
    "mode": "paper",
    "alignment": "left",
    "maxWidthPx": 1240,
    "pageGutter": "clamp(20px, 4vw, 64px)",
    "sectionGap": "clamp(64px, 9vw, 128px)",
    "heroTextRatio": 0.54,
    "gridColumns": 3,
    "breakpoints": {
      "mobile": 640,
      "tablet": 960
    },
    "description": "Sand hero with irregular blue stone artwork and a conversational heading. Peach accents, 30px cards, and reassuring empty space; never competitive-looking progress charts."
  },
  "components": {
    "classes": {
      "root": "of-theme",
      "container": "of-container",
      "header": "of-header",
      "navigation": "of-nav",
      "mobileNavigation": "of-mobile-nav",
      "logo": "of-logo",
      "eyebrow": "of-eyebrow",
      "hero": "of-hero",
      "heroCopy": "of-hero-copy",
      "heroHeading": "of-display",
      "heroMedia": "of-hero-media",
      "heading": "of-heading",
      "body": "of-body",
      "actions": "of-actions",
      "button": "of-button",
      "secondaryButton": "of-button of-button--ghost",
      "section": "of-section",
      "sectionHeading": "of-section-heading",
      "grid": "of-grid",
      "card": "of-card",
      "cardImage": "of-card-image",
      "badge": "of-badge",
      "form": "of-form",
      "field": "of-field",
      "input": "of-input",
      "select": "of-select",
      "textarea": "of-textarea",
      "notice": "of-notice",
      "table": "of-table",
      "accordion": "of-accordion",
      "footer": "of-footer"
    },
    "radiusPx": 30,
    "cardRadiusPx": 0,
    "borderPx": 1,
    "buttonShape": "pill",
    "minimumControlHeightPx": 48,
    "inputHeightPx": 52,
    "focus": {
      "widthPx": 3,
      "offsetPx": 4,
      "color": "#334D8A"
    }
  },
  "content": {
    "headline": [
      "One small thing.",
      "A softer day."
    ],
    "eyebrow": "A LITTLE PRACTICE / A LITTLE PROGRESS",
    "cta": "Find your small step",
    "secondaryCta": "Meet the approach",
    "nav": [
      "Small steps",
      "The approach",
      "Good notes"
    ],
    "features": [
      [
        "Start small",
        "A thoughtful beginning that can fit into your actual day."
      ],
      [
        "Make it your rhythm",
        "A gentle approach to building something consistent."
      ],
      [
        "Notice the good",
        "Small progress, clearly seen and kindly celebrated."
      ]
    ]
  },
  "rules": [
    "Use asymmetrical pebbles rather than perfect circles.",
    "Never visually rank people; use color to distinguish habits instead.",
    "Keep encouraging headlines short and in lowercase.",
    "Sand hero with irregular blue stone artwork and a conversational heading. Peach accents, 30px cards, and reassuring empty space; never competitive-looking progress charts.",
    "Use the supplied artwork and SVG logos; keep glyph proportions intact.",
    "Preserve the existing project content, routes, data fetching, and interaction handlers."
  ],
  "fonts": [
    {
      "id": "bricolage",
      "family": "Bricolage Grotesque",
      "path": "fonts/bricolage.ttf",
      "license": "fonts/bricolage-OFL.txt",
      "weight": "200 800",
      "style": "normal"
    },
    {
      "id": "dm-sans",
      "family": "DM Sans",
      "path": "fonts/dm-sans.ttf",
      "license": "fonts/dm-sans-OFL.txt",
      "weight": "100 1000",
      "style": "normal"
    },
    {
      "id": "instrument-serif-italic",
      "family": "Instrument Serif",
      "path": "fonts/instrument-serif-italic.ttf",
      "license": "fonts/instrument-serif-italic-OFL.txt",
      "weight": "400",
      "style": "italic"
    }
  ],
  "exports": [
    "mark.svg",
    "lockup.svg",
    "wordmark.svg",
    "monochrome.svg",
    "pattern.svg",
    "poster.svg",
    "social.svg",
    "avatar.svg",
    "favicon.svg",
    "artwork.svg",
    "identity-board.svg",
    "stationery.svg",
    "packaging.svg",
    "website.svg",
    "social-story.svg",
    "icon-set.svg",
    "palette.svg",
    "typography.svg",
    "business-card.svg",
    "tokens.json",
    "theme.css",
    "theme.json",
    "theme.js",
    "reference.html",
    "components.html",
    "components.tsx",
    "install-theme.mjs",
    "AI-PROMPT.md",
    "INSTALL.md",
    "guidelines.md"
  ],
  "license": {
    "artwork": "CC0-1.0",
    "code": "MIT",
    "fonts": "OFL-1.1"
  },
  "acceptance": [
    "The exact stylesheet loads without a 404.",
    "All local fonts load; there are no requests to remote font services.",
    "The root or intended subtree carries the exact data-openform attribute.",
    "The supplied display font, colors, radius, spacing, and layout family are used consistently.",
    "At 360px, 768px, and 1440px there is no horizontal page overflow.",
    "Navigation, forms, routes, and existing business behavior still work.",
    "Controls are keyboard accessible with visible focus; reduced-motion preferences are respected.",
    "The final interface follows reference.html and components.html rather than a guessed visual style."
  ]
}
