{
  "format": "openform-theme",
  "version": "2.0.0",
  "id": "offscript",
  "name": "OFFSCRIPT",
  "direction": "Constructive disruption",
  "concept": "Offset print, torn geometric registrations, oversized compressed headlines, and high-visibility orange. The chaos is deliberate; the information is exact.",
  "scope": {
    "attribute": "data-openform",
    "value": "offscript",
    "selector": "[data-openform=\"offscript\"]"
  },
  "installation": {
    "command": "node install-theme.mjs --target /path/to/your/project",
    "publicDirectory": "public",
    "destination": "themes/offscript",
    "stylesheet": "/themes/offscript/theme.css",
    "reference": "/themes/offscript/reference.html",
    "components": "/themes/offscript/components.html",
    "htmlAttribute": "data-openform=\"offscript\""
  },
  "colors": {
    "ink": "#24241F",
    "accent": "#FF713D",
    "paper": "#F7F3E8",
    "support": "#C8D3ED",
    "secondary": "#44433d",
    "border": "#bebbb2",
    "heroBackground": "#FF713D",
    "heroForeground": "#24241F",
    "buttonBackground": "#24241F",
    "buttonForeground": "#F7F3E8"
  },
  "typography": {
    "display": {
      "family": "Archivo",
      "file": "fonts/archivo.ttf",
      "weight": 900,
      "trackingEm": -0.04,
      "lineHeight": 0.96,
      "desktopMaxPx": 96,
      "mobileMinPx": 38
    },
    "body": {
      "family": "DM Mono",
      "file": "fonts/dm-mono.ttf",
      "weight": 400,
      "sizePx": 16,
      "lineHeight": 1.7
    },
    "accent": {
      "family": "DM Mono",
      "file": "fonts/dm-mono.ttf",
      "style": "normal"
    },
    "label": {
      "sizePx": 11,
      "trackingEm": 0.08,
      "lineHeight": 1.5
    }
  },
  "layout": {
    "id": "offset",
    "family": "poster",
    "mode": "accent",
    "alignment": "left",
    "maxWidthPx": 1400,
    "pageGutter": "clamp(20px, 4vw, 64px)",
    "sectionGap": "clamp(64px, 9vw, 128px)",
    "heroTextRatio": 0.62,
    "gridColumns": 3,
    "breakpoints": {
      "mobile": 640,
      "tablet": 960
    },
    "description": "Orange poster-scale hero with hard grid rules, black rectangular CTA, and a cropped print graphic. Never soften the composition into rounded SaaS cards."
  },
  "components": {
    "classes": {
      "root": "of-theme",
      "container": "of-container",
      "header": "of-header",
      "navigation": "of-nav",
      "mobileNavigation": "of-mobile-nav",
      "logo": "of-logo",
      "eyebrow": "of-eyebrow",
      "hero": "of-hero",
      "heroCopy": "of-hero-copy",
      "heroHeading": "of-display",
      "heroMedia": "of-hero-media",
      "heading": "of-heading",
      "body": "of-body",
      "actions": "of-actions",
      "button": "of-button",
      "secondaryButton": "of-button of-button--ghost",
      "section": "of-section",
      "sectionHeading": "of-section-heading",
      "grid": "of-grid",
      "card": "of-card",
      "cardImage": "of-card-image",
      "badge": "of-badge",
      "form": "of-form",
      "field": "of-field",
      "input": "of-input",
      "select": "of-select",
      "textarea": "of-textarea",
      "notice": "of-notice",
      "table": "of-table",
      "accordion": "of-accordion",
      "footer": "of-footer"
    },
    "radiusPx": 0,
    "cardRadiusPx": 0,
    "borderPx": 2,
    "buttonShape": "square",
    "minimumControlHeightPx": 48,
    "inputHeightPx": 52,
    "focus": {
      "widthPx": 3,
      "offsetPx": 4,
      "color": "#24241F"
    }
  },
  "content": {
    "headline": [
      "Good ideas",
      "break the format."
    ],
    "eyebrow": "INDEPENDENT STUDIO / ZERO DEFAULTS",
    "cta": "Make some noise",
    "secondaryCta": "See the work",
    "nav": [
      "Work",
      "Point of view",
      "Contact"
    ],
    "features": [
      [
        "A sharper idea",
        "Start with a position worth taking, then make it unmistakable."
      ],
      [
        "A louder language",
        "Graphic systems with enough conviction to carry the message."
      ],
      [
        "Built to break through",
        "Useful, working design that does more than sit politely."
      ]
    ]
  },
  "rules": [
    "Keep the asterisk sharp; do not round its ends.",
    "Oversized type may break the grid, but utility text must align precisely.",
    "Use hot orange as a dominant surface, paired only with ink for text.",
    "Orange poster-scale hero with hard grid rules, black rectangular CTA, and a cropped print graphic. Never soften the composition into rounded SaaS cards.",
    "Use the supplied artwork and SVG logos; keep glyph proportions intact.",
    "Preserve the existing project content, routes, data fetching, and interaction handlers."
  ],
  "fonts": [
    {
      "id": "archivo",
      "family": "Archivo",
      "path": "fonts/archivo.ttf",
      "license": "fonts/archivo-OFL.txt",
      "weight": "100 900",
      "style": "normal"
    },
    {
      "id": "dm-mono",
      "family": "DM Mono",
      "path": "fonts/dm-mono.ttf",
      "license": "fonts/dm-mono-OFL.txt",
      "weight": "400",
      "style": "normal"
    }
  ],
  "exports": [
    "mark.svg",
    "lockup.svg",
    "wordmark.svg",
    "monochrome.svg",
    "pattern.svg",
    "poster.svg",
    "social.svg",
    "avatar.svg",
    "favicon.svg",
    "artwork.svg",
    "identity-board.svg",
    "stationery.svg",
    "packaging.svg",
    "website.svg",
    "social-story.svg",
    "icon-set.svg",
    "palette.svg",
    "typography.svg",
    "business-card.svg",
    "tokens.json",
    "theme.css",
    "theme.json",
    "theme.js",
    "reference.html",
    "components.html",
    "components.tsx",
    "install-theme.mjs",
    "AI-PROMPT.md",
    "INSTALL.md",
    "guidelines.md"
  ],
  "license": {
    "artwork": "CC0-1.0",
    "code": "MIT",
    "fonts": "OFL-1.1"
  },
  "acceptance": [
    "The exact stylesheet loads without a 404.",
    "All local fonts load; there are no requests to remote font services.",
    "The root or intended subtree carries the exact data-openform attribute.",
    "The supplied display font, colors, radius, spacing, and layout family are used consistently.",
    "At 360px, 768px, and 1440px there is no horizontal page overflow.",
    "Navigation, forms, routes, and existing business behavior still work.",
    "Controls are keyboard accessible with visible focus; reduced-motion preferences are respected.",
    "The final interface follows reference.html and components.html rather than a guessed visual style."
  ]
}
