{
  "$description": "OFFSCRIPT / Constructive disruption / Edition 02",
  "color": {
    "ink": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.14118,
          0.14118,
          0.12157
        ],
        "alpha": 1
      },
      "$extensions": {
        "openform.hex": "#24241F"
      }
    },
    "accent": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          0.44314,
          0.23922
        ],
        "alpha": 1
      },
      "$extensions": {
        "openform.hex": "#FF713D"
      }
    },
    "paper": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.96863,
          0.95294,
          0.9098
        ],
        "alpha": 1
      },
      "$extensions": {
        "openform.hex": "#F7F3E8"
      }
    },
    "support": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.78431,
          0.82745,
          0.92941
        ],
        "alpha": 1
      },
      "$extensions": {
        "openform.hex": "#C8D3ED"
      }
    }
  },
  "typography": {
    "heading": {
      "$type": "fontFamily",
      "$value": "Archivo"
    },
    "body": {
      "$type": "fontFamily",
      "$value": "DM Mono"
    },
    "headingWeight": {
      "$type": "fontWeight",
      "$value": 900
    },
    "tracking": {
      "$type": "number",
      "$value": -0.04,
      "$description": "Display letter spacing in em units."
    },
    "bodySize": {
      "$type": "dimension",
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "bodyLeading": {
      "$type": "number",
      "$value": 1.7
    }
  },
  "radius": {
    "$type": "dimension",
    "$value": {
      "value": 0,
      "unit": "px"
    }
  },
  "spacing": {
    "unit": {
      "$type": "dimension",
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "pageMinimum": {
      "$type": "dimension",
      "$value": {
        "value": 20,
        "unit": "px"
      }
    },
    "pageMaximum": {
      "$type": "dimension",
      "$value": {
        "value": 64,
        "unit": "px"
      }
    }
  },
  "$extensions": {
    "openform": {
      "name": "OFFSCRIPT",
      "version": "2.0.0",
      "style": "Brutalist",
      "direction": "Constructive disruption",
      "voice": "Direct, irreverent, and full of conviction.",
      "layout": {
        "id": "offset",
        "family": "poster",
        "mode": "accent",
        "alignment": "left",
        "maxWidthPx": 1400,
        "pageGutter": "clamp(20px, 4vw, 64px)",
        "sectionGap": "clamp(64px, 9vw, 128px)",
        "heroTextRatio": 0.62,
        "gridColumns": 3,
        "breakpoints": {
          "mobile": 640,
          "tablet": 960
        },
        "description": "Orange poster-scale hero with hard grid rules, black rectangular CTA, and a cropped print graphic. Never soften the composition into rounded SaaS cards."
      },
      "contrast": [
        {
          "foreground": "#24241F",
          "background": "#FF713D",
          "ratio": 5.7,
          "aaNormal": true
        },
        {
          "foreground": "#24241F",
          "background": "#F7F3E8",
          "ratio": 14.06,
          "aaNormal": true
        }
      ]
    }
  }
}
