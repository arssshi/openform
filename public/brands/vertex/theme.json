{
  "format": "openform-theme",
  "version": "2.0.0",
  "id": "vertex",
  "name": "VERTEX",
  "direction": "Forward-facing energy",
  "concept": "Prismatic speed studies, directional shards, technical product crops, and a striking violet interface. Momentum lives in geometry while practical information stays steady.",
  "scope": {
    "attribute": "data-openform",
    "value": "vertex",
    "selector": "[data-openform=\"vertex\"]"
  },
  "installation": {
    "command": "node install-theme.mjs --target /path/to/your/project",
    "publicDirectory": "public",
    "destination": "themes/vertex",
    "stylesheet": "/themes/vertex/theme.css",
    "reference": "/themes/vertex/reference.html",
    "components": "/themes/vertex/components.html",
    "htmlAttribute": "data-openform=\"vertex\""
  },
  "colors": {
    "ink": "#342B57",
    "accent": "#B5A8E1",
    "paper": "#EFEAF6",
    "support": "#ED936B",
    "secondary": "#50486f",
    "border": "#bdb6cb",
    "heroBackground": "#342B57",
    "heroForeground": "#EFEAF6",
    "buttonBackground": "#B5A8E1",
    "buttonForeground": "#342B57"
  },
  "typography": {
    "display": {
      "family": "Unbounded",
      "file": "fonts/unbounded.ttf",
      "weight": 500,
      "trackingEm": -0.01,
      "lineHeight": 1.02,
      "desktopMaxPx": 96,
      "mobileMinPx": 38
    },
    "body": {
      "family": "Urbanist",
      "file": "fonts/urbanist.ttf",
      "weight": 400,
      "sizePx": 16,
      "lineHeight": 1.7
    },
    "accent": {
      "family": "DM Mono",
      "file": "fonts/dm-mono.ttf",
      "style": "normal"
    },
    "label": {
      "sizePx": 11,
      "trackingEm": 0.08,
      "lineHeight": 1.5
    }
  },
  "layout": {
    "id": "kinetic",
    "family": "digital",
    "mode": "dark",
    "alignment": "left",
    "maxWidthPx": 1400,
    "pageGutter": "clamp(20px, 4vw, 64px)",
    "sectionGap": "clamp(64px, 9vw, 128px)",
    "heroTextRatio": 0.52,
    "gridColumns": 3,
    "breakpoints": {
      "mobile": 640,
      "tablet": 960
    },
    "description": "Vector-violet hero with light display text and kinetic shard artwork. Fixed technical panels, forward diagonal decoration, and small ignition-colored labels."
  },
  "components": {
    "classes": {
      "root": "of-theme",
      "container": "of-container",
      "header": "of-header",
      "navigation": "of-nav",
      "mobileNavigation": "of-mobile-nav",
      "logo": "of-logo",
      "eyebrow": "of-eyebrow",
      "hero": "of-hero",
      "heroCopy": "of-hero-copy",
      "heroHeading": "of-display",
      "heroMedia": "of-hero-media",
      "heading": "of-heading",
      "body": "of-body",
      "actions": "of-actions",
      "button": "of-button",
      "secondaryButton": "of-button of-button--ghost",
      "section": "of-section",
      "sectionHeading": "of-section-heading",
      "grid": "of-grid",
      "card": "of-card",
      "cardImage": "of-card-image",
      "badge": "of-badge",
      "form": "of-form",
      "field": "of-field",
      "input": "of-input",
      "select": "of-select",
      "textarea": "of-textarea",
      "notice": "of-notice",
      "table": "of-table",
      "accordion": "of-accordion",
      "footer": "of-footer"
    },
    "radiusPx": 4,
    "cardRadiusPx": 0,
    "borderPx": 1,
    "buttonShape": "square",
    "minimumControlHeightPx": 48,
    "inputHeightPx": 52,
    "focus": {
      "widthPx": 3,
      "offsetPx": 4,
      "color": "#342B57"
    }
  },
  "content": {
    "headline": [
      "A new direction",
      "for the everyday."
    ],
    "eyebrow": "ELECTRIC MOVEMENT / FORWARD THINKING",
    "cta": "Explore the next direction",
    "secondaryCta": "Meet the design",
    "nav": [
      "The design",
      "The everyday",
      "Perspectives"
    ],
    "features": [
      [
        "A useful new direction",
        "Thoughtful mobility design for the way you actually move."
      ],
      [
        "Precision in the details",
        "A clear, considered system from form to information."
      ],
      [
        "Go beyond the familiar",
        "A new perspective on everyday journeys."
      ]
    ]
  },
  "rules": [
    "Use forward-facing shards with a shared vanishing direction.",
    "Keep technical details on calm surfaces separate from kinetic graphics.",
    "Ignition is a small action accent, not a body-text color.",
    "Vector-violet hero with light display text and kinetic shard artwork. Fixed technical panels, forward diagonal decoration, and small ignition-colored labels.",
    "Use the supplied artwork and SVG logos; keep glyph proportions intact.",
    "Preserve the existing project content, routes, data fetching, and interaction handlers."
  ],
  "fonts": [
    {
      "id": "unbounded",
      "family": "Unbounded",
      "path": "fonts/unbounded.ttf",
      "license": "fonts/unbounded-OFL.txt",
      "weight": "200 900",
      "style": "normal"
    },
    {
      "id": "urbanist",
      "family": "Urbanist",
      "path": "fonts/urbanist.ttf",
      "license": "fonts/urbanist-OFL.txt",
      "weight": "100 900",
      "style": "normal"
    },
    {
      "id": "dm-mono",
      "family": "DM Mono",
      "path": "fonts/dm-mono.ttf",
      "license": "fonts/dm-mono-OFL.txt",
      "weight": "400",
      "style": "normal"
    }
  ],
  "exports": [
    "mark.svg",
    "lockup.svg",
    "wordmark.svg",
    "monochrome.svg",
    "pattern.svg",
    "poster.svg",
    "social.svg",
    "avatar.svg",
    "favicon.svg",
    "artwork.svg",
    "identity-board.svg",
    "stationery.svg",
    "packaging.svg",
    "website.svg",
    "social-story.svg",
    "icon-set.svg",
    "palette.svg",
    "typography.svg",
    "business-card.svg",
    "tokens.json",
    "theme.css",
    "theme.json",
    "theme.js",
    "reference.html",
    "components.html",
    "components.tsx",
    "install-theme.mjs",
    "AI-PROMPT.md",
    "INSTALL.md",
    "guidelines.md"
  ],
  "license": {
    "artwork": "CC0-1.0",
    "code": "MIT",
    "fonts": "OFL-1.1"
  },
  "acceptance": [
    "The exact stylesheet loads without a 404.",
    "All local fonts load; there are no requests to remote font services.",
    "The root or intended subtree carries the exact data-openform attribute.",
    "The supplied display font, colors, radius, spacing, and layout family are used consistently.",
    "At 360px, 768px, and 1440px there is no horizontal page overflow.",
    "Navigation, forms, routes, and existing business behavior still work.",
    "Controls are keyboard accessible with visible focus; reduced-motion preferences are respected.",
    "The final interface follows reference.html and components.html rather than a guessed visual style."
  ]
}
