  "$extensions": {
    "openform": {
      "name": "tandem",
      "version": "2.0.0",
      "style": "Minimal",
      "direction": "Connected momentum",
      "voice": "Cooperative, reliable, and optimistic.",
      "layout": {
        "id": "connected",
        "family": "digital",
        "mode": "paper",
        "alignment": "left",
        "maxWidthPx": 1320,
        "pageGutter": "clamp(20px, 4vw, 64px)",
        "sectionGap": "clamp(64px, 9vw, 128px)",
        "heroTextRatio": 0.52,
        "gridColumns": 3,
        "breakpoints": {
          "mobile": 640,
          "tablet": 960
        },
        "description": "Porcelain split hero with oversized mint loop artwork. Petrol route text, rounded itinerary cards, and consistent 4px spacing increments."
      },
      "contrast": [
        {
          "foreground": "#205C5C",
          "background": "#C3DFD4",
          "ratio": 5.4,
          "aaNormal": true
        },
        {
          "foreground": "#205C5C",
          "background": "#F2F2E6",
          "ratio": 6.78,
          "aaNormal": true
        }
      ]
    }
