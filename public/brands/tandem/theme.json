{
  "format": "openform-theme",
  "version": "2.0.0",
  "id": "tandem",
  "name": "tandem",
  "direction": "Connected momentum",
  "concept": "Braided loops, wheel-like negative spaces, clean route diagrams, and friendly functional typography. Connection is expressed through continuous geometry and shared direction.",
  "scope": {
    "attribute": "data-openform",
    "value": "tandem",
    "selector": "[data-openform=\"tandem\"]"
  },
  "installation": {
    "command": "node install-theme.mjs --target /path/to/your/project",
    "publicDirectory": "public",
    "destination": "themes/tandem",
    "stylesheet": "/themes/tandem/theme.css",
    "reference": "/themes/tandem/reference.html",
    "components": "/themes/tandem/components.html",
    "htmlAttribute": "data-openform=\"tandem\""
  },
  "colors": {
    "ink": "#205C5C",
    "accent": "#C3DFD4",
    "paper": "#F2F2E6",
    "support": "#D9AF73",
    "secondary": "#407371",
    "border": "#b9cac1",
    "heroBackground": "#F2F2E6",
    "heroForeground": "#205C5C",
    "buttonBackground": "#205C5C",
    "buttonForeground": "#F2F2E6"
  },
  "typography": {
    "display": {
      "family": "Urbanist",
      "file": "fonts/urbanist.ttf",
      "weight": 600,
      "trackingEm": -0.03,
      "lineHeight": 1.02,
      "desktopMaxPx": 96,
      "mobileMinPx": 38
    },
    "body": {
      "family": "DM Sans",
      "file": "fonts/dm-sans.ttf",
      "weight": 400,
      "sizePx": 16,
      "lineHeight": 1.7
    },
    "accent": {
      "family": "Urbanist",
      "file": "fonts/urbanist.ttf",
      "style": "normal"
    },
    "label": {
      "sizePx": 11,
      "trackingEm": 0.08,
      "lineHeight": 1.5
    }
  },
  "layout": {
    "id": "connected",
    "family": "digital",
    "mode": "paper",
    "alignment": "left",
    "maxWidthPx": 1320,
    "pageGutter": "clamp(20px, 4vw, 64px)",
    "sectionGap": "clamp(64px, 9vw, 128px)",
    "heroTextRatio": 0.52,
    "gridColumns": 3,
    "breakpoints": {
      "mobile": 640,
      "tablet": 960
    },
    "description": "Porcelain split hero with oversized mint loop artwork. Petrol route text, rounded itinerary cards, and consistent 4px spacing increments."
  },
  "components": {
    "classes": {
      "root": "of-theme",
      "container": "of-container",
      "header": "of-header",
      "navigation": "of-nav",
      "mobileNavigation": "of-mobile-nav",
      "logo": "of-logo",
      "eyebrow": "of-eyebrow",
      "hero": "of-hero",
      "heroCopy": "of-hero-copy",
      "heroHeading": "of-display",
      "heroMedia": "of-hero-media",
      "heading": "of-heading",
      "body": "of-body",
      "actions": "of-actions",
      "button": "of-button",
      "secondaryButton": "of-button of-button--ghost",
      "section": "of-section",
      "sectionHeading": "of-section-heading",
      "grid": "of-grid",
      "card": "of-card",
      "cardImage": "of-card-image",
      "badge": "of-badge",
      "form": "of-form",
      "field": "of-field",
      "input": "of-input",
      "select": "of-select",
      "textarea": "of-textarea",
      "notice": "of-notice",
      "table": "of-table",
      "accordion": "of-accordion",
      "footer": "of-footer"
    },
    "radiusPx": 16,
    "cardRadiusPx": 0,
    "borderPx": 1,
    "buttonShape": "pill",
    "minimumControlHeightPx": 48,
    "inputHeightPx": 52,
    "focus": {
      "widthPx": 3,
      "offsetPx": 4,
      "color": "#205C5C"
    }
  },
  "content": {
    "headline": [
      "A better way",
      "to move together."
    ],
    "eyebrow": "SHARED JOURNEYS / BETTER EVERYDAYS",
    "cta": "Find a better journey",
    "secondaryCta": "How sharing works",
    "nav": [
      "Journeys",
      "How it works",
      "The community"
    ],
    "features": [
      [
        "Share the direction",
        "A useful way to connect people going somewhere similar."
      ],
      [
        "A clear next step",
        "Thoughtful route information and simple journey planning."
      ],
      [
        "Go a little further",
        "A cooperative approach to moving through the everyday."
      ]
    ]
  },
  "rules": [
    "Both loops use equal dimensions and a shared baseline.",
    "Keep interface spacing on a four-unit rhythm.",
    "Use petrol text on porcelain for route and journey information.",
    "Porcelain split hero with oversized mint loop artwork. Petrol route text, rounded itinerary cards, and consistent 4px spacing increments.",
    "Use the supplied artwork and SVG logos; keep glyph proportions intact.",
    "Preserve the existing project content, routes, data fetching, and interaction handlers."
  ],
  "fonts": [
    {
      "id": "urbanist",
      "family": "Urbanist",
      "path": "fonts/urbanist.ttf",
      "license": "fonts/urbanist-OFL.txt",
      "weight": "100 900",
      "style": "normal"
    },
    {
      "id": "dm-sans",
      "family": "DM Sans",
      "path": "fonts/dm-sans.ttf",
      "license": "fonts/dm-sans-OFL.txt",
      "weight": "100 1000",
      "style": "normal"
    }
  ],
  "exports": [
    "mark.svg",
    "lockup.svg",
    "wordmark.svg",
    "monochrome.svg",
    "pattern.svg",
    "poster.svg",
    "social.svg",
    "avatar.svg",
    "favicon.svg",
    "artwork.svg",
    "identity-board.svg",
    "stationery.svg",
    "packaging.svg",
    "website.svg",
    "social-story.svg",
    "icon-set.svg",
    "palette.svg",
    "typography.svg",
    "business-card.svg",
    "tokens.json",
    "theme.css",
    "theme.json",
    "theme.js",
    "reference.html",
    "components.html",
    "components.tsx",
    "install-theme.mjs",
    "AI-PROMPT.md",
    "INSTALL.md",
    "guidelines.md"
  ],
  "license": {
    "artwork": "CC0-1.0",
    "code": "MIT",
    "fonts": "OFL-1.1"
  },
  "acceptance": [
    "The exact stylesheet loads without a 404.",
    "All local fonts load; there are no requests to remote font services.",
    "The root or intended subtree carries the exact data-openform attribute.",
    "The supplied display font, colors, radius, spacing, and layout family are used consistently.",
    "At 360px, 768px, and 1440px there is no horizontal page overflow.",
    "Navigation, forms, routes, and existing business behavior still work.",
    "Controls are keyboard accessible with visible focus; reduced-motion preferences are respected.",
    "The final interface follows reference.html and components.html rather than a guessed visual style."
  ]
}
