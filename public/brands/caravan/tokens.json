        "id": "badge",
        "family": "expedition",
        "mode": "accent",
        "alignment": "left",
        "maxWidthPx": 1320,
        "pageGutter": "clamp(20px, 4vw, 64px)",
        "sectionGap": "clamp(64px, 9vw, 128px)",
        "heroTextRatio": 0.49,
        "gridColumns": 3,
        "breakpoints": {
          "mobile": 640,
          "tablet": 960
        },
        "description": "Desert hero with condensed road-sign headings and a layered landscape. Leather outlines, teal route accents, and badge-like equipment labels."
      },
      "contrast": [
        {
          "foreground": "#5B3424",
          "background": "#E6A871",
          "ratio": 5.2,
          "aaNormal": true
        },
        {
          "foreground": "#5B3424",
          "background": "#F5E8CC",
          "ratio": 8.82,
          "aaNormal": true
        }
      ]
